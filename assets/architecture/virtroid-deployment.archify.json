  "cards": [
    {
      "dot": "cyan",
      "title": "Running today",
      "items": [
        "One VPS runs the edge, control plane, database, a runtime node, Falco and Suricata",
        "A second node on an Aleph Cloud VM serves accounts assigned to region eu",
        "New runtimes go to a node in the account's region; a runtime stays on its node"
      ]
    },
    {
      "dot": "emerald",
      "title": "How the stream connects",
      "items": [
        "VPS runtimes: phone to edge to virtnoded, over TLS",
        "Remote runtimes: phone straight to the node, checking its pinned TLS key",
        "No direct route (e.g. no IPv6): the VPS node forwards the stream unchanged",
        "Video is end-to-end encrypted between phone and runtime either way"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundary",
      "items": [
        "Runtime hosts are trusted: the VPS operator, and the operator of an Aleph machine, can inspect live runtimes",
        "Nodes sign every request with an approved P-256 key",
        "The control plane only calls remote nodes on an operator allowlist"
      ]
    },
    {
      "dot": "amber",
      "title": "Next",
      "items": [
        "Provisioner that creates and deletes Aleph VMs per user",
        "SEV-SNP VMs, with the phone verifying attestation first",
        "QUIC transport, and encrypted user data on Sia"
      ]
    }
  ]
