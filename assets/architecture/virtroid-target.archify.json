  "cards": [
    {
      "dot": "cyan",
      "title": "Starting a session",
      "items": [
        "1\u20132: the phone sends a signed start; the edge forwards it and virtroidd checks credits",
        "3: the provisioner reuses the user's VM, takes a warm spare, or creates an SNP VM, and hands over the disk key only once the AMD measurement checks out",
        "4: the VM boots the published, measured image; each session starts a fresh ReDroid container",
        "5: the phone verifies the SNP report, then streams straight from the VM over QUIC, or through the edge if it has no direct route",
        "6: /data is restored from Sia before Android boots; on stop, changed chunks go back"
      ]
    },
    {
      "dot": "orange",
      "title": "Placement",
      "items": [
        "Each account has a region; a user's VM is never shared",
        "Near you: your own SEV-SNP server, for example in Singapore",
        "Europe and the US: Aleph SNP nodes, paid per hour from credits"
      ]
    },
    {
      "dot": "rose",
      "title": "Runtime lifecycle",
      "items": [
        "Hot: connected. Warm: kept for 15 minutes, instant reconnect. Cold: saved to Sia, container removed",
        "The VM is destroyed after long inactivity, on image updates, or if compromise is suspected",
        "The provisioner's Aleph account holds a capped credit balance"
      ]
    },
    {
      "dot": "emerald",
      "title": "Your VPS",
      "items": [
        "Edge, control, payments and storage are isolated from each other",
        "Only the edge is public; nodes and runtime agents also come in through it",
        "Sensors ship logs off-host to an append-only bucket"
      ]
    },
    {
      "dot": "amber",
      "title": "User data",
      "items": [
        "Durable copy on Sia only, encrypted inside the VM before upload",
        "indexd sees only opaque metadata and pays Sia hosts in SC",
        "Optional: an encrypted local copy on the user's VM disk for faster restores"
      ]
    },
    {
      "dot": "violet",
      "title": "Money",
      "items": [
        "Users deposit USDT TRC20 to their own deposit address",
        "Deposits become credits, spent per runtime minute and per GB stored",
        "Offline, you convert some USDT to SC for indexd and top up Aleph credits"
      ]
    },
    {
      "dot": "slate",
      "title": "Built so far",
      "items": [
        "Live: the VPS node plus a pilot Aleph node, region placement, direct IPv6 streaming with an edge fallback",
        "Next: provisioner, SEV-SNP with phone-side attestation, QUIC, Sia, then payments"
      ]
    }
  ]
