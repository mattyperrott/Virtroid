<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/v_bg">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/status_bar"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="bottom|center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="8dp">
            <TextView
                android:id="@+id/text_status_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="9:41"
                android:textColor="@color/v_text_primary"
                android:textSize="14sp"
                android:fontFamily="sans"
                android:includeFontPadding="false" />
            <TextView
                android:id="@+id/text_status_icons"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="LTE  WIFI  100"
                android:textColor="@color/v_text_primary"
                android:textSize="11sp"
                android:fontFamily="sans"
                android:includeFontPadding="false" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/text_secure_client"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SECURE CLIENT"
                    android:textColor="@color/v_text_muted"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="sans"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.15"
                    android:layout_marginBottom="6dp" />
                <TextView
                    android:id="@+id/text_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="My Runtimes"
                    android:textColor="@color/v_text_primary"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:fontFamily="sans"
                    android:includeFontPadding="false" />
            </LinearLayout>
            <Button
                android:id="@+id/button_search"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_surface_circle"
                android:text="SR"
                android:textAllCaps="false"
                android:textColor="@color/v_text_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="sans"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:gravity="center" />
            <Button
                android:id="@+id/button_notifications"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_surface_circle"
                android:text="NT"
                android:textAllCaps="false"
                android:textColor="@color/v_text_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="sans"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:gravity="center" />
        </LinearLayout>
        <ScrollView
            android:id="@+id/runtime_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="false"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/runtime_scroll_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="132dp">
                <LinearLayout
                    android:id="@+id/card_primary_runtime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_surface_32"
                    android:padding="24dp"
                    android:layout_marginBottom="20dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="24dp">
                        <TextView
                            android:id="@+id/icon_primary_nexus"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:gravity="center"
                            android:text="PH"
                            android:textColor="@color/v_accent"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:background="@drawable/bg_surface_light_16" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="16dp">
                            <TextView
                                android:id="@+id/text_primary_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Primary Nexus"
                                android:textColor="@color/v_text_primary"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:fontFamily="sans"
                                android:includeFontPadding="false" />
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:layout_marginTop="4dp">
                                <View
                                    android:id="@+id/primary_status_dot"
                                    android:layout_width="6dp"
                                    android:layout_height="6dp"
                                    android:background="@drawable/bg_dot_accent"
                                    android:layout_marginEnd="6dp" />
                                <TextView
                                    android:id="@+id/text_primary_status"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Session Active"
                                    android:textColor="@color/v_text_muted"
                                    android:textSize="12sp"
                                    android:fontFamily="sans"
                                    android:includeFontPadding="false" />
                            </LinearLayout>
                        </LinearLayout>
                        <Button
                            android:id="@+id/button_primary_more"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_surface_light_circle"
                            android:text="..."
                            android:textAllCaps="false"
                            android:textColor="@color/v_text_muted"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:fontFamily="sans"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingStart="0dp"
                            android:paddingEnd="0dp"
                            android:gravity="center" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="24dp">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/primary_uptime_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="UPTIME"
                                android:textColor="@color/v_text_muted"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:fontFamily="sans"
                                android:includeFontPadding="false"
                                android:letterSpacing="0.08"
                                android:layout_marginBottom="6dp" />
                            <TextView
                                android:id="@+id/primary_uptime_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="12h 45m"
                                android:textColor="@color/v_text_primary"
                                android:textSize="14sp"
                                android:fontFamily="sans"
                                android:includeFontPadding="false" />
                        </LinearLayout>
                        <View
                            android:layout_width="1dp"
                            android:layout_height="32dp"
                            android:background="@color/v_border_soft"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="12dp" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/primary_region_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="REGION"
                                android:textColor="@color/v_text_muted"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:fontFamily="sans"
                                android:includeFontPadding="false"
                                android:letterSpacing="0.08"
                                android:layout_marginBottom="6dp" />
                            <TextView
                                android:id="@+id/primary_region_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="US-East"
                                android:textColor="@color/v_text_primary"
                                android:textSize="14sp"
                                android:fontFamily="sans"
                                android:includeFontPadding="false" />
                        </LinearLayout>
                        <View
                            android:layout_width="1dp"
                            android:layout_height="32dp"
                            android:background="@color/v_border_soft"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="12dp" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/primary_ping_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PING"
                                android:textColor="@color/v_text_muted"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:fontFamily="sans"
                                android:includeFontPadding="false"
                                android:letterSpacing="0.08"
                                android:layout_marginBottom="6dp" />
                            <TextView
                                android:id="@+id/primary_ping_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="24ms"
                                android:textColor="@color/v_text_primary"
                                android:textSize="14sp"
                                android:fontFamily="sans"
                                android:includeFontPadding="false" />
                        </LinearLayout>
                    </LinearLayout>
                    <Button
                        android:id="@+id/button_connect_primary"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:background="@drawable/bg_accent_round"
                        android:text="Connect &gt;"
                        android:textAllCaps="false"
                        android:textColor="@color/v_bg"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="sans"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:gravity="center" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/card_ephemeral_runtime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_surface_stroke_32"
                    android:padding="24dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="24dp">
                        <TextView
                            android:id="@+id/icon_ephemeral_runtime"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:gravity="center"
                            android:text="EP"
                            android:textColor="@color/v_text_muted"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:background="@drawable/bg_surface_light_16" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="16dp">
                            <TextView
                                android:id="@+id/text_ephemeral_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ephemeral Burner"
                                android:textColor="@color/v_text_secondary"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:fontFamily="sans"
                                android:includeFontPadding="false" />
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:layout_marginTop="4dp">
                                <View
                                    android:id="@+id/ephemeral_status_dot"
                                    android:layout_width="6dp"
                                    android:layout_height="6dp"
                                    android:background="@drawable/bg_dot_muted"
                                    android:layout_marginEnd="6dp" />
                                <TextView
                                    android:id="@+id/text_ephemeral_status"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Offline / Standby"
                                    android:textColor="@color/v_text_muted"
                                    android:textSize="12sp"
                                    android:fontFamily="sans"
                                    android:includeFontPadding="false" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <Button
                            android:id="@+id/button_start_ephemeral"
                            android:layout_width="0dp"
                            android:layout_height="50dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_surface_light_24"
                            android:text="Start Node"
                            android:textAllCaps="false"
                            android:textColor="@color/v_text_primary"
                            android:textSize="14sp"
                            android:fontFamily="sans"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:gravity="center" />
                        <Button
                            android:id="@+id/button_ephemeral_settings"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:layout_marginStart="12dp"
                            android:background="@drawable/bg_surface_light_24"
                            android:text="SL"
                            android:textAllCaps="false"
                            android:textColor="@color/v_text_primary"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:fontFamily="sans"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingStart="0dp"
                            android:paddingEnd="0dp"
                            android:gravity="center" />
                        <Button
                            android:id="@+id/button_delete_ephemeral"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:layout_marginStart="12dp"
                            android:background="@drawable/bg_red_soft_24"
                            android:text="TR"
                            android:textAllCaps="false"
                            android:textColor="@color/v_danger"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:fontFamily="sans"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingStart="0dp"
                            android:paddingEnd="0dp"
                            android:gravity="center" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:orientation="horizontal"
        android:background="@drawable/bg_bottom_nav"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="32dp">
        <Button
            android:id="@+id/nav_runtimes"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_surface_circle"
            android:text="HD"
            android:textAllCaps="false"
            android:textColor="@color/v_accent"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="sans"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:gravity="center" />
        <Button
            android:id="@+id/nav_security"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_transparent"
            android:text="SH"
            android:textAllCaps="false"
            android:textColor="@color/v_text_muted"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="sans"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:gravity="center" />
        <Button
            android:id="@+id/nav_new_runtime"
            android:layout_width="90dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_accent_round"
            android:text="+ New"
            android:textAllCaps="false"
            android:textColor="@color/v_bg"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="sans"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:gravity="center" />
        <Button
            android:id="@+id/nav_identity"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_transparent"
            android:text="ID"
            android:textAllCaps="false"
            android:textColor="@color/v_text_muted"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="sans"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:gravity="center" />
        <Button
            android:id="@+id/nav_settings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_transparent"
            android:text="ST"
            android:textAllCaps="false"
            android:textColor="@color/v_text_muted"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="sans"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:gravity="center" />
    </LinearLayout>
    <View
        android:id="@+id/home_indicator"
        android:layout_width="128dp"
        android:layout_height="4dp"
        android:layout_gravity="bottom|center_horizontal"
        android:background="@drawable/bg_home_indicator"
        android:layout_marginBottom="8dp" />
</FrameLayout>
