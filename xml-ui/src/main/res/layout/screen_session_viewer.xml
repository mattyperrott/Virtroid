<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/v_bg">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/session_app_bar"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_viewer_top_bar"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">
            <Button
                android:id="@+id/button_disconnect"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_red_soft_24"
                android:text="PW"
                android:textAllCaps="false"
                android:textColor="@color/v_danger"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="sans"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:gravity="center" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/text_session_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Primary Nexus"
                    android:textColor="@color/v_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="sans"
                    android:includeFontPadding="false" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">
                    <View
                        android:id="@+id/connection_dot"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/bg_dot_accent"
                        android:layout_marginEnd="6dp" />
                    <TextView
                        android:id="@+id/text_connection_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Secure / 24ms"
                        android:textColor="@color/v_accent"
                        android:textSize="11sp"
                        android:fontFamily="sans"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </LinearLayout>
            <Button
                android:id="@+id/button_camera"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_surface_24"
                android:text="CA"
                android:textAllCaps="false"
                android:textColor="@color/v_text_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="sans"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:gravity="center" />
            <Button
                android:id="@+id/button_upload_file"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_surface_24"
                android:text="UP"
                android:textAllCaps="false"
                android:textColor="@color/v_text_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="sans"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:gravity="center" />
            <Button
                android:id="@+id/button_controls"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_accent_soft_circle"
                android:text="SL"
                android:textAllCaps="false"
                android:textColor="@color/v_accent"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="sans"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:gravity="center" />
        </LinearLayout>
        <FrameLayout
            android:id="@+id/virtual_viewer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_viewer_wallpaper">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">
                <LinearLayout
                    android:id="@+id/virtual_status_bar"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="#4D000000"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">
                    <TextView
                        android:id="@+id/text_virtual_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12:30"
                        android:textColor="@color/v_text_primary"
                        android:textSize="11sp"
                        android:fontFamily="sans"
                        android:includeFontPadding="false" />
                    <TextView
                        android:id="@+id/text_virtual_status"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="WIFI  LTE  BAT"
                        android:textColor="@color/v_text_primary"
                        android:textSize="10sp"
                        android:fontFamily="sans"
                        android:includeFontPadding="false" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/virtual_search_widget"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_search_widget"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="32dp">
                    <TextView
                        android:id="@+id/text_search_logo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="G"
                        android:textColor="@color/v_text_secondary"
                        android:textSize="16sp"
                        android:fontFamily="sans"
                        android:includeFontPadding="false"
                        android:layout_marginEnd="12dp" />
                    <TextView
                        android:id="@+id/text_search_hint"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Private Search..."
                        android:textColor="@color/v_text_secondary"
                        android:textSize="14sp"
                        android:fontFamily="sans"
                        android:includeFontPadding="false" />
                    <TextView
                        android:id="@+id/text_search_actions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MIC  FULL"
                        android:textColor="@color/v_text_secondary"
                        android:textSize="10sp"
                        android:fontFamily="sans"
                        android:includeFontPadding="false" />
                </LinearLayout>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
                <LinearLayout
                    android:id="@+id/virtual_app_grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:layout_marginBottom="32dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/app_vault_icon"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:text="VL"
                            android:textColor="@color/v_accent"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/bg_app_icon" />
                        <TextView
                            android:id="@+id/app_vault_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="Vault"
                            android:textColor="@color/v_text_primary"
                            android:textSize="11sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/app_camera_icon"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:text="CA"
                            android:textColor="@color/v_text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/bg_app_icon" />
                        <TextView
                            android:id="@+id/app_camera_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="Camera"
                            android:textColor="@color/v_text_primary"
                            android:textSize="11sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/app_files_icon"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:text="FI"
                            android:textColor="@color/v_text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/bg_app_icon" />
                        <TextView
                            android:id="@+id/app_files_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="Files"
                            android:textColor="@color/v_text_primary"
                            android:textSize="11sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/app_settings_icon"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:text="ST"
                            android:textColor="@color/v_text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/bg_app_icon" />
                        <TextView
                            android:id="@+id/app_settings_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="Settings"
                            android:textColor="@color/v_text_primary"
                            android:textSize="11sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/virtual_dock"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_search_widget"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="40dp">
                    <TextView
                        android:id="@+id/dock_phone"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:gravity="center"
                        android:text="PH"
                        android:textColor="@color/v_green"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="sans"
                        android:includeFontPadding="false"
                        android:background="@drawable/bg_app_icon" />
                    <TextView
                        android:id="@+id/dock_chat"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:gravity="center"
                        android:text="CH"
                        android:textColor="@color/v_blue"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="sans"
                        android:includeFontPadding="false"
                        android:background="@drawable/bg_app_icon" />
                    <TextView
                        android:id="@+id/dock_browser"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:gravity="center"
                        android:text="BR"
                        android:textColor="@color/v_accent"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="sans"
                        android:includeFontPadding="false"
                        android:background="@drawable/bg_app_icon" />
                    <TextView
                        android:id="@+id/dock_tools"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:gravity="center"
                        android:text="SL"
                        android:textColor="@color/v_text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="sans"
                        android:includeFontPadding="false"
                        android:background="@drawable/bg_app_icon" />
                </LinearLayout>
            </LinearLayout>
            <View
                android:id="@+id/virtual_home_indicator"
                android:layout_width="128dp"
                android:layout_height="4dp"
                android:layout_gravity="bottom|center_horizontal"
                android:background="@drawable/bg_home_indicator"
                android:layout_marginBottom="12dp" />
        </FrameLayout>
    </LinearLayout>
    <View
        android:id="@+id/host_home_indicator"
        android:layout_width="140dp"
        android:layout_height="6dp"
        android:layout_gravity="bottom|center_horizontal"
        android:background="@drawable/bg_home_indicator"
        android:layout_marginBottom="8dp" />
</FrameLayout>
