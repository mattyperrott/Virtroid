<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/v_bg">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingBottom="32dp">
        <LinearLayout
            android:id="@+id/pin_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="96dp"
            android:paddingBottom="56dp">
            <TextView
                android:id="@+id/icon_lock"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:gravity="center"
                android:text="KEY"
                android:textColor="@color/v_accent"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="sans"
                android:includeFontPadding="false"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_surface_stroke_32" />
            <TextView
                android:id="@+id/text_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Unlock Identity"
                android:textColor="@color/v_text_primary"
                android:textSize="24sp"
                android:textStyle="bold"
                android:fontFamily="sans"
                android:includeFontPadding="false"
                android:layout_marginBottom="8dp" />
            <TextView
                android:id="@+id/text_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Decrypting local state"
                android:textColor="@color/v_accent"
                android:textSize="14sp"
                android:fontFamily="sans"
                android:includeFontPadding="false"
                android:layout_marginBottom="48dp" />
            <LinearLayout
                android:id="@+id/pin_dots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">
                <View
                    android:id="@+id/pin_dot_1"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:background="@drawable/bg_dot_accent"
                    android:layout_marginEnd="14dp" />
                <View
                    android:id="@+id/pin_dot_2"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:background="@drawable/bg_dot_accent"
                    android:layout_marginEnd="14dp" />
                <View
                    android:id="@+id/pin_dot_3"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:background="@drawable/bg_dot_accent"
                    android:layout_marginEnd="14dp" />
                <View
                    android:id="@+id/pin_dot_4"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:background="@drawable/bg_pin_empty"
                    android:layout_marginEnd="14dp" />
                <View
                    android:id="@+id/pin_dot_5"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:background="@drawable/bg_pin_empty"
                    android:layout_marginEnd="14dp" />
                <View
                    android:id="@+id/pin_dot_6"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:background="@drawable/bg_pin_empty" />
            </LinearLayout>
        </LinearLayout>
        <GridLayout
            android:id="@+id/pin_keypad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"
            android:columnCount="3"
            android:rowCount="4"
            android:alignmentMode="alignBounds"
            android:useDefaultMargins="true">
            <Button
                android:id="@+id/button_digit_1"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_pin_button"
                android:text="1"
                android:textAllCaps="false"
                android:textColor="@color/v_text_primary"
                android:textSize="24sp"
                android:fontFamily="sans"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:gravity="center" />
            <Button
                android:id="@+id/button_digit_2"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_pin_button"
                android:text="2 ABC"
                android:textAllCaps="false"
                android:textColor="@color/v_text_primary"
                android:textSize="18sp"
                android:fontFamily="sans"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:gravity="center" />
            <Button
                android:id="@+id/button_digit_3"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_pin_button"
                android:text="3 DEF"
                android:textAllCaps="false"
                android:textColor="@color/v_text_primary"
                android:textSize="18sp"
                android:fontFamily="sans"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:gravity="center" />
            <Button
                android:id="@+id/button_digit_4"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_pin_button"
                android:text="4 GHI"
                android:textAllCaps="false"
                android:textColor="@color/v_text_primary"
                android:textSize="18sp"
                android:fontFamily="sans"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:gravity="center" />
            <Button
                android:id="@+id/button_digit_5"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_pin_button"
                android:text="5 JKL"
                android:textAllCaps="false"
                android:textColor="@color/v_text_primary"
                android:textSize="18sp"
                android:fontFamily="sans"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:gravity="center" />
            <Button
                android:id="@+id/button_digit_6"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_pin_button"
                android:text="6 MNO"
                android:textAllCaps="false"
                android:textColor="@color/v_text_primary"
                android:textSize="18sp"
                android:fontFamily="sans"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:gravity="center" />
            <Button
                android:id="@+id/button_digit_7"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_pin_button"
                android:text="7 PQRS"
                android:textAllCaps="false"
                android:textColor="@color/v_text_primary"
                android:textSize="18sp"
                android:fontFamily="sans"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:gravity="center" />
            <Button
                android:id="@+id/button_digit_8"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_pin_button"
                android:text="8 TUV"
                android:textAllCaps="false"
                android:textColor="@color/v_text_primary"
                android:textSize="18sp"
                android:fontFamily="sans"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:gravity="center" />
            <Button
                android:id="@+id/button_digit_9"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_pin_button"
                android:text="9 WXYZ"
                android:textAllCaps="false"
                android:textColor="@color/v_text_primary"
                android:textSize="18sp"
                android:fontFamily="sans"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:gravity="center" />
            <Button
                android:id="@+id/button_fingerprint"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_transparent"
                android:text="FP"
                android:textAllCaps="false"
                android:textColor="@color/v_accent"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="sans"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:gravity="center" />
            <Button
                android:id="@+id/button_digit_0"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_pin_button"
                android:text="0"
                android:textAllCaps="false"
                android:textColor="@color/v_text_primary"
                android:textSize="24sp"
                android:fontFamily="sans"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:gravity="center" />
            <Button
                android:id="@+id/button_backspace"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_transparent"
                android:text="DEL"
                android:textAllCaps="false"
                android:textColor="@color/v_text_muted"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="sans"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:gravity="center" />
        </GridLayout>
        <Button
            android:id="@+id/button_use_passphrase"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_transparent"
            android:text="Use Passphrase instead"
            android:textAllCaps="false"
            android:textColor="@color/v_text_dim"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="sans"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:gravity="center" />
    </LinearLayout>
</FrameLayout>
