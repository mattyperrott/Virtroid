<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/v_bg">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/top_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="56dp"
            android:paddingBottom="8dp">
            <Button
                android:id="@+id/button_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_surface_circle"
                android:text="Back"
                android:textAllCaps="false"
                android:textColor="@color/v_text_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="sans"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:gravity="center" />
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />
            <Button
                android:id="@+id/button_help"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_surface_circle"
                android:text="?"
                android:textAllCaps="false"
                android:textColor="@color/v_text_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="sans"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:gravity="center" />
        </LinearLayout>
        <ScrollView
            android:id="@+id/fund_storage_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="false"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/fund_storage_scroll_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="164dp">
                <TextView
                    android:id="@+id/text_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fund Storage"
                    android:textColor="@color/v_text_primary"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:fontFamily="sans"
                    android:includeFontPadding="false"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="28dp" />
                <LinearLayout
                    android:id="@+id/wallet_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_surface_stroke_32"
                    android:padding="20dp"
                    android:layout_marginBottom="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="20dp">
                        <TextView
                            android:id="@+id/wallet_icon"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:gravity="center"
                            android:text="WA"
                            android:textColor="@color/v_text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:background="@drawable/bg_surface_light_circle" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">
                            <TextView
                                android:id="@+id/wallet_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Storage Wallet"
                                android:textColor="@color/v_text_primary"
                                android:textSize="14sp"
                                android:fontFamily="sans"
                                android:includeFontPadding="false" />
                            <TextView
                                android:id="@+id/wallet_subtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Sia renterd / User funded"
                                android:textColor="@color/v_text_dim"
                                android:textSize="12sp"
                                android:fontFamily="sans"
                                android:includeFontPadding="false"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                        <TextView
                            android:id="@+id/wallet_status_chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Funding Required"
                            android:textColor="@color/v_amber"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp"
                            android:background="@drawable/bg_amber_soft_12" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/sia_address_box"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_input_20"
                        android:padding="16dp">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="12dp">
                            <TextView
                                android:id="@+id/sia_address_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="SIA ADDRESS"
                                android:textColor="@color/v_text_dim"
                                android:textSize="12sp"
                                android:fontFamily="sans"
                                android:includeFontPadding="false"
                                android:layout_marginBottom="6dp" />
                            <TextView
                                android:id="@+id/sia_address_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="c3b91...8f2a1b4c7d9e0f"
                                android:textColor="@color/v_accent"
                                android:textSize="14sp"
                                android:fontFamily="monospace"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:ellipsize="end" />
                        </LinearLayout>
                        <Button
                            android:id="@+id/button_copy_sia_address"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_surface_circle"
                            android:text="CP"
                            android:textAllCaps="false"
                            android:textColor="@color/v_text_muted"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:fontFamily="sans"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingStart="0dp"
                            android:paddingEnd="0dp"
                            android:gravity="center" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/amount_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_surface_stroke_32"
                    android:padding="20dp"
                    android:layout_marginBottom="16dp">
                    <TextView
                        android:id="@+id/amount_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Select Amount"
                        android:textColor="@color/v_text_primary"
                        android:textSize="14sp"
                        android:fontFamily="sans"
                        android:includeFontPadding="false"
                        android:layout_marginBottom="16dp" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="20dp">
                        <Button
                            android:id="@+id/button_amount_5"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_amount_unselected"
                            android:text="$5"
                            android:textAllCaps="false"
                            android:textColor="@color/v_text_secondary"
                            android:textSize="14sp"
                            android:fontFamily="sans"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:gravity="center" />
                        <Button
                            android:id="@+id/button_amount_10"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_amount_selected"
                            android:text="$10"
                            android:textAllCaps="false"
                            android:textColor="@color/v_bg"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="sans"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:gravity="center" />
                        <Button
                            android:id="@+id/button_amount_25"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_amount_unselected"
                            android:text="$25"
                            android:textAllCaps="false"
                            android:textColor="@color/v_text_secondary"
                            android:textSize="14sp"
                            android:fontFamily="sans"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:gravity="center" />
                        <Button
                            android:id="@+id/button_amount_custom"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_amount_unselected"
                            android:text="Edit"
                            android:textAllCaps="false"
                            android:textColor="@color/v_text_secondary"
                            android:textSize="14sp"
                            android:fontFamily="sans"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:gravity="center" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/amount_estimates"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_input_20"
                        android:padding="16dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <TextView
                                android:id="@+id/estimated_received_label"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Estimated Received"
                                android:textColor="@color/v_text_muted"
                                android:textSize="13sp"
                                android:fontFamily="sans"
                                android:includeFontPadding="false" />
                            <TextView
                                android:id="@+id/estimated_received_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="end"
                                android:text="~1,180 SC"
                                android:textColor="@color/v_text_primary"
                                android:textSize="13sp"
                                android:fontFamily="monospace"
                                android:includeFontPadding="false" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_marginTop="10dp">
                            <TextView
                                android:id="@+id/network_fee_label"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Network / Swap Fee"
                                android:textColor="@color/v_text_muted"
                                android:textSize="12sp"
                                android:fontFamily="sans"
                                android:includeFontPadding="false" />
                            <TextView
                                android:id="@+id/network_fee_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="end"
                                android:text="~$0.45"
                                android:textColor="@color/v_text_muted"
                                android:textSize="12sp"
                                android:fontFamily="monospace"
                                android:includeFontPadding="false" />
                        </LinearLayout>
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/v_border"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="12dp" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <TextView
                                android:id="@+id/contract_minimum_label"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Contract Minimum Needed"
                                android:textColor="@color/v_text_muted"
                                android:textSize="12sp"
                                android:fontFamily="sans"
                                android:includeFontPadding="false" />
                            <TextView
                                android:id="@+id/contract_minimum_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="end"
                                android:text="$3.00"
                                android:textColor="@color/v_text_muted"
                                android:textSize="12sp"
                                android:fontFamily="monospace"
                                android:includeFontPadding="false" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/payment_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_surface_stroke_32"
                    android:padding="20dp"
                    android:layout_marginBottom="24dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">
                        <TextView
                            android:id="@+id/payment_method_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Payment Method"
                            android:textColor="@color/v_text_primary"
                            android:textSize="14sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false" />
                        <TextView
                            android:id="@+id/payment_network_chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TRC20 v"
                            android:textColor="@color/v_text_secondary"
                            android:textSize="12sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="7dp"
                            android:paddingBottom="7dp"
                            android:background="@drawable/bg_chip_dark" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">
                        <TextView
                            android:id="@+id/usdt_icon"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:gravity="center"
                            android:text="US"
                            android:textColor="@color/v_usdt"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:background="@drawable/bg_usdt_soft_circle" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">
                            <TextView
                                android:id="@+id/pay_with_usdt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Pay with USDT"
                                android:textColor="@color/v_text_primary"
                                android:textSize="14sp"
                                android:fontFamily="sans"
                                android:includeFontPadding="false" />
                            <TextView
                                android:id="@+id/non_custodial_swap"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Non-custodial swap"
                                android:textColor="@color/v_accent"
                                android:textSize="12sp"
                                android:fontFamily="sans"
                                android:includeFontPadding="false"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/payment_info_box"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_input_20"
                        android:padding="12dp">
                        <TextView
                            android:id="@+id/payment_info_icon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="i"
                            android:textColor="@color/v_text_dim"
                            android:textSize="12sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:layout_marginEnd="8dp" />
                        <TextView
                            android:id="@+id/payment_info"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Funds are sent directly to your Sia wallet via external bridge. We do not custody your funds."
                            android:textColor="@color/v_text_dim"
                            android:textSize="12sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:lineSpacingExtra="3dp" />
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:id="@+id/deployment_status_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DEPLOYMENT STATUS"
                    android:textColor="@color/v_text_dim"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="sans"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.08"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="20dp" />
                <FrameLayout
                    android:id="@+id/deployment_timeline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp">
                    <View
                        android:id="@+id/deployment_timeline_line"
                        android:layout_width="2dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_timeline_line"
                        android:layout_marginStart="11dp" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingBottom="8dp">
                        <LinearLayout
                            android:id="@+id/step_create_quote"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_marginBottom="24dp">
                            <View
                                android:id="@+id/step_create_quote_dot"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:background="@drawable/bg_dot_amber_outline"
                                android:layout_marginEnd="16dp" />
                            <TextView
                                android:id="@+id/step_create_quote_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Create swap quote"
                                android:textColor="@color/v_amber"
                                android:textSize="14sp"
                                android:fontFamily="sans"
                                android:includeFontPadding="false" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/step_send_usdt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_marginBottom="24dp">
                            <View
                                android:id="@+id/step_send_usdt_dot"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:background="@drawable/bg_dot_muted_outline"
                                android:layout_marginEnd="16dp" />
                            <TextView
                                android:id="@+id/step_send_usdt_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Send USDT"
                                android:textColor="@color/v_text_primary"
                                android:textSize="14sp"
                                android:fontFamily="sans"
                                android:includeFontPadding="false"
                                android:alpha="0.45" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/step_receive_siacoin"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_marginBottom="24dp">
                            <View
                                android:id="@+id/step_receive_siacoin_dot"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:background="@drawable/bg_dot_muted_outline"
                                android:layout_marginEnd="16dp" />
                            <TextView
                                android:id="@+id/step_receive_siacoin_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Receive Siacoin"
                                android:textColor="@color/v_text_primary"
                                android:textSize="14sp"
                                android:fontFamily="sans"
                                android:includeFontPadding="false"
                                android:alpha="0.45" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/step_form_contracts"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_marginBottom="24dp">
                            <View
                                android:id="@+id/step_form_contracts_dot"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:background="@drawable/bg_dot_muted_outline"
                                android:layout_marginEnd="16dp" />
                            <TextView
                                android:id="@+id/step_form_contracts_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Form storage contracts"
                                android:textColor="@color/v_text_primary"
                                android:textSize="14sp"
                                android:fontFamily="sans"
                                android:includeFontPadding="false"
                                android:alpha="0.45" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/step_storage_ready"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_marginBottom="0dp">
                            <View
                                android:id="@+id/step_storage_ready_dot"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:background="@drawable/bg_dot_muted_outline"
                                android:layout_marginEnd="16dp" />
                            <TextView
                                android:id="@+id/step_storage_ready_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Storage Ready"
                                android:textColor="@color/v_text_primary"
                                android:textSize="14sp"
                                android:fontFamily="sans"
                                android:includeFontPadding="false"
                                android:alpha="0.45" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/bottom_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@color/v_bg"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="32dp">
        <Button
            android:id="@+id/button_create_usdt_payment"
            android:layout_width="match_parent"
