<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/v_bg">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/status_bar"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="bottom|center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="8dp">
            <TextView
                android:id="@+id/text_status_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="09:41"
                android:textColor="@color/v_text_primary"
                android:textSize="14sp"
                android:fontFamily="sans"
                android:includeFontPadding="false" />
            <TextView
                android:id="@+id/text_status_icons"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="LTE  WIFI  100"
                android:textColor="@color/v_text_primary"
                android:textSize="11sp"
                android:fontFamily="sans"
                android:includeFontPadding="false" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/top_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="12dp">
            <Button
                android:id="@+id/button_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_surface_circle"
                android:text="Back"
                android:textAllCaps="false"
                android:textColor="@color/v_text_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="sans"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:gravity="center" />
            <TextView
                android:id="@+id/text_nav_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Controls"
                android:textColor="@color/v_text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="sans"
                android:includeFontPadding="false" />
            <Button
                android:id="@+id/button_runtime_hex"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_surface_circle"
                android:text="HX"
                android:textAllCaps="false"
                android:textColor="@color/v_text_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="sans"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:gravity="center" />
        </LinearLayout>
        <ScrollView
            android:id="@+id/controls_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="false"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/controls_scroll_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="48dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="32dp">
                    <TextView
                        android:id="@+id/icon_runtime_identity"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:gravity="center"
                        android:text="FP"
                        android:textColor="@color/v_accent"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="sans"
                        android:includeFontPadding="false"
                        android:background="@drawable/bg_accent_soft_circle" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">
                        <TextView
                            android:id="@+id/text_runtime_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Primary Nexus"
                            android:textColor="@color/v_text_secondary"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:fontFamily="sans"
                            android:includeFontPadding="false" />
                        <TextView
                            android:id="@+id/text_runtime_id"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ID: 84423ced4-af49-4dc2v-9d97f"
                            android:textColor="@color/v_text_muted"
                            android:textSize="13sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>
                    <Button
                        android:id="@+id/button_edit_runtime"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_surface_light_circle"
                        android:text="ED"
                        android:textAllCaps="false"
                        android:textColor="@color/v_text_muted"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:fontFamily="sans"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:gravity="center" />
                </LinearLayout>
                <HorizontalScrollView
                    android:id="@+id/stats_scroller"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never"
                    android:scrollbars="none"
                    android:layout_marginBottom="36dp">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:id="@+id/stat_state"
                            android:layout_width="110dp"
                            android:layout_height="130dp"
                            android:orientation="vertical"
                            android:background="@drawable/bg_surface2_24"
                            android:padding="16dp"
                            android:layout_marginEnd="12dp">
                            <TextView
                                android:id="@+id/stat_state_icon"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:gravity="center"
                                android:text="AC"
                                android:textColor="@color/v_accent"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:fontFamily="sans"
                                android:includeFontPadding="false"
                                android:layout_marginBottom="28dp"
                                android:background="@drawable/bg_surface_light_circle" />
                            <TextView
                                android:id="@+id/stat_state_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="STATE"
                                android:textColor="@color/v_text_muted"
                                android:textSize="11sp"
                                android:fontFamily="sans"
                                android:includeFontPadding="false"
                                android:letterSpacing="0.08"
                                android:layout_marginBottom="6dp" />
                            <TextView
                                android:id="@+id/stat_state_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Running"
                                android:textColor="@color/v_text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:fontFamily="sans"
                                android:includeFontPadding="false" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/stat_tunnel"
                            android:layout_width="110dp"
                            android:layout_height="130dp"
                            android:orientation="vertical"
                            android:background="@drawable/bg_surface2_24"
                            android:padding="16dp"
                            android:layout_marginEnd="12dp">
                            <TextView
                                android:id="@+id/stat_tunnel_icon"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:gravity="center"
                                android:text="SH"
                                android:textColor="@color/v_blue"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:fontFamily="sans"
                                android:includeFontPadding="false"
                                android:layout_marginBottom="28dp"
                                android:background="@drawable/bg_surface_light_circle" />
                            <TextView
                                android:id="@+id/stat_tunnel_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="TUNNEL"
                                android:textColor="@color/v_text_muted"
                                android:textSize="11sp"
                                android:fontFamily="sans"
                                android:includeFontPadding="false"
                                android:letterSpacing="0.08"
                                android:layout_marginBottom="6dp" />
                            <TextView
                                android:id="@+id/stat_tunnel_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Encrypted"
                                android:textColor="@color/v_text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:fontFamily="sans"
                                android:includeFontPadding="false" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/stat_storage"
                            android:layout_width="110dp"
                            android:layout_height="130dp"
                            android:orientation="vertical"
                            android:background="@drawable/bg_surface2_24"
                            android:padding="16dp"
                            android:layout_marginEnd="12dp">
                            <TextView
                                android:id="@+id/stat_storage_icon"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:gravity="center"
                                android:text="DB"
                                android:textColor="@color/v_amber"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:fontFamily="sans"
                                android:includeFontPadding="false"
                                android:layout_marginBottom="28dp"
                                android:background="@drawable/bg_surface_light_circle" />
                            <TextView
                                android:id="@+id/stat_storage_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="STORAGE"
                                android:textColor="@color/v_text_muted"
                                android:textSize="11sp"
                                android:fontFamily="sans"
                                android:includeFontPadding="false"
                                android:letterSpacing="0.08"
                                android:layout_marginBottom="6dp" />
                            <TextView
                                android:id="@+id/stat_storage_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Volatile"
                                android:textColor="@color/v_text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:fontFamily="sans"
                                android:includeFontPadding="false" />
                        </LinearLayout>
                    </LinearLayout>
                </HorizontalScrollView>
                <TextView
                    android:id="@+id/label_session_parameters"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SESSION PARAMETERS"
                    android:textColor="@color/v_text_muted"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="sans"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.08"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="0dp"
                    android:layout_marginBottom="12dp" />
                <LinearLayout
                    android:id="@+id/item_display_output"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_surface_24"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">
                    <TextView
                        android:id="@+id/item_display_output_icon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:gravity="center"
                        android:text="DS"
                        android:textColor="@color/v_text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="sans"
                        android:includeFontPadding="false"
                        android:background="@drawable/bg_surface_light_circle" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">
                        <TextView
                            android:id="@+id/item_display_output_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Display &amp; Output"
                            android:textColor="@color/v_text_primary"
                            android:textSize="15sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false" />
                        <TextView
                            android:id="@+id/item_display_output_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Native resolution, 60fps"
                            android:textColor="@color/v_text_muted"
                            android:textSize="12sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/item_display_output_chevron"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&gt;"
                        android:textColor="@color/v_text_muted"
                        android:textSize="18sp"
                        android:fontFamily="sans"
                        android:includeFontPadding="false"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/item_camera_passthrough"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_surface_24"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">
                    <TextView
                        android:id="@+id/camera_passthrough_icon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:gravity="center"
                        android:text="CA"
                        android:textColor="@color/v_text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="sans"
                        android:includeFontPadding="false"
                        android:background="@drawable/bg_surface_light_16" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">
                        <TextView
                            android:id="@+id/camera_passthrough_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Camera Passthrough"
                            android:textColor="@color/v_text_primary"
                            android:textSize="15sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false" />
                        <TextView
                            android:id="@+id/camera_passthrough_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Inject local camera to cloud"
                            android:textColor="@color/v_text_muted"
                            android:textSize="12sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                    <Switch
                        android:id="@+id/switch_camera_passthrough"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/item_console_logs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_surface_24"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">
                    <TextView
                        android:id="@+id/item_console_logs_icon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:gravity="center"
                        android:text="LG"
                        android:textColor="@color/v_text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="sans"
                        android:includeFontPadding="false"
                        android:background="@drawable/bg_surface_light_circle" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">
                        <TextView
                            android:id="@+id/item_console_logs_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Console Logs"
                            android:textColor="@color/v_text_primary"
                            android:textSize="15sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false" />
                        <TextView
                            android:id="@+id/item_console_logs_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Boot &amp; network events"
                            android:textColor="@color/v_text_muted"
                            android:textSize="12sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/item_console_logs_chevron"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&gt;"
                        android:textColor="@color/v_text_muted"
                        android:textSize="18sp"
                        android:fontFamily="sans"
                        android:includeFontPadding="false"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/item_wipe_destroy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_red_card_24"
                    android:padding="16dp"
                    android:layout_marginBottom="0dp">
                    <TextView
                        android:id="@+id/item_wipe_destroy_icon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:gravity="center"
                        android:text="WR"
                        android:textColor="@color/v_danger"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="sans"
                        android:includeFontPadding="false"
                        android:background="@drawable/bg_red_soft_12" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">
                        <TextView
                            android:id="@+id/item_wipe_destroy_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Wipe &amp; Destroy"
                            android:textColor="@color/v_danger"
                            android:textSize="15sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false" />
                        <TextView
                            android:id="@+id/item_wipe_destroy_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Irreversibly delete instance"
                            android:textColor="#99EF4444"
                            android:textSize="12sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/item_wipe_destroy_chevron"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&gt;"
                        android:textColor="#80EF4444"
                        android:textSize="18sp"
                        android:fontFamily="sans"
                        android:includeFontPadding="false"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
