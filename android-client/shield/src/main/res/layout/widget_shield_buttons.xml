<!-- The card's three ways in, Shield first (the one that starts everything). The widget hides
     the icons when it is too narrow for them, and before set-up shows one button (ShieldWidget):
     so each is an icon and a label of its own, not a compound drawable, which also wouldn't
     centre with its text. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/widget_shield"
        tools:ignore="UseCompoundDrawables"
        style="@style/ShieldWidgetButton.Primary">

        <ImageView
            android:id="@+id/widget_shield_icon"
            style="@style/ShieldWidgetButtonIcon"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_ic_shield" />

        <TextView
            android:id="@+id/widget_shield_label"
            style="@style/ShieldWidgetButtonLabel.Primary"
            android:text="@string/shield" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_withdraw"
        tools:ignore="UseCompoundDrawables"
        style="@style/ShieldWidgetButton"
        android:layout_marginStart="8dp">

        <ImageView
            android:id="@+id/widget_withdraw_icon"
            style="@style/ShieldWidgetButtonIcon"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_ic_withdraw" />

        <TextView
            android:id="@+id/widget_withdraw_label"
            style="@style/ShieldWidgetButtonLabel"
            android:text="@string/withdraw" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_send"
        tools:ignore="UseCompoundDrawables"
        style="@style/ShieldWidgetButton"
        android:layout_marginStart="8dp">

        <ImageView
            android:id="@+id/widget_send_icon"
            style="@style/ShieldWidgetButtonIcon"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_ic_send" />

        <TextView
            android:id="@+id/widget_send_label"
            style="@style/ShieldWidgetButtonLabel"
            android:text="@string/send" />
    </LinearLayout>
</LinearLayout>
