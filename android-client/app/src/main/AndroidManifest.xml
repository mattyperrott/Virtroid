<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:name=".VirtroidApplication"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Virtroid"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:name=".UnlockActivity"
            android:exported="false" />
        <activity
            android:name=".PrivacySecurityActivity"
            android:exported="false" />
        <activity
            android:name=".SystemLogsActivity"
            android:exported="false" />
        <activity
            android:name=".UsdtPaymentActivity"
            android:exported="false" />
        <activity
            android:name=".FundStorageActivity"
            android:exported="false" />
        <activity
            android:name=".AccountIdentityActivity"
            android:exported="false" />
        <activity
            android:name=".OnboardingActivity"
            android:exported="false" />
        <activity
            android:name=".LauncherActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ControlsActivity"
            android:exported="false" />
        <activity
            android:name=".NewRuntimeActivity"
            android:exported="false" />
        <activity
            android:name=".SessionActivity"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <service
            android:name="org.client.scrcpy.Scrcpy"
            android:exported="false" />
    </application>

</manifest>
