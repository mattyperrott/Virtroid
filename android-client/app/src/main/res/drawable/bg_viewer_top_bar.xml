<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F20C110D" />
        </shape>
    </item>
    <!-- Only the bottom edge has a border. -->
    <item
        android:gravity="bottom"
        android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/v_border" />
        </shape>
    </item>
</layer-list>
