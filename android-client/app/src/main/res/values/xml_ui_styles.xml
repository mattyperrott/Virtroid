<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style
        name="VirtdroidText">
        <item
            name="android:fontFamily">
            sans
        </item>
        <item
            name="android:includeFontPadding">
            false
        </item>
        <item
            name="android:textColor">
            @color/v_text_primary
        </item>
    </style>
    <style
        name="VirtdroidText.Mono">
        <item
            name="android:fontFamily">
            monospace
        </item>
        <item
            name="android:includeFontPadding">
            false
        </item>
        <item
            name="android:textColor">
            @color/v_text_primary
        </item>
    </style>
    <style
        name="VirtdroidPinKey">
        <item
            name="android:layout_width">
            80dp
        </item>
        <item
            name="android:layout_height">
            80dp
        </item>
        <item
            name="android:background">
            @drawable/bg_pin_button
        </item>
        <item
            name="android:clickable">
            true
        </item>
        <item
            name="android:focusable">
            true
        </item>
    </style>
    <style
        name="VirtdroidPinDigit">
        <item
            name="android:layout_width">
            match_parent
        </item>
        <item
            name="android:layout_height">
            match_parent
        </item>
        <item
            name="android:fontFamily">
            sans
        </item>
        <item
            name="android:gravity">
            center
        </item>
        <item
            name="android:includeFontPadding">
            false
        </item>
        <item
            name="android:textColor">
            @color/v_text_primary
        </item>
        <item
            name="android:textSize">
            24sp
        </item>
    </style>
    <style
        name="VirtdroidPinLetters">
        <item
            name="android:layout_width">
            match_parent
        </item>
        <item
            name="android:layout_height">
            wrap_content
        </item>
        <item
            name="android:layout_gravity">
            bottom|center_horizontal
        </item>
        <item
            name="android:layout_marginBottom">
            17dp
        </item>
        <item
            name="android:fontFamily">
            sans
        </item>
        <item
            name="android:gravity">
            center
        </item>
        <item
            name="android:includeFontPadding">
            false
        </item>
        <item
            name="android:textColor">
            @color/v_text_dim
        </item>
        <item
            name="android:textSize">
            10sp
        </item>
    </style>
</resources>
