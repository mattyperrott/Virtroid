<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style
        name="VirtdroidText">
        <item
            name="android:fontFamily">
            sans
        </item>
        <item
            name="android:includeFontPadding">
            false
        </item>
        <item
            name="android:textColor">
            @color/v_text_primary
        </item>
    </style>
    <style
        name="VirtdroidText.Mono">
        <item
            name="android:fontFamily">
            monospace
        </item>
        <item
            name="android:includeFontPadding">
            false
        </item>
        <item
            name="android:textColor">
            @color/v_text_primary
        </item>
    </style>

    <style name="VirtdroidText.ScreenTitle" parent="VirtdroidText">
        <item name="android:textColor">@color/v_text_primary</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingExtra">0dp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="VirtdroidText.ScreenTitle.Compact" parent="VirtdroidText.ScreenTitle">
        <item name="android:textSize">24sp</item>
    </style>

    <style name="VirtdroidText.ContentHeading" parent="VirtdroidText.ScreenTitle.Compact">
        <item name="android:textColor">@color/v_text_primary</item>
    </style>

    <style name="VirtdroidText.NavTitle" parent="VirtdroidText">
        <item name="android:textColor">@color/v_text_primary</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="VirtdroidText.SectionHeading" parent="VirtdroidText">
        <item name="android:letterSpacing">0.10</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/v_text_muted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="VirtdroidText.CardTitle" parent="VirtdroidText">
        <item name="android:textColor">@color/v_text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="VirtdroidText.CardTitle.Large" parent="VirtdroidText.CardTitle">
        <item name="android:textSize">17sp</item>
    </style>

    <style name="VirtdroidText.Body" parent="VirtdroidText">
        <item name="android:textColor">@color/v_text_muted</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="VirtdroidText.Body.Compact" parent="VirtdroidText.Body">
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="VirtdroidText.Label" parent="VirtdroidText">
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/v_text_muted</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="VirtdroidText.Value" parent="VirtdroidText">
        <item name="android:textColor">@color/v_text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="VirtdroidText.Status" parent="VirtdroidText">
        <item name="android:textColor">@color/v_text_muted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="VirtdroidText.Mono.Small" parent="VirtdroidText.Mono">
        <item name="android:textColor">@color/v_text_muted</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="VirtdroidText.Mono.Log" parent="VirtdroidText.Mono">
        <item name="android:textColor">@color/v_text_primary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="VirtdroidText.Button" parent="VirtdroidText">
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/v_bg</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="VirtdroidButton.Primary" parent="Widget.Material3.Button">
        <item name="android:fontFamily">sans</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:stateListAnimator">@animator/v_button_press_scale</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/v_bg</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/v_accent</item>
        <item name="cornerRadius">999dp</item>
        <item name="elevation">0dp</item>
        <item name="rippleColor">@color/v_accent_soft</item>
    </style>

    <style name="VirtdroidButton.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:fontFamily">sans</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:stateListAnimator">@animator/v_button_press_scale</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/v_text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/v_surface_2</item>
        <item name="cornerRadius">999dp</item>
        <item name="elevation">0dp</item>
        <item name="rippleColor">@color/v_border_soft</item>
        <item name="strokeColor">@color/v_border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="VirtdroidButton.Danger" parent="VirtdroidButton.Secondary">
        <item name="android:textColor">@color/v_danger</item>
        <item name="backgroundTint">@color/v_danger_soft</item>
        <item name="strokeColor">#33EF4444</item>
    </style>

    <style name="VirtdroidButton.PlatformPrimary" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/bg_accent_round</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:stateListAnimator">@animator/v_button_press_scale</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/v_bg</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="VirtdroidButton.PlatformSecondary" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/bg_surface_stroke_24</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:stateListAnimator">@animator/v_button_press_scale</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/v_text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="VirtdroidIconButton">
        <item name="android:layout_width">@dimen/icon_button_size</item>
        <item name="android:layout_height">@dimen/icon_button_size</item>
        <item name="android:background">@drawable/bg_surface_circle</item>
        <item name="android:padding">12dp</item>
        <item name="android:tint">@color/v_text_primary</item>
    </style>

    <style name="VirtdroidIconTile">
        <item name="android:layout_width">@dimen/icon_tile_size</item>
        <item name="android:layout_height">@dimen/icon_tile_size</item>
        <item name="android:background">@drawable/bg_surface_light_circle</item>
        <item name="android:padding">13dp</item>
        <item name="android:tint">@color/v_text_primary</item>
    </style>

    <style name="VirtdroidIconTile.Accent" parent="VirtdroidIconTile">
        <item name="android:background">@drawable/bg_accent_soft_circle</item>
        <item name="android:tint">@color/v_accent</item>
    </style>

    <style name="VirtdroidStatusCheck">
        <item name="android:layout_width">@dimen/status_check_size</item>
        <item name="android:layout_height">@dimen/status_check_size</item>
        <item name="android:background">@drawable/bg_status_pill_muted</item>
        <item name="android:padding">3dp</item>
    </style>

    <style name="VirtdroidStatusDot">
        <item name="android:layout_width">@dimen/status_dot_size</item>
        <item name="android:layout_height">@dimen/status_dot_size</item>
        <item name="android:background">@drawable/bg_dot_muted</item>
    </style>

    <style name="VirtdroidCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_surface_stroke_24</item>
        <item name="android:padding">18dp</item>
    </style>

    <style name="VirtdroidInfoRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_surface_24</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:padding">16dp</item>
    </style>
    <style
        name="VirtdroidPinKey">
        <item
            name="android:layout_width">
            80dp
        </item>
        <item
            name="android:layout_height">
            80dp
        </item>
        <item
            name="android:background">
            @drawable/bg_pin_button
        </item>
        <item
            name="android:clickable">
            true
        </item>
        <item
            name="android:focusable">
            true
        </item>
    </style>
    <style
        name="VirtdroidPinDigit">
        <item
            name="android:layout_width">
            match_parent
        </item>
        <item
            name="android:layout_height">
            match_parent
        </item>
        <item
            name="android:fontFamily">
            sans
        </item>
        <item
            name="android:gravity">
            center
        </item>
        <item
            name="android:includeFontPadding">
            false
        </item>
        <item
            name="android:textColor">
            @color/v_text_primary
        </item>
        <item
            name="android:textSize">
            24sp
        </item>
    </style>
    <style
        name="VirtdroidPinLetters">
        <item
            name="android:layout_width">
            match_parent
        </item>
        <item
            name="android:layout_height">
            wrap_content
        </item>
        <item
            name="android:layout_gravity">
            bottom|center_horizontal
        </item>
        <item
            name="android:layout_marginBottom">
            17dp
        </item>
        <item
            name="android:fontFamily">
            sans
        </item>
        <item
            name="android:gravity">
            center
        </item>
        <item
            name="android:includeFontPadding">
            false
        </item>
        <item
            name="android:textColor">
            @color/v_text_dim
        </item>
        <item
            name="android:textSize">
            10sp
        </item>
    </style>

    <style name="VirtdroidSectionLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0.10</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/v_text_muted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="VirtdroidTelemetryIcon">
        <item name="android:layout_width">32dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:layout_marginEnd">14dp</item>
        <item name="android:background">@drawable/bg_surface_light_circle</item>
        <item name="android:padding">8dp</item>
        <item name="android:tint">@color/v_text_primary</item>
    </style>

    <style name="VirtdroidTelemetryLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/v_text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="VirtdroidTelemetryValueMono">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/v_text_muted</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="VirtdroidTelemetryValueChip" parent="VirtdroidTelemetryValueMono">
        <item name="android:background">@drawable/bg_accent_soft_12</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:textColor">@color/v_accent</item>
    </style>

    <style name="VirtdroidSettingsTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/v_text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="VirtdroidSettingsSubtitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/v_text_muted</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="VirtdroidSettingsDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:background">@color/v_border_soft</item>
    </style>

    <style name="VirtdroidValueChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:background">@drawable/bg_value_chip</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textColor">@color/v_text_muted</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="VirtdroidFilterChip" parent="VirtdroidText.Button">
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/bg_status_pill_muted</item>
        <item name="android:textColor">@color/v_text_primary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="VirtdroidAmountChip" parent="VirtdroidText.Button">
        <item name="android:layout_height">46dp</item>
        <item name="android:background">@drawable/bg_amount_unselected</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textColor">@color/v_text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
