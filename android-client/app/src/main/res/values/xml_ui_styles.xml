<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style
        name="VirtroidText">
        <item
            name="android:fontFamily">
            sans
        </item>
        <item
            name="android:includeFontPadding">
            false
        </item>
        <item
            name="android:textColor">
            @color/v_text_primary
        </item>
    </style>
    <style
        name="VirtroidText.Mono">
        <item
            name="android:fontFamily">
            monospace
        </item>
        <item
            name="android:includeFontPadding">
            false
        </item>
        <item
            name="android:textColor">
            @color/v_text_primary
        </item>
    </style>

    <style name="VirtroidText.ScreenTitle" parent="VirtroidText">
        <item name="android:textColor">@color/v_text_primary</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingExtra">0dp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="VirtroidText.ScreenTitle.Compact" parent="VirtroidText.ScreenTitle">
        <item name="android:textSize">24sp</item>
    </style>

    <style name="VirtroidText.ContentHeading" parent="VirtroidText.ScreenTitle.Compact">
        <item name="android:textColor">@color/v_text_primary</item>
    </style>

    <style name="VirtroidText.NavTitle" parent="VirtroidText">
        <item name="android:textColor">@color/v_text_primary</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="VirtroidText.SectionHeading" parent="VirtroidText">
        <item name="android:letterSpacing">0.10</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/v_text_muted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="VirtroidText.CardTitle" parent="VirtroidText">
        <item name="android:textColor">@color/v_text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="VirtroidText.CardTitle.Large" parent="VirtroidText.CardTitle">
        <item name="android:textSize">17sp</item>
    </style>

    <style name="VirtroidText.Body" parent="VirtroidText">
        <item name="android:textColor">@color/v_text_muted</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="VirtroidText.Body.Compact" parent="VirtroidText.Body">
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="VirtroidText.Label" parent="VirtroidText">
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/v_text_muted</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="VirtroidText.Value" parent="VirtroidText">
        <item name="android:textColor">@color/v_text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="VirtroidText.Status" parent="VirtroidText">
        <item name="android:textColor">@color/v_text_muted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="VirtroidText.Mono.Small" parent="VirtroidText.Mono">
        <item name="android:textColor">@color/v_text_muted</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="VirtroidText.Mono.Log" parent="VirtroidText.Mono">
        <item name="android:textColor">@color/v_text_primary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="VirtroidText.Button" parent="VirtroidText">
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/v_bg</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="VirtroidButton.Primary" parent="Widget.Material3.Button">
        <item name="android:fontFamily">sans</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:stateListAnimator">@animator/v_button_press_scale</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/v_bg</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/v_accent</item>
        <item name="cornerRadius">999dp</item>
        <item name="elevation">0dp</item>
        <item name="rippleColor">@color/v_accent_soft</item>
    </style>

    <style name="VirtroidButton.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:fontFamily">sans</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:stateListAnimator">@animator/v_button_press_scale</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/v_text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/v_surface_2</item>
        <item name="cornerRadius">999dp</item>
        <item name="elevation">0dp</item>
        <item name="rippleColor">@color/v_border_soft</item>
        <item name="strokeColor">@color/v_border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="VirtroidButton.Danger" parent="VirtroidButton.Secondary">
        <item name="android:textColor">@color/v_danger</item>
        <item name="backgroundTint">@color/v_danger_soft</item>
        <item name="strokeColor">#33EF4444</item>
    </style>

    <style name="VirtroidButton.PlatformPrimary" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/bg_accent_round</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:stateListAnimator">@animator/v_button_press_scale</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/v_bg</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="VirtroidButton.PlatformSecondary" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/bg_surface_stroke_24</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:stateListAnimator">@animator/v_button_press_scale</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/v_text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="VirtroidIconButton">
        <item name="android:layout_width">@dimen/icon_button_size</item>
        <item name="android:layout_height">@dimen/icon_button_size</item>
        <item name="android:background">@drawable/bg_surface_circle</item>
        <item name="android:padding">12dp</item>
        <item name="android:tint">@color/v_text_primary</item>
    </style>

    <style name="VirtroidIconTile">
        <item name="android:layout_width">@dimen/icon_tile_size</item>
        <item name="android:layout_height">@dimen/icon_tile_size</item>
        <item name="android:background">@drawable/bg_surface_light_circle</item>
        <item name="android:padding">13dp</item>
        <item name="android:tint">@color/v_text_primary</item>
    </style>

    <style name="VirtroidIconTile.Accent" parent="VirtroidIconTile">
        <item name="android:background">@drawable/bg_accent_soft_circle</item>
        <item name="android:tint">@color/v_accent</item>
    </style>

    <style name="VirtroidStatusCheck">
        <item name="android:layout_width">@dimen/status_check_size</item>
        <item name="android:layout_height">@dimen/status_check_size</item>
        <item name="android:background">@drawable/bg_status_pill_muted</item>
        <item name="android:padding">3dp</item>
    </style>

    <style name="VirtroidStatusDot">
        <item name="android:layout_width">@dimen/status_dot_size</item>
        <item name="android:layout_height">@dimen/status_dot_size</item>
        <item name="android:background">@drawable/bg_dot_muted</item>
    </style>

    <style name="VirtroidCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_surface_stroke_24</item>
        <item name="android:padding">18dp</item>
    </style>

    <style name="VirtroidInfoRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_surface_24</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:padding">16dp</item>
    </style>
    <style
        name="VirtroidPinKey">
        <item
            name="android:layout_width">
            80dp
        </item>
        <item
            name="android:layout_height">
            80dp
        </item>
        <item
            name="android:background">
            @drawable/bg_pin_button
        </item>
        <item
            name="android:clickable">
            true
        </item>
        <item
            name="android:focusable">
            true
        </item>
    </style>
    <style
        name="VirtroidPinDigit">
        <item
            name="android:layout_width">
            match_parent
        </item>
        <item
            name="android:layout_height">
            match_parent
        </item>
        <item
            name="android:fontFamily">
            sans
        </item>
        <item
            name="android:gravity">
            center
        </item>
        <item
            name="android:includeFontPadding">
            false
        </item>
        <item
            name="android:textColor">
            @color/v_text_primary
        </item>
        <item
            name="android:textSize">
            24sp
        </item>
        <item name="android:translationY">-1dp</item>
    </style>
    <style
        name="VirtroidPinLetters">
        <item
            name="android:layout_width">
            match_parent
        </item>
        <item
            name="android:layout_height">
            wrap_content
        </item>
        <item
            name="android:layout_gravity">
            bottom|center_horizontal
        </item>
        <item
            name="android:layout_marginBottom">
            17dp
        </item>
        <item
            name="android:fontFamily">
            sans
        </item>
        <item
            name="android:gravity">
            center
        </item>
        <item
            name="android:includeFontPadding">
            false
        </item>
        <item
            name="android:textColor">
            @color/v_text_dim
        </item>
        <item
            name="android:textSize">
            10sp
        </item>
        <item name="android:translationY">-1dp</item>
    </style>

    <style name="VirtroidSectionLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0.10</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/v_text_muted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="VirtroidTelemetryIcon">
        <item name="android:layout_width">32dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:layout_marginEnd">14dp</item>
        <item name="android:background">@drawable/bg_surface_light_circle</item>
        <item name="android:padding">8dp</item>
        <item name="android:tint">@color/v_text_primary</item>
    </style>

    <style name="VirtroidTelemetryLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/v_text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="VirtroidTelemetryValueMono">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/v_text_muted</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="VirtroidTelemetryValueChip" parent="VirtroidTelemetryValueMono">
        <item name="android:background">@drawable/bg_accent_soft_12</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:textColor">@color/v_accent</item>
    </style>

    <style name="VirtroidSettingsTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/v_text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="VirtroidSettingsSubtitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/v_text_muted</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="VirtroidSettingsDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:background">@color/v_border_soft</item>
    </style>

    <style name="VirtroidValueChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:background">@drawable/bg_value_chip</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textColor">@color/v_text_muted</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="VirtroidFilterChip" parent="VirtroidText.Button">
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/bg_status_pill_muted</item>
        <item name="android:textColor">@color/v_text_primary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="VirtroidAmountChip" parent="VirtroidText.Button">
        <item name="android:layout_height">46dp</item>
        <item name="android:background">@drawable/bg_amount_unselected</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textColor">@color/v_text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
