<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Virtroid" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/virtroid_primary</item>
        <item name="colorOnPrimary">@color/virtroid_on_primary</item>
        <item name="colorSecondary">@color/virtroid_secondary</item>
        <item name="colorSurface">@color/virtroid_surface</item>
        <item name="colorOnSurface">@color/virtroid_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/virtroid_on_surface_variant</item>
        <item name="colorSurfaceVariant">@color/virtroid_surface_alt</item>
        <item name="colorSurfaceContainerLowest">@color/virtroid_surface</item>
        <item name="colorSurfaceContainerLow">@color/virtroid_surface_elevated</item>
        <item name="colorSurfaceContainer">@color/virtroid_surface_alt</item>
        <item name="colorSurfaceContainerHigh">@color/virtroid_card_surface</item>
        <item name="colorSurfaceContainerHighest">@color/virtroid_card_surface_soft</item>
        <item name="colorError">@color/virtroid_error</item>
        <item name="android:windowBackground">@color/virtroid_surface</item>
        <item name="android:statusBarColor" tools:targetApi="l">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/virtroid_surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:buttonStyle">@style/Widget.Virtroid.PlatformButton</item>
        <item name="materialCardViewFilledStyle">@style/Widget.Virtroid.Card</item>
        <item name="materialButtonStyle">@style/VirtroidButton.Primary</item>
        <item name="materialButtonOutlinedStyle">@style/VirtroidButton.Secondary</item>
        <item name="textInputStyle">@style/Widget.Virtroid.TextInputLayout</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Virtroid.MaterialAlertDialog</item>
    </style>

    <style name="ThemeOverlay.Virtroid.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/virtroid_primary</item>
        <item name="colorOnSurface">@color/virtroid_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/virtroid_on_surface_variant</item>
        <item name="colorSurfaceContainerHigh">@color/virtroid_card_surface</item>
    </style>

    <style name="Theme.Virtroid.Modal" parent="Theme.Virtroid">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowMinWidthMajor">92%</item>
        <item name="android:windowMinWidthMinor">92%</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
    </style>

    <style name="Widget.Virtroid.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/virtroid_card_surface</item>
        <item name="strokeColor">@color/virtroid_card_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="Widget.Virtroid.Button" parent="Widget.Material3.Button">
        <item name="android:stateListAnimator">@animator/v_button_press_scale</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">60dp</item>
        <item name="android:textColor">@color/virtroid_on_primary</item>
        <item name="backgroundTint">@color/virtroid_primary</item>
        <item name="elevation">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Virtroid.Pill</item>
    </style>

    <style name="Widget.Virtroid.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:stateListAnimator">@animator/v_button_press_scale</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textColor">@color/virtroid_on_surface</item>
        <item name="strokeColor">@color/virtroid_card_stroke_soft</item>
        <item name="backgroundTint">@color/virtroid_card_surface</item>
        <item name="strokeWidth">1dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Virtroid.Pill</item>
    </style>

    <style name="Widget.Virtroid.PlatformButton" parent="@android:style/Widget.Material.Button">
        <item name="android:backgroundTint">@null</item>
        <item name="android:stateListAnimator">@animator/v_button_press_scale</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Virtroid.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/virtroid_surface_alt</item>
        <item name="boxStrokeColor">@color/virtroid_card_stroke_soft</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="android:textColorHint">@color/virtroid_on_surface_muted</item>
        <item name="hintTextColor">@color/virtroid_on_surface_muted</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Virtroid.Input</item>
    </style>

    <style name="ShapeAppearance.Virtroid.Pill" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">999dp</item>
    </style>

    <style name="ShapeAppearance.Virtroid.Input" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>
</resources>
