<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_enabled="true"
        android:state_pressed="true">
        <set>
            <objectAnimator
                android:duration="70"
                android:propertyName="scaleX"
                android:valueTo="0.975"
                android:valueType="floatType" />
            <objectAnimator
                android:duration="70"
                android:propertyName="scaleY"
                android:valueTo="0.975"
                android:valueType="floatType" />
            <objectAnimator
                android:duration="70"
                android:propertyName="alpha"
                android:valueTo="0.88"
                android:valueType="floatType" />
        </set>
    </item>
    <item android:state_enabled="true">
        <set>
            <objectAnimator
                android:duration="120"
                android:propertyName="scaleX"
                android:valueTo="1"
                android:valueType="floatType" />
            <objectAnimator
                android:duration="120"
                android:propertyName="scaleY"
                android:valueTo="1"
                android:valueType="floatType" />
            <objectAnimator
                android:duration="120"
                android:propertyName="alpha"
                android:valueTo="1"
                android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator
                android:duration="120"
                android:propertyName="scaleX"
                android:valueTo="1"
                android:valueType="floatType" />
            <objectAnimator
                android:duration="120"
                android:propertyName="scaleY"
                android:valueTo="1"
                android:valueType="floatType" />
            <objectAnimator
                android:duration="120"
                android:propertyName="alpha"
                android:valueTo="0.48"
                android:valueType="floatType" />
        </set>
    </item>
</selector>
