<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/v_bg">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/top_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="20dp"
            android:paddingBottom="12dp">
            <ImageButton
                android:id="@+id/button_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_surface_stroke_24"
                android:contentDescription="@string/controls_back"
                android:padding="11dp"
                android:src="@drawable/ic_arrow_back"
                android:tint="@color/v_text_primary" />
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />
        </LinearLayout>
        <ScrollView
            android:id="@+id/send_usdt_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="false"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/send_usdt_scroll_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="180dp">
                <TextView
                    android:id="@+id/text_title"
                    style="@style/VirtdroidText.ScreenTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Send USDT"
                    android:layout_marginBottom="20dp" />
                <LinearLayout
                    android:id="@+id/payment_status_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_surface_stroke_32"
                    android:padding="20dp"
                    android:layout_marginBottom="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="18dp">
                        <View
                            android:id="@+id/payment_waiting_dot"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:background="@drawable/bg_dot_amber"
                            android:layout_marginEnd="12dp" />
                        <TextView
                            android:id="@+id/payment_status_title"
                            style="@style/VirtdroidText.CardTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/payment_quote_unavailable"
                            android:textColor="@color/v_amber"
                            android:letterSpacing="0.06" />
                        <TextView
                            android:id="@+id/payment_timer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--:--"
                            android:textColor="@color/v_text_primary"
                            android:textSize="12sp"
                            android:fontFamily="monospace"
                            android:includeFontPadding="false"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="7dp"
                            android:paddingBottom="7dp"
                            android:background="@drawable/bg_chip_dark" />
                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/v_border"
                        android:layout_marginBottom="16dp" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/network_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Network"
                            android:textColor="@color/v_text_muted"
                            android:textSize="13sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false" />
                        <TextView
                            android:id="@+id/network_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="USDT TRC20"
                            android:textColor="@color/v_text_primary"
                            android:textSize="13sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp">
                        <TextView
                            android:id="@+id/provider_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="External Provider"
                            android:textColor="@color/v_text_muted"
                            android:textSize="13sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false" />
                        <TextView
                            android:id="@+id/provider_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="Non-custodial swap"
                            android:textColor="@color/v_text_primary"
                            android:textSize="12sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/amount_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_surface_stroke_32"
                    android:padding="20dp"
                    android:layout_marginBottom="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">
                        <TextView
                            android:id="@+id/amount_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Exact Amount Needed"
                            android:textColor="@color/v_text_muted"
                            android:textSize="14sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false" />
                        <TextView
                            android:id="@+id/amount_warning_chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Send exact amount"
                            android:textColor="@color/v_accent"
                            android:textSize="12sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp"
                            android:background="@drawable/bg_accent_soft_12" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/amount_box"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_input_20"
                        android:padding="16dp">
                        <TextView
                            android:id="@+id/amount_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="--"
                            android:textColor="@color/v_text_primary"
                            android:textSize="21sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace"
                            android:includeFontPadding="false" />
                        <ImageButton
                            android:id="@+id/button_show_qr"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_surface_stroke_24"
                            android:contentDescription="@string/session_upload"
                            android:padding="10dp"
                            android:src="@drawable/ic_qr"
                            android:tint="@color/v_text_primary" />
                        <ImageButton
                            android:id="@+id/button_copy_amount"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_surface_stroke_24"
                            android:contentDescription="@string/onboarding_copy_account"
                            android:padding="10dp"
                            android:src="@drawable/ic_copy"
                            android:tint="@color/v_text_primary" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/deposit_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_surface_stroke_32"
                    android:padding="20dp"
                    android:layout_marginBottom="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">
                        <TextView
                            android:id="@+id/deposit_address_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Deposit Address"
                            android:textColor="@color/v_text_muted"
                            android:textSize="14sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false" />
                        <TextView
                            android:id="@+id/deposit_network_chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TRC20 Only"
                            android:textColor="@color/v_amber"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp"
                            android:background="@drawable/bg_amber_soft_12" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/deposit_address_box"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_input_20"
                        android:padding="16dp"
                        android:layout_marginBottom="16dp">
                        <TextView
                            android:id="@+id/deposit_address_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/payment_quote_unavailable"
                            android:textColor="@color/v_text_primary"
                            android:textSize="13sp"
                            android:fontFamily="monospace"
                            android:includeFontPadding="false"
                            android:maxLines="2"
                            android:ellipsize="end" />
                        <ImageButton
                            android:id="@+id/button_copy_deposit_address"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="12dp"
                            android:background="@drawable/bg_accent_round"
                            android:contentDescription="@string/onboarding_copy_account"
                            android:padding="10dp"
                            android:src="@drawable/ic_copy"
                            android:tint="@color/v_bg" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/deposit_warning_box"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_red_soft_12"
                        android:padding="12dp">
                        <TextView
                            android:id="@+id/deposit_warning_icon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="!"
                            android:textColor="@color/v_danger"
                            android:textSize="14sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:layout_marginEnd="8dp" />
                        <TextView
                            android:id="@+id/deposit_warning_text"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Sending via the wrong network may result in permanent loss of funds. Use USDT TRC20."
                            android:textColor="@color/v_text_muted"
                            android:textSize="11sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:lineSpacingExtra="3dp" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/destination_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_surface_stroke_32"
                    android:padding="20dp"
                    android:layout_marginBottom="28dp">
                    <TextView
                        android:id="@+id/destination_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Destination Details"
                        android:textColor="@color/v_text_primary"
                        android:textSize="14sp"
                        android:fontFamily="sans"
                        android:includeFontPadding="false"
                        android:layout_marginBottom="16dp" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/destination_wallet_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Sia Wallet"
                            android:textColor="@color/v_text_muted"
                            android:textSize="13sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false" />
                        <TextView
                            android:id="@+id/destination_wallet_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="--"
                            android:textColor="@color/v_text_primary"
                            android:textSize="13sp"
                            android:fontFamily="monospace"
                            android:includeFontPadding="false" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginTop="14dp">
                        <TextView
                            android:id="@+id/estimated_receipt_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Estimated Receipt"
                            android:textColor="@color/v_text_muted"
                            android:textSize="13sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false" />
                        <TextView
                            android:id="@+id/estimated_receipt_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="--"
                            android:textColor="@color/v_accent"
                            android:textSize="13sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginTop="14dp">
                        <TextView
                            android:id="@+id/storage_contracts_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Storage Contracts"
                            android:textColor="@color/v_text_muted"
                            android:textSize="13sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false" />
                        <TextView
                            android:id="@+id/storage_contracts_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="@string/payment_quote_unavailable"
                            android:textColor="@color/v_text_dim"
                            android:textSize="13sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false" />
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:id="@+id/transaction_progress_title"
                    style="@style/VirtdroidText.SectionHeading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TRANSACTION PROGRESS"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="20dp" />
                <FrameLayout
                    android:id="@+id/transaction_timeline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp">
                    <View
                        android:id="@+id/transaction_timeline_line"
                        android:layout_width="2dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_timeline_line"
                        android:layout_marginStart="11dp" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <LinearLayout
                            android:id="@+id/step_quote_created"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_marginBottom="24dp">
                            <View
                                android:id="@+id/step_quote_created_dot"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:background="@drawable/bg_dot_accent"
                                android:layout_marginEnd="16dp" />
                            <TextView
                                android:id="@+id/step_quote_created_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Quote unavailable"
                                android:textColor="@color/v_text_primary"
                                android:textSize="14sp"
                                android:fontFamily="sans"
                                android:includeFontPadding="false" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/step_waiting_usdt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_marginBottom="24dp">
                            <View
                                android:id="@+id/step_waiting_usdt_dot"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:background="@drawable/bg_dot_amber_outline"
                                android:layout_marginEnd="16dp" />
                            <TextView
                                android:id="@+id/step_waiting_usdt_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Waiting for USDT"
                                android:textColor="@color/v_amber"
                                android:textSize="14sp"
                                android:fontFamily="sans"
                                android:includeFontPadding="false" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/step_blockchain_confirmation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_marginBottom="24dp">
                            <View
                                android:id="@+id/step_blockchain_confirmation_dot"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:background="@drawable/bg_dot_muted_outline"
                                android:layout_marginEnd="16dp" />
                            <TextView
                                android:id="@+id/step_blockchain_confirmation_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Blockchain confirmation"
                                android:textColor="@color/v_text_primary"
                                android:textSize="14sp"
                                android:fontFamily="sans"
                                android:includeFontPadding="false"
                                android:alpha="0.45" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/step_converting_siacoin"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_marginBottom="24dp">
                            <View
                                android:id="@+id/step_converting_siacoin_dot"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:background="@drawable/bg_dot_muted_outline"
                                android:layout_marginEnd="16dp" />
                            <TextView
                                android:id="@+id/step_converting_siacoin_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Converting to Siacoin"
                                android:textColor="@color/v_text_primary"
                                android:textSize="14sp"
                                android:fontFamily="sans"
                                android:includeFontPadding="false"
                                android:alpha="0.45" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/step_funding_wallet"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_marginBottom="24dp">
                            <View
                                android:id="@+id/step_funding_wallet_dot"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:background="@drawable/bg_dot_muted_outline"
                                android:layout_marginEnd="16dp" />
                            <TextView
                                android:id="@+id/step_funding_wallet_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Funding storage wallet"
                                android:textColor="@color/v_text_primary"
                                android:textSize="14sp"
                                android:fontFamily="sans"
                                android:includeFontPadding="false"
                                android:alpha="0.45" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/step_storage_ready"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_marginBottom="0dp">
                            <View
                                android:id="@+id/step_storage_ready_dot"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:background="@drawable/bg_dot_muted_outline"
                                android:layout_marginEnd="16dp" />
                            <TextView
                                android:id="@+id/step_storage_ready_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Storage ready"
                                android:textColor="@color/v_text_primary"
                                android:textSize="14sp"
                                android:fontFamily="sans"
                                android:includeFontPadding="false"
                                android:alpha="0.45" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/bottom_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@color/v_bg"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_payment_sent"
            style="@style/VirtdroidButton.Secondary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="I've Sent Payment" />
        <Button
            android:id="@+id/button_cancel_quote"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_transparent"
            android:text="Cancel Quote"
            android:textAllCaps="false"
            android:textColor="@color/v_danger"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="sans"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:gravity="center" />
    </LinearLayout>
</FrameLayout>
