<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <ImageView
        android:id="@+id/sheetRowIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_accent_soft_circle"
        android:importantForAccessibility="no"
        android:padding="10dp"
        app:tint="@color/v_accent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/sheetRowTitle"
            style="@style/VirtroidText.CardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/sheetRowSubtitle"
            style="@style/VirtroidText.Body.Compact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="3"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/sheetRowAction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:fontFamily="sans"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/sheetRowChevron"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="8dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron_right"
        android:visibility="gone"
        app:tint="@color/v_text_muted" />
</LinearLayout>
