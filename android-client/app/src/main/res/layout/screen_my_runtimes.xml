<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/v_bg">

    <LinearLayout
        android:id="@+id/mainContentLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ProgressBar
            android:id="@+id/progressIndicator"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:indeterminate="true"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingTop="30dp"
            android:paddingEnd="24dp"
            android:paddingBottom="30dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/statusText"
                    style="@style/VirtroidText.SectionHeading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="@string/home_secure_client" />

                <TextView
                    android:id="@+id/text_title"
                    style="@style/VirtroidText.ScreenTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_title" />

            </LinearLayout>

            <FrameLayout
                android:layout_width="52dp"
                android:layout_height="52dp">

                <ImageButton
                    android:id="@+id/notificationButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_surface_circle"
                    android:contentDescription="@string/system_logs_open_errors"
                    android:padding="13dp"
                    android:src="@drawable/ic_bell"
                    app:tint="@color/v_text_primary" />

                <TextView
                    android:id="@+id/notificationBadgeText"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_notification_badge"
                    android:fontFamily="sans"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="1"
                    android:textColor="@color/v_white"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/runtimeEmptyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="40dp"
            android:layout_marginEnd="24dp"
            android:fontFamily="sans"
            android:gravity="center_horizontal"
            android:includeFontPadding="false"
            android:text="@string/home_empty_subtitle"
            android:textColor="@color/v_text_muted"
            android:textSize="14sp"
            android:visibility="gone" />

        <ScrollView
            android:id="@+id/runtime_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="false"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/runtimeListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingTop="10dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="132dp" />
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/bg_bottom_nav"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.9">

            <ImageButton
                android:id="@+id/runtimesNavButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_surface_circle"
                android:contentDescription="@string/home_title"
                android:padding="13dp"
                android:src="@drawable/ic_storage"
                app:tint="@color/v_accent" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.9">

            <ImageButton
                android:id="@+id/securityNavButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_transparent"
                android:contentDescription="@string/bottom_security"
                android:padding="13dp"
                android:src="@drawable/ic_shield"
                app:tint="@color/v_text_muted" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2.0">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/createRuntimeButton"
                style="@style/VirtroidButton.Primary"
                android:layout_width="116dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:minHeight="48dp"
                android:text="+ New" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.9">

            <ImageButton
                android:id="@+id/logsNavButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_transparent"
                android:contentDescription="@string/bottom_logs"
                android:padding="13dp"
                android:src="@drawable/ic_terminal"
                app:tint="@color/v_text_muted" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.9">

            <ImageButton
                android:id="@+id/settingsNavButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_transparent"
                android:contentDescription="@string/bottom_settings"
                android:padding="13dp"
                android:src="@drawable/ic_settings"
                app:tint="@color/v_text_muted" />
        </FrameLayout>
    </LinearLayout>

    <View
        android:id="@+id/home_indicator"
        android:layout_width="128dp"
        android:layout_height="4dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_home_indicator" />
</FrameLayout>
