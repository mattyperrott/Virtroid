<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/appInstallRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/v_bg_alt">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/top_app_bar"
            android:layout_width="match_parent"
            android:layout_height="126dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="52dp"
            android:paddingBottom="18dp">

            <ImageButton
                android:id="@+id/button_back"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/bg_surface_circle"
                android:contentDescription="@string/controls_back"
                android:padding="16dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/v_text_primary" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/app_install_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_install_title"
                    android:textColor="@color/v_text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:fontFamily="sans"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/app_install_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_install_subtitle"
                    android:textColor="@color/v_text_muted"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:fontFamily="sans"
                    android:includeFontPadding="false"
                    android:layout_marginTop="10dp" />
            </LinearLayout>
        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/v_border" />

        <ScrollView
            android:id="@+id/app_install_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="false"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/app_install_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="30dp"
                android:paddingBottom="140dp">

                <LinearLayout
                    android:id="@+id/search_shell"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_input_20"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp"
                    android:layout_marginBottom="28dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_search"
                        app:tint="@color/v_text_muted" />

                    <EditText
                        android:id="@+id/app_search_input"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="@string/app_install_search_hint"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:paddingStart="16dp"
                        android:paddingEnd="0dp"
                        android:singleLine="true"
                        android:textColor="@color/v_text_primary"
                        android:textColorHint="@color/v_text_dim"
                        android:textCursorDrawable="@null"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:fontFamily="sans"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/apps_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_surface_stroke_32"
                    android:clipToOutline="true">

                    <LinearLayout
                        android:id="@+id/recommended_header"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="22dp"
                        android:paddingEnd="22dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/app_install_recommended"
                            android:textColor="@color/v_text_muted"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="sans"
                            android:letterSpacing="0.12"
                            android:includeFontPadding="false" />

                        <TextView
                            android:id="@+id/recommended_count"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:gravity="center"
                            android:background="@drawable/bg_chip_dark"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:text="@string/app_install_count"
                            android:textColor="@color/v_text_muted"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="sans"
                            android:includeFontPadding="false" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/recommended_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <LinearLayout
                        android:id="@+id/all_available_header"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_surface2_24"
                        android:paddingStart="22dp"
                        android:paddingEnd="22dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/app_install_all_available"
                            android:textColor="@color/v_text_muted"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="sans"
                            android:letterSpacing="0.12"
                            android:includeFontPadding="false" />

                        <TextView
                            android:id="@+id/all_available_count"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:gravity="center"
                            android:background="@drawable/bg_chip_dark"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:text="@string/app_install_count"
                            android:textColor="@color/v_text_muted"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="sans"
                            android:includeFontPadding="false" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/all_available_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/app_empty_text"
                        android:layout_width="match_parent"
                        android:layout_height="96dp"
                        android:gravity="center"
                        android:text="@string/app_install_empty"
                        android:textColor="@color/v_text_muted"
                        android:textSize="14sp"
                        android:fontFamily="sans"
                        android:includeFontPadding="false"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottom_action_bar"
        android:layout_width="match_parent"
        android:layout_height="116dp"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="22dp"
        android:background="@color/v_bg_alt">

        <Button
            android:id="@+id/done_button"
            style="@style/Widget.Virtroid.Button"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="@string/app_install_done"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
