<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/welcomeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/v_bg">

    <io.virtroid.client.ui.WelcomeNetworkView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/welcomeBrand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp">

        <io.virtroid.client.ui.AnimatedVirtroidMarkView
            android:layout_width="17dp"
            android:layout_height="21dp"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="sans"
            android:includeFontPadding="false"
            android:letterSpacing="0.02"
            android:text="@string/welcome_brand"
            android:textColor="@color/v_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/welcomeActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_welcome_scrim"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="112dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans"
            android:includeFontPadding="false"
            android:lineSpacingExtra="-2dp"
            android:text="@string/welcome_title"
            android:textColor="@color/v_text_primary"
            android:textSize="39sp"
            android:textStyle="bold" />

        <TextView
            style="@style/VirtroidText.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="28dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/welcome_body"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/getStartedButton"
            style="@style/VirtroidButton.Primary"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="@string/welcome_get_started" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/recoverAccountButton"
            style="@style/VirtroidButton.Secondary"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="10dp"
            android:text="@string/welcome_recover_account" />
    </LinearLayout>
</FrameLayout>
