<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/v_black">

    <TextureView
        android:id="@+id/cameraPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageButton
        android:id="@+id/cameraCloseButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_margin="20dp"
        android:background="@drawable/bg_surface_24"
        android:contentDescription="@string/session_camera_close"
        android:padding="13dp"
        android:src="@drawable/ic_close"
        app:tint="@color/v_text_primary" />

    <ProgressBar
        android:id="@+id/cameraProgress"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/v_accent" />

    <ImageButton
        android:id="@+id/cameraShutterButton"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="42dp"
        android:background="@drawable/bg_accent_soft_circle"
        android:contentDescription="@string/session_camera_take_photo"
        android:enabled="false"
        android:padding="20dp"
        android:src="@drawable/ic_camera"
        app:tint="@color/v_accent" />
</FrameLayout>
