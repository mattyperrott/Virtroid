<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="20dp"
    app:cardBackgroundColor="@color/v_surface"
    app:cardCornerRadius="@dimen/card_radius"
    app:cardElevation="0dp"
    app:strokeColor="@color/v_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_surface_light_16">

                <ImageView
                    android:id="@+id/runtimeIcon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_phone"
                    app:tint="@color/v_accent" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/runtimeTitleText"
                    style="@style/VirtroidText.CardTitle.Large"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/v_text_primary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/runtimeStatusDot"
                        style="@style/VirtroidStatusDot"
                        android:layout_marginEnd="7dp"
                        android:background="@drawable/bg_dot_muted" />

                    <TextView
                        android:id="@+id/runtimeSubtitleText"
                        style="@style/VirtroidText.Status"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/v_text_muted" />
                </LinearLayout>
            </LinearLayout>

            <ImageButton
                android:id="@+id/liveRuntimeControlsButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_surface_light_circle"
                android:contentDescription="@string/runtime_controls"
                android:padding="13dp"
                android:src="@drawable/ic_tune"
                android:visibility="gone"
                app:tint="@color/v_text_muted" />

        </LinearLayout>

        <FrameLayout
            android:id="@+id/runtimeProvisioningFrame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:animateLayoutChanges="true">

            <LinearLayout
                android:id="@+id/runtimeInteractiveContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

        <LinearLayout
            android:id="@+id/runtimeStatsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.62"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/runtimeStatOneLabel"
                    style="@style/VirtroidText.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/runtime_stat_one_label" />

                <TextView
                    android:id="@+id/runtimeStatOneValue"
                    style="@style/VirtroidText.Value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="@string/runtime_stat_load_unknown" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="10dp"
                android:background="@color/v_border_soft" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.72"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/runtimeStatTwoLabel"
                    style="@style/VirtroidText.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/runtime_stat_two_label" />

                <TextView
                    android:id="@+id/runtimeStatTwoValue"
                    style="@style/VirtroidText.Value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/runtime_stat_load_unknown" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="10dp"
                android:background="@color/v_border_soft" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.66"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/runtimeStatThreeLabel"
                    style="@style/VirtroidText.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/runtime_stat_three_label" />

                <TextView
                    android:id="@+id/runtimeStatThreeValue"
                    style="@style/VirtroidText.Value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="@string/runtime_stat_load_unknown" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/connectRuntimeButton"
            style="@style/VirtroidButton.Primary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="26dp"
            android:text="@string/runtime_connect_display"
            app:icon="@drawable/ic_chevron_right"
            app:iconGravity="textEnd"
            app:iconPadding="12dp"
            app:iconTint="@color/v_bg" />

        <LinearLayout
            android:id="@+id/runtimeActionRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/startRuntimeButton"
                style="@style/VirtroidButton.Secondary"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="@string/runtime_start"
                app:icon="@drawable/ic_play"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconTint="@color/v_accent" />

            <ImageButton
                android:id="@+id/actionControlsButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_surface_light_circle"
                android:contentDescription="@string/runtime_controls"
                android:padding="15dp"
                android:src="@drawable/ic_tune"
                app:tint="@color/v_text_muted" />

            <ImageButton
                android:id="@+id/deleteRuntimeButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_red_soft_24"
                android:contentDescription="@string/runtime_delete"
                android:padding="15dp"
                android:src="@drawable/ic_delete"
                app:tint="@color/v_danger" />
        </LinearLayout>

        <TextView
            android:id="@+id/runtimeErrorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans"
            android:includeFontPadding="false"
            android:textColor="@color/v_danger"
            android:textSize="13sp"
            android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/runtimeProvisioningLogContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:background="@drawable/bg_provisioning_log_active"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="16dp"
                android:paddingEnd="18dp"
                android:paddingBottom="16dp"
                android:translationZ="6dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/runtimeProvisioningTitleText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans"
                    android:includeFontPadding="false"
                    android:text="@string/runtime_provisioning_title_request"
                    android:textColor="@color/v_accent"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/runtimeProvisioningProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:indeterminate="true"
                    app:indicatorColor="@color/v_accent"
                    app:trackColor="@color/v_border_soft" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_provisioning_log_code"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="10dp">

                        <TextView
                            android:id="@+id/runtimeProvisioningCommandText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:includeFontPadding="false"
                            android:text="@string/runtime_provisioning_command_request"
                            android:textColor="@color/v_accent"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/runtimeProvisioningDetailText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:ellipsize="end"
                            android:fontFamily="monospace"
                            android:includeFontPadding="false"
                            android:maxLines="2"
                            android:text="@string/runtime_provisioning_detail_request"
                            android:textColor="@color/v_text_primary"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/runtimeProvisioningEventTrailText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="monospace"
                            android:includeFontPadding="false"
                            android:ellipsize="end"
                            android:lineSpacingExtra="3dp"
                            android:maxLines="3"
                            android:textColor="@color/v_text_muted"
                            android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
