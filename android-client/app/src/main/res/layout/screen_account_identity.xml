<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/v_bg_alt">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/top_app_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="54dp"
            android:paddingBottom="8dp">
            <ImageButton
                android:id="@+id/button_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_surface_circle"
                android:contentDescription="@string/controls_back"
                android:padding="13dp"
                android:src="@drawable/ic_arrow_back"
                android:tint="@color/v_text_primary" />
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />
            <ImageButton
                android:id="@+id/button_settings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_surface_circle"
                android:contentDescription="@string/bottom_settings"
                android:padding="13dp"
                android:src="@drawable/ic_tune"
                android:tint="@color/v_text_primary" />
        </LinearLayout>
        <ScrollView
            android:id="@+id/account_identity_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="false"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/account_identity_scroll_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="64dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="40dp">
                    <ImageView
                        android:id="@+id/account_identity_icon"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:padding="18dp"
                        android:src="@drawable/ic_fingerprint"
                        android:tint="@color/v_accent"
                        android:background="@drawable/bg_accent_soft_circle" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">
                        <TextView
                            android:id="@+id/text_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Account Identity"
                            android:textColor="@color/v_text_primary"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:layout_marginBottom="8dp" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <View
                                android:id="@+id/active_session_dot"
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:background="@drawable/bg_dot_accent"
                                android:layout_marginEnd="6dp" />
                            <TextView
                                android:id="@+id/text_active_session"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Active Local Session"
                                android:textColor="@color/v_text_muted"
                                android:textSize="13sp"
                                android:fontFamily="sans"
                                android:includeFontPadding="false" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/item_account_id"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_surface_24"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">
                    <ImageView
                        android:id="@+id/item_account_id_icon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:padding="13dp"
                        android:src="@drawable/ic_copy"
                        android:tint="@color/v_text_primary"
                        android:background="@drawable/bg_surface_light_circle" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">
                        <TextView
                            android:id="@+id/item_account_id_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Account ID"
                            android:textColor="@color/v_text_primary"
                            android:textSize="15sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false" />
                        <TextView
                            android:id="@+id/item_account_id_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="vd_acc_9x8f2a1b4c7d"
                            android:textColor="@color/v_text_muted"
                            android:textSize="12sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/item_account_id_chevron"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&gt;"
                        android:textColor="@color/v_text_muted"
                        android:textSize="18sp"
                        android:fontFamily="sans"
                        android:includeFontPadding="false"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/item_device_fingerprint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_surface_24"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">
                    <ImageView
                        android:id="@+id/item_device_fingerprint_icon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:padding="13dp"
                        android:src="@drawable/ic_fingerprint"
                        android:tint="@color/v_accent"
                        android:background="@drawable/bg_accent_soft_circle" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">
                        <TextView
                            android:id="@+id/item_device_fingerprint_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Device Fingerprint"
                            android:textColor="@color/v_text_primary"
                            android:textSize="15sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false" />
                        <TextView
                            android:id="@+id/item_device_fingerprint_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="f8c9-4a2b-9e1d / Registered"
                            android:textColor="@color/v_text_muted"
                            android:textSize="12sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/item_device_fingerprint_chevron"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&gt;"
                        android:textColor="@color/v_text_muted"
                        android:textSize="18sp"
                        android:fontFamily="sans"
                        android:includeFontPadding="false"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/identity_sync_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_surface_24"
                    android:padding="16dp"
                    android:layout_marginBottom="36dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/identity_encryption_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Encryption"
                            android:textColor="@color/v_text_muted"
                            android:textSize="13sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false" />
                        <TextView
                            android:id="@+id/identity_encryption_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="Local identity key"
                            android:textColor="@color/v_text_primary"
                            android:textSize="13sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginTop="14dp">
                        <TextView
                            android:id="@+id/identity_created_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Created"
                            android:textColor="@color/v_text_muted"
                            android:textSize="13sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false" />
                        <TextView
                            android:id="@+id/identity_created_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="Oct 24, 2023"
                            android:textColor="@color/v_text_primary"
                            android:textSize="13sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginTop="14dp">
                        <TextView
                            android:id="@+id/identity_last_sync_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Last Sync"
                            android:textColor="@color/v_text_muted"
                            android:textSize="13sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false" />
                        <TextView
                            android:id="@+id/identity_last_sync_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="2 hours ago"
                            android:textColor="@color/v_text_primary"
                            android:textSize="13sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false" />
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:id="@+id/label_decentralized_storage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DECENTRALIZED STORAGE"
                    android:textColor="@color/v_text_muted"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="sans"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.08"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="0dp"
                    android:layout_marginBottom="12dp" />
                <LinearLayout
                    android:id="@+id/storage_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_surface_stroke_32"
                    android:padding="20dp"
                    android:layout_marginBottom="36dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="20dp">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">
                                <TextView
                                    android:id="@+id/storage_usage_value"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="428"
                                    android:textColor="@color/v_text_primary"
                                    android:textSize="38sp"
                                    android:textStyle="bold"
                                    android:fontFamily="sans"
                                    android:includeFontPadding="false" />
                                <TextView
                                    android:id="@+id/storage_usage_unit"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="bottom"
                                    android:text=" MB"
                                    android:textColor="@color/v_text_muted"
                                    android:textSize="24sp"
                                    android:fontFamily="sans"
                                    android:includeFontPadding="false" />
                            </LinearLayout>
                            <TextView
                                android:id="@+id/storage_usage_subtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Snapshot metadata stored"
                                android:textColor="@color/v_text_muted"
                                android:textSize="13sp"
                                android:fontFamily="sans"
                                android:includeFontPadding="false"
                                android:layout_marginTop="6dp" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/storage_ready_chip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="Ready"
                                android:textColor="@color/v_accent"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:fontFamily="sans"
                                android:includeFontPadding="false"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:paddingTop="5dp"
                                android:paddingBottom="5dp"
                                android:layout_marginBottom="8dp"
                                android:background="@drawable/bg_accent_soft_12" />
                            <TextView
                                android:id="@+id/storage_snapshots"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="end"
                                android:text="3 Snapshots"
                                android:textColor="@color/v_text_muted"
                                android:textSize="11sp"
                                android:fontFamily="sans"
                                android:includeFontPadding="false" />
                        </LinearLayout>
                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/v_border"
                        android:layout_marginBottom="16dp" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">
                        <LinearLayout
                            android:id="@+id/storage_backend"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:background="@drawable/bg_surface_light_24"
                            android:padding="14dp"
                            android:layout_marginEnd="10dp">
                            <TextView
                                android:id="@+id/storage_backend_icon"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:gravity="center"
                                android:text="HD"
                                android:textColor="@color/v_text_primary"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:fontFamily="sans"
                                android:includeFontPadding="false"
                                android:layout_marginBottom="16dp"
                                android:background="@drawable/bg_surface_light_circle" />
                            <TextView
                                android:id="@+id/storage_backend_label"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="BACKEND"
                                android:textColor="@color/v_text_muted"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:fontFamily="sans"
                                android:includeFontPadding="false"
                                android:letterSpacing="0.08"
                                android:layout_marginBottom="4dp" />
                            <TextView
                                android:id="@+id/storage_backend_value"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="Sia renterd"
                                android:textColor="@color/v_text_primary"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:fontFamily="sans"
                                android:includeFontPadding="false" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/storage_credit"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:background="@drawable/bg_surface_light_24"
                            android:padding="14dp"
                            android:layout_marginEnd="10dp">
                            <TextView
                                android:id="@+id/storage_credit_icon"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:gravity="center"
                                android:text="$"
                                android:textColor="@color/v_accent"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:fontFamily="sans"
                                android:includeFontPadding="false"
                                android:layout_marginBottom="16dp"
                                android:background="@drawable/bg_accent_soft_circle" />
                            <TextView
                                android:id="@+id/storage_credit_label"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="CREDIT"
                                android:textColor="@color/v_text_muted"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:fontFamily="sans"
                                android:includeFontPadding="false"
                                android:letterSpacing="0.08"
                                android:layout_marginBottom="4dp" />
                            <TextView
                                android:id="@+id/storage_credit_value"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="~$8.42"
                                android:textColor="@color/v_text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:fontFamily="sans"
                                android:includeFontPadding="false" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/storage_runway"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:background="@drawable/bg_surface_light_24"
                            android:padding="14dp">
                            <TextView
                                android:id="@+id/storage_runway_icon"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:gravity="center"
                                android:text="27"
                                android:textColor="@color/v_text_primary"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:fontFamily="sans"
                                android:includeFontPadding="false"
                                android:layout_marginBottom="16dp"
                                android:background="@drawable/bg_surface_light_circle" />
                            <TextView
                                android:id="@+id/storage_runway_label"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="RUNWAY"
                                android:textColor="@color/v_text_muted"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:fontFamily="sans"
                                android:includeFontPadding="false"
                                android:letterSpacing="0.08"
                                android:layout_marginBottom="4dp" />
                            <TextView
                                android:id="@+id/storage_runway_value"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="27 Days"
                                android:textColor="@color/v_text_primary"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:fontFamily="sans"
                                android:includeFontPadding="false" />
                        </LinearLayout>
                    </LinearLayout>
                    <Button
                        android:id="@+id/button_manage_storage"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_surface_light_20"
                        android:text="Manage Storage Preferences"
                        android:textAllCaps="false"
                        android:textColor="@color/v_text_primary"
                        android:textSize="14sp"
                        android:fontFamily="sans"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:gravity="center" />
                </LinearLayout>
                <TextView
                    android:id="@+id/label_security"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SECURITY"
                    android:textColor="@color/v_text_muted"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="sans"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.08"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="0dp"
                    android:layout_marginBottom="12dp" />
                <LinearLayout
                    android:id="@+id/item_app_lock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_surface_24"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">
                    <ImageView
                        android:id="@+id/item_app_lock_icon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:padding="13dp"
                        android:src="@drawable/ic_lock"
                        android:tint="@color/v_text_primary"
                        android:background="@drawable/bg_surface_light_circle" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">
                        <TextView
                            android:id="@+id/item_app_lock_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="App Lock"
                            android:textColor="@color/v_text_primary"
                            android:textSize="15sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false" />
                        <TextView
                            android:id="@+id/item_app_lock_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PIN enabled"
                            android:textColor="@color/v_text_muted"
                            android:textSize="12sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/item_app_lock_chevron"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&gt;"
                        android:textColor="@color/v_text_muted"
                        android:textSize="18sp"
                        android:fontFamily="sans"
                        android:includeFontPadding="false"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/item_identity_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_surface_24"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">
                    <ImageView
                        android:id="@+id/item_identity_password_icon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:padding="13dp"
                        android:src="@drawable/ic_terminal"
                        android:tint="@color/v_text_primary"
                        android:background="@drawable/bg_surface_light_circle" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">
                        <TextView
                            android:id="@+id/item_identity_password_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Identity Password"
                            android:textColor="@color/v_text_primary"
                            android:textSize="15sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false" />
                        <TextView
                            android:id="@+id/item_identity_password_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Set"
                            android:textColor="@color/v_text_muted"
                            android:textSize="12sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/item_identity_password_chevron"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&gt;"
                        android:textColor="@color/v_text_muted"
                        android:textSize="18sp"
                        android:fontFamily="sans"
                        android:includeFontPadding="false"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/item_device_signing_key"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_surface_24"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">
                    <ImageView
                        android:id="@+id/item_device_signing_key_icon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:padding="13dp"
                        android:src="@drawable/ic_shield"
                        android:tint="@color/v_accent"
                        android:background="@drawable/bg_accent_soft_circle" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">
                        <TextView
                            android:id="@+id/item_device_signing_key_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Device Signing Key"
                            android:textColor="@color/v_text_primary"
                            android:textSize="15sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false" />
                        <TextView
                            android:id="@+id/item_device_signing_key_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Local key configured"
                            android:textColor="@color/v_accent"
                            android:textSize="12sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/item_device_signing_key_chevron"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&gt;"
                        android:textColor="@color/v_text_muted"
                        android:textSize="18sp"
                        android:fontFamily="sans"
                        android:includeFontPadding="false"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
                <TextView
                    android:id="@+id/label_danger_zone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DANGER ZONE"
                    android:textColor="@color/v_danger"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="sans"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.08"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="12dp" />
                <LinearLayout
                    android:id="@+id/item_wipe_user_data"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_amber_soft_24"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/wipe_user_data_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Wipe User Data"
                            android:textColor="@color/v_amber"
                            android:textSize="15sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:layout_marginBottom="8dp" />
                        <TextView
                            android:id="@+id/wipe_user_data_description"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Deletes encrypted user data blobs and runs. Keeps account ID, device identity, storage funds, and app settings."
                            android:textColor="#99F59E0B"
                            android:textSize="12sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:lineSpacingExtra="3dp" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/wipe_user_data_icon"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:gravity="center"
                        android:text="WI"
                        android:textColor="@color/v_amber"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="sans"
                        android:includeFontPadding="false"
                        android:background="@drawable/bg_amber_soft_12" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/item_delete_identity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_red_card_24"
                    android:padding="16dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/delete_identity_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Delete Identity"
                            android:textColor="@color/v_danger"
                            android:textSize="15sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:layout_marginBottom="8dp" />
                        <TextView
                            android:id="@+id/delete_identity_description"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Permanently deletes user data, identity, encryption keys, linked state, and unsaved Sia credits."
                            android:textColor="#99EF4444"
                            android:textSize="12sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:lineSpacingExtra="3dp" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/delete_identity_icon"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:gravity="center"
                        android:text="TR"
                        android:textColor="@color/v_danger"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="sans"
                        android:includeFontPadding="false"
                        android:background="@drawable/bg_red_soft_12" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
