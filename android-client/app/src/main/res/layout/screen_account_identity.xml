<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/accountIdentityRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/v_bg">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/top_app_bar"
            android:layout_width="match_parent"
            android:layout_height="112dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="48dp"
            android:paddingBottom="16dp">
            <ImageButton
                android:id="@+id/button_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_surface_circle"
                android:contentDescription="@string/controls_back"
                android:padding="13dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/v_text_primary" />
            <TextView
                android:id="@+id/text_title"
                style="@style/VirtroidText.NavTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/account_identity_title" />
            <Space
                android:layout_width="44dp"
                android:layout_height="44dp" />
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/v_border" />
        <ScrollView
            android:id="@+id/account_identity_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="false"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/account_identity_scroll_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="64dp">
                <LinearLayout
                    android:id="@+id/item_account_id"
                    android:layout_marginTop="24dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_card"
                    android:foreground="?attr/selectableItemBackground"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">
                    <ImageView
                        android:id="@+id/item_account_id_icon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:padding="13dp"
                        android:src="@drawable/ic_account"
                        app:tint="@color/v_accent"
                        android:background="@drawable/bg_accent_soft_circle" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">
                        <TextView
                            android:id="@+id/item_account_id_title"
                            style="@style/VirtroidText.CardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Account ID" />
                        <TextView
                            android:id="@+id/item_account_id_subtitle"
                            style="@style/VirtroidText.Body.Compact"
                            android:ellipsize="middle"
                            android:maxLines="1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/account_missing"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                    <ImageButton
                        android:id="@+id/item_account_id_copy"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="-9dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/copy_to_clipboard"
                        android:padding="12dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_copy"
                        app:tint="@color/v_text_muted" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/item_device_fingerprint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_card"
                    android:foreground="?attr/selectableItemBackground"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">
                    <ImageView
                        android:id="@+id/item_device_fingerprint_icon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:padding="13dp"
                        android:src="@drawable/ic_mobile"
                        app:tint="@color/v_accent"
                        android:background="@drawable/bg_accent_soft_circle" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">
                        <TextView
                            android:id="@+id/item_device_fingerprint_title"
                            style="@style/VirtroidText.CardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Device ID" />
                        <TextView
                            android:id="@+id/item_device_fingerprint_subtitle"
                            style="@style/VirtroidText.Body.Compact"
                            android:ellipsize="middle"
                            android:maxLines="1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/device_missing"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                    <ImageButton
                        android:id="@+id/item_device_fingerprint_copy"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="-9dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/copy_to_clipboard"
                        android:padding="12dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_copy"
                        app:tint="@color/v_text_muted" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/identity_sync_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="16dp"
                    android:layout_marginBottom="36dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/identity_encryption_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Encryption"
                            android:textColor="@color/v_text_muted"
                            android:textSize="13sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false" />
                        <TextView
                            android:id="@+id/identity_encryption_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="Local identity key"
                            android:textColor="@color/v_text_primary"
                            android:textSize="13sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginTop="14dp">
                        <TextView
                            android:id="@+id/identity_created_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Created"
                            android:textColor="@color/v_text_muted"
                            android:textSize="13sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false" />
                        <TextView
                            android:id="@+id/identity_created_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="@string/account_identity_not_linked"
                            android:textColor="@color/v_text_primary"
                            android:textSize="13sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginTop="14dp"
                        android:visibility="gone">
                        <TextView
                            android:id="@+id/identity_last_sync_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Last Sync"
                            android:textColor="@color/v_text_muted"
                            android:textSize="13sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false" />
                        <TextView
                            android:id="@+id/identity_last_sync_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="@string/account_storage_not_synced"
                            android:textColor="@color/v_text_primary"
                            android:textSize="13sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false" />
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:id="@+id/label_wallet"
                    style="@style/VirtroidText.SectionHeading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/account_wallet_label"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="12dp" />
                <LinearLayout
                    android:id="@+id/item_wallet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_card"
                    android:foreground="?attr/selectableItemBackground"
                    android:padding="16dp"
                    android:layout_marginBottom="36dp">
                    <ImageView
                        android:id="@+id/item_wallet_icon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:padding="13dp"
                        android:src="@drawable/ic_wallet"
                        android:importantForAccessibility="no"
                        app:tint="@color/v_accent"
                        android:background="@drawable/bg_accent_soft_circle" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">
                        <TextView
                            android:id="@+id/item_wallet_title"
                            style="@style/VirtroidText.CardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/account_wallet_title" />
                        <TextView
                            android:id="@+id/item_wallet_subtitle"
                            style="@style/VirtroidText.Body.Compact"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/account_wallet_subtitle"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                    <ImageView
                        android:id="@+id/item_wallet_chevron"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="8dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/v_text_muted" />
                </LinearLayout>
                <TextView
                    android:id="@+id/label_apps"
                    style="@style/VirtroidText.SectionHeading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="APPS"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="0dp"
                    android:layout_marginBottom="12dp" />
                <LinearLayout
                    android:id="@+id/item_install_apps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_card"
                    android:foreground="?attr/selectableItemBackground"
                    android:padding="16dp"
                    android:layout_marginBottom="36dp">
                    <ImageView
                        android:id="@+id/item_install_apps_icon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:padding="13dp"
                        android:src="@drawable/ic_download"
                        app:tint="@color/v_accent"
                        android:background="@drawable/bg_accent_soft_circle" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">
                        <TextView
                            android:id="@+id/item_install_apps_title"
                            style="@style/VirtroidText.CardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/account_apps_title" />
                        <TextView
                            android:id="@+id/item_install_apps_subtitle"
                            style="@style/VirtroidText.Body.Compact"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/account_apps_subtitle"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                    <ImageView
                        android:id="@+id/item_install_apps_chevron"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="8dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/v_text_muted" />
                </LinearLayout>
                <TextView
                    android:id="@+id/label_decentralized_storage"
                    style="@style/VirtroidText.SectionHeading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ENCRYPTED STORAGE"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="0dp"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone" />
                <LinearLayout
                    android:id="@+id/storage_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_surface_stroke_32"
                    android:padding="20dp"
                    android:layout_marginBottom="36dp"
                    android:visibility="gone">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="20dp">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">
                                <TextView
                                    android:id="@+id/storage_usage_value"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="--"
                                    android:textColor="@color/v_text_primary"
                                    android:textSize="38sp"
                                    android:textStyle="bold"
                                    android:fontFamily="sans"
                                    android:includeFontPadding="false" />
                                <TextView
                                    android:id="@+id/storage_usage_unit"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="bottom"
                                    android:text=""
                                    android:textColor="@color/v_text_muted"
                                    android:textSize="24sp"
                                    android:fontFamily="sans"
                                    android:includeFontPadding="false" />
                            </LinearLayout>
                            <TextView
                                android:id="@+id/storage_usage_subtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/account_storage_usage_unreported"
                                android:textColor="@color/v_text_muted"
                                android:textSize="13sp"
                                android:fontFamily="sans"
                                android:includeFontPadding="false"
                                android:layout_marginTop="6dp" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/storage_ready_chip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="@string/account_storage_unavailable"
                                android:textColor="@color/v_accent"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:fontFamily="sans"
                                android:includeFontPadding="false"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:paddingTop="5dp"
                                android:paddingBottom="5dp"
                                android:layout_marginBottom="8dp"
                                android:background="@drawable/bg_accent_soft_12" />
                            <TextView
                                android:id="@+id/storage_snapshots"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="end"
                                android:text="@string/account_storage_snapshots_unreported"
                                android:textColor="@color/v_text_muted"
                                android:textSize="11sp"
                                android:fontFamily="sans"
                                android:includeFontPadding="false" />
                        </LinearLayout>
                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/v_border"
                        android:layout_marginBottom="16dp" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">
                        <LinearLayout
                            android:id="@+id/storage_backend"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:background="@drawable/bg_surface_light_24"
                            android:padding="14dp"
                            android:layout_marginEnd="10dp">
                            <TextView
                                android:id="@+id/storage_backend_icon"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:gravity="center"
                                android:text="--"
                                android:textColor="@color/v_text_primary"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:fontFamily="sans"
                                android:includeFontPadding="false"
                                android:layout_marginBottom="16dp"
                                android:background="@drawable/bg_surface_light_circle" />
                            <TextView
                                android:id="@+id/storage_backend_label"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="BACKEND"
                                android:textColor="@color/v_text_muted"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:fontFamily="sans"
                                android:includeFontPadding="false"
                                android:letterSpacing="0.08"
                                android:layout_marginBottom="4dp" />
                            <TextView
                                android:id="@+id/storage_backend_value"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="@string/account_storage_backend_local"
                                android:textColor="@color/v_text_primary"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:fontFamily="sans"
                                android:includeFontPadding="false" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/storage_credit"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:background="@drawable/bg_surface_light_24"
                            android:padding="14dp"
                            android:layout_marginEnd="10dp">
                            <TextView
                                android:id="@+id/storage_credit_icon"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:gravity="center"
                                android:text="OP"
                                android:textColor="@color/v_accent"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:fontFamily="sans"
                                android:includeFontPadding="false"
                                android:layout_marginBottom="16dp"
                                android:background="@drawable/bg_accent_soft_circle" />
                            <TextView
                                android:id="@+id/storage_credit_label"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="MODE"
                                android:textColor="@color/v_text_muted"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:fontFamily="sans"
                                android:includeFontPadding="false"
                                android:letterSpacing="0.08"
                                android:layout_marginBottom="4dp" />
                            <TextView
                                android:id="@+id/storage_credit_value"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="--"
                                android:textColor="@color/v_text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:fontFamily="sans"
                                android:includeFontPadding="false" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/storage_runway"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:background="@drawable/bg_surface_light_24"
                            android:padding="14dp">
                            <TextView
                                android:id="@+id/storage_runway_icon"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:gravity="center"
                                android:text="--"
                                android:textColor="@color/v_text_primary"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:fontFamily="sans"
                                android:includeFontPadding="false"
                                android:layout_marginBottom="16dp"
                                android:background="@drawable/bg_surface_light_circle" />
                            <TextView
                                android:id="@+id/storage_runway_label"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="RUNWAY"
                                android:textColor="@color/v_text_muted"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:fontFamily="sans"
                                android:includeFontPadding="false"
                                android:letterSpacing="0.08"
                                android:layout_marginBottom="4dp" />
                            <TextView
                                android:id="@+id/storage_runway_value"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="@string/account_storage_runway_unreported"
                                android:textColor="@color/v_text_primary"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:fontFamily="sans"
                                android:includeFontPadding="false" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:id="@+id/label_security"
                    style="@style/VirtroidText.SectionHeading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SECURITY"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="0dp"
                    android:layout_marginBottom="12dp" />
                <LinearLayout
                    android:id="@+id/item_identity_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_card"
                    android:foreground="?attr/selectableItemBackground"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">
                    <ImageView
                        android:id="@+id/item_identity_password_icon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:padding="13dp"
                        android:src="@drawable/ic_lock"
                        app:tint="@color/v_accent"
                        android:background="@drawable/bg_accent_soft_circle" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">
                        <TextView
                            android:id="@+id/item_identity_password_title"
                            style="@style/VirtroidText.CardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/account_identity_password_title" />
                        <TextView
                            android:id="@+id/item_identity_password_subtitle"
                            style="@style/VirtroidText.Body.Compact"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/account_identity_encryption_missing"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                    <ImageView
                        android:id="@+id/item_identity_password_chevron"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="8dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/v_text_muted" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/item_device_signing_key"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_card"
                    android:foreground="?attr/selectableItemBackground"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">
                    <ImageView
                        android:id="@+id/item_device_signing_key_icon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:padding="13dp"
                        android:src="@drawable/ic_key"
                        app:tint="@color/v_accent"
                        android:background="@drawable/bg_accent_soft_circle" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">
                        <TextView
                            android:id="@+id/item_device_signing_key_title"
                            style="@style/VirtroidText.CardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Device Signing Key" />
                        <TextView
                            android:id="@+id/item_device_signing_key_subtitle"
                            style="@style/VirtroidText.Body.Compact"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/account_identity_verified"
                            android:textColor="@color/v_accent"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                    <ImageButton
                        android:id="@+id/item_device_signing_key_copy"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="-9dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/copy_to_clipboard"
                        android:padding="12dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_copy"
                        app:tint="@color/v_text_muted" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/item_linked_devices"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_card"
                    android:foreground="?attr/selectableItemBackground"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">
                    <ImageView
                        android:id="@+id/item_linked_devices_icon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:padding="13dp"
                        android:src="@drawable/ic_devices"
                        app:tint="@color/v_accent"
                        android:background="@drawable/bg_accent_soft_circle" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">
                        <TextView
                            android:id="@+id/item_linked_devices_title"
                            style="@style/VirtroidText.CardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/account_linked_devices_title" />
                        <TextView
                            android:id="@+id/item_linked_devices_subtitle"
                            style="@style/VirtroidText.Body.Compact"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/account_linked_devices_subtitle"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                    <ImageView
                        android:id="@+id/item_linked_devices_chevron"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="8dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/v_text_muted" />
                </LinearLayout>
                <TextView
                    android:id="@+id/label_danger_zone"
                    style="@style/VirtroidText.SectionHeading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DANGER ZONE"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="12dp" />
                <LinearLayout
                    android:id="@+id/item_wipe_user_data"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_amber_soft_24"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/wipe_user_data_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/account_wipe_local_title"
                            android:textColor="@color/v_amber"
                            android:textSize="15sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:layout_marginBottom="8dp" />
                        <TextView
                            android:id="@+id/wipe_user_data_description"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/account_wipe_local_body"
                            android:textColor="@color/v_amber_muted"
                            android:textSize="12sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:lineSpacingExtra="3dp" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/item_delete_identity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_red_card_24"
                    android:padding="16dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/delete_identity_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/account_delete_local_identity_title"
                            android:textColor="@color/v_danger"
                            android:textSize="15sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:layout_marginBottom="8dp" />
                        <TextView
                            android:id="@+id/delete_identity_description"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/account_delete_local_identity_body"
                            android:textColor="@color/v_danger_muted"
                            android:textSize="12sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:lineSpacingExtra="3dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
