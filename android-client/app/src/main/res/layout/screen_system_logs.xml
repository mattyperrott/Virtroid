<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/systemLogsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/v_bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/systemLogsHeader"
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="48dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp">

        <ImageButton
            android:id="@+id/systemLogsBackButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_surface_circle"
            android:contentDescription="@string/controls_back"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/v_text_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                style="@style/VirtroidText.NavTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/system_logs_title" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:id="@+id/liveCaptureDot"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_dot_amber" />

                <TextView
                    android:id="@+id/liveCaptureText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans"
                    android:includeFontPadding="false"
                    android:text="@string/system_logs_capturing_live"
                    android:textColor="@color/v_text_muted"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/clearLogViewerButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_transparent"
            android:contentDescription="@string/system_logs_clear_viewer"
            android:padding="12dp"
            android:src="@drawable/ic_delete"
            app:tint="@color/v_text_primary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/v_border" />

    <LinearLayout
        android:id="@+id/systemLogsFilters"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:id="@+id/filterAllButton"
            style="@style/VirtroidFilterChip"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:text="@string/system_logs_filter_all"
            android:textColor="@color/v_text_primary" />

        <TextView
            android:id="@+id/filterErrorsButton"
            style="@style/VirtroidFilterChip"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_red_soft_24"
            android:text="@string/system_logs_filter_errors"
            android:textColor="@color/v_danger" />

        <TextView
            android:id="@+id/filterWarnButton"
            style="@style/VirtroidFilterChip"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_amber_soft_24"
            android:text="@string/system_logs_filter_warn"
            android:textColor="@color/v_amber" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/logPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="24dp"
        android:layout_weight="1"
        android:background="@drawable/bg_log_panel"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_log_header"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/ic_terminal"
                app:tint="@color/v_text_muted" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:text="@string/system_logs_path"
                android:textAllCaps="true"
                android:textColor="@color/v_text_muted"
                android:textSize="11sp" />

            <ImageButton
                android:id="@+id/copyLogsButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_transparent"
                android:contentDescription="@string/system_logs_copy"
                android:padding="11dp"
                android:src="@drawable/ic_copy"
                app:tint="@color/v_text_muted" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/logScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="22dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/logListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>
</LinearLayout>
