<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/controlsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/v_bg">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/top_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="12dp">
            <ImageButton
                android:id="@+id/controlsBackButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_surface_circle"
                android:contentDescription="@string/controls_back"
                android:padding="13dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/v_text_primary" />
            <TextView
                android:id="@+id/text_nav_title"
                style="@style/VirtroidText.NavTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Controls" />
            <ImageButton
                android:id="@+id/controlsConnectButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_surface_circle"
                android:contentDescription="@string/controls_connect"
                android:padding="13dp"
                android:src="@drawable/ic_hexagon"
                app:tint="@color/v_text_primary" />
        </LinearLayout>
        <ScrollView
            android:id="@+id/controls_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="false"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/controls_scroll_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="48dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="32dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/controlsRuntimeNameText"
                            style="@style/VirtroidText.ContentHeading"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/session_title_fallback"
                            android:textColor="@color/v_text_secondary" />
                        <TextView
                            android:id="@+id/controlsRuntimeSubtitleText"
                            style="@style/VirtroidText.Status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/runtime_missing_for_session"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>
                    <ImageButton
                        android:id="@+id/button_edit_runtime"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_surface_light_circle"
                        android:contentDescription="@string/controls_edit_runtime"
                        android:padding="11dp"
                        android:src="@drawable/ic_tune"
                        app:tint="@color/v_text_muted" />
                </LinearLayout>
                <HorizontalScrollView
                    android:id="@+id/stats_scroller"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never"
                    android:scrollbars="none"
                    android:layout_marginBottom="36dp">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:id="@+id/stat_state"
                            android:layout_width="110dp"
                            android:layout_height="130dp"
                            android:orientation="vertical"
                            android:background="@drawable/bg_surface2_24"
                            android:padding="16dp"
                            android:layout_marginEnd="12dp">
                            <ImageView
                                android:id="@+id/stat_state_icon"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:padding="10dp"
                                android:src="@drawable/ic_terminal"
                                app:tint="@color/v_accent"
                                android:layout_marginBottom="18dp"
                                android:background="@drawable/bg_surface_light_circle" />
                            <TextView
                                android:id="@+id/stat_state_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="STATE"
                                android:textColor="@color/v_text_muted"
                                android:textSize="11sp"
                                android:fontFamily="sans"
                                android:includeFontPadding="false"
                                android:letterSpacing="0.08"
                                android:layout_marginBottom="6dp" />
                            <TextView
                                android:id="@+id/controlsStateValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Running"
                                android:textColor="@color/v_text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:fontFamily="sans"
                                android:includeFontPadding="false" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/stat_tunnel"
                            android:layout_width="110dp"
                            android:layout_height="130dp"
                            android:orientation="vertical"
                            android:background="@drawable/bg_surface2_24"
                            android:padding="16dp"
                            android:layout_marginEnd="12dp">
                            <ImageView
                                android:id="@+id/stat_tunnel_icon"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:padding="10dp"
                                android:src="@drawable/ic_shield"
                                app:tint="@color/v_blue"
                                android:layout_marginBottom="18dp"
                                android:background="@drawable/bg_surface_light_circle" />
                            <TextView
                                android:id="@+id/stat_tunnel_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="TUNNEL"
                                android:textColor="@color/v_text_muted"
                                android:textSize="11sp"
                                android:fontFamily="sans"
                                android:includeFontPadding="false"
                                android:letterSpacing="0.08"
                                android:layout_marginBottom="6dp" />
                            <TextView
                                android:id="@+id/controlsTunnelValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-"
                                android:textColor="@color/v_text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:fontFamily="sans"
                                android:includeFontPadding="false" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/stat_storage"
                            android:layout_width="110dp"
                            android:layout_height="130dp"
                            android:orientation="vertical"
                            android:background="@drawable/bg_surface2_24"
                            android:padding="16dp"
                            android:layout_marginEnd="12dp">
                            <ImageView
                                android:id="@+id/stat_storage_icon"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:padding="10dp"
                                android:src="@drawable/ic_storage"
                                app:tint="@color/v_amber"
                                android:layout_marginBottom="18dp"
                                android:background="@drawable/bg_surface_light_circle" />
                            <TextView
                                android:id="@+id/stat_storage_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="STORAGE"
                                android:textColor="@color/v_text_muted"
                                android:textSize="11sp"
                                android:fontFamily="sans"
                                android:includeFontPadding="false"
                                android:letterSpacing="0.08"
                                android:layout_marginBottom="6dp" />
                            <TextView
                                android:id="@+id/controlsStorageValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-"
                                android:textColor="@color/v_text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:fontFamily="sans"
                                android:includeFontPadding="false" />
                        </LinearLayout>
                    </LinearLayout>
                </HorizontalScrollView>
                <TextView
                    android:id="@+id/label_session_parameters"
                    style="@style/VirtroidText.SectionHeading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SESSION PARAMETERS"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="0dp"
                    android:layout_marginBottom="12dp" />
                <LinearLayout
                    android:id="@+id/buildInfoRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_surface_24"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">
                    <ImageView
                        android:id="@+id/item_build_info_icon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:padding="13dp"
                        android:src="@drawable/ic_phone"
                        app:tint="@color/v_text_primary"
                        android:background="@drawable/bg_surface_light_circle" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">
                        <TextView
                            android:id="@+id/item_build_info_title"
                            style="@style/VirtroidText.CardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Build &amp; Runtime" />
                        <TextView
                            android:id="@+id/controlsBuildBodyText"
                            style="@style/VirtroidText.Body.Compact"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Runtime details"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/displayOutputRow"
                    android:contentDescription="@string/controls_display_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_surface_24"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">
                    <ImageView
                        android:id="@+id/item_display_output_icon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:padding="13dp"
                        android:src="@drawable/ic_session_menu"
                        app:tint="@color/v_text_primary"
                        android:background="@drawable/bg_surface_light_circle" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">
                        <TextView
                            android:id="@+id/item_display_output_title"
                            style="@style/VirtroidText.CardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Display &amp; Output" />
                        <TextView
                            android:id="@+id/controlsDisplayBodyText"
                            style="@style/VirtroidText.Body.Compact"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Native aspect, adaptive 15-30fps"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/item_display_output_chevron"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&gt;"
                        android:textColor="@color/v_text_muted"
                        android:textSize="18sp"
                        android:fontFamily="sans"
                        android:includeFontPadding="false"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/cameraPassthroughRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_surface_24"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">
                    <ImageView
                        android:id="@+id/item_camera_passthrough_icon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:padding="13dp"
                        android:src="@drawable/ic_camera"
                        app:tint="@color/v_text_primary"
                        android:background="@drawable/bg_surface_light_circle" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">
                        <TextView
                            android:id="@+id/item_camera_passthrough_title"
                            style="@style/VirtroidText.CardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Physical Camera Photo Import" />
                        <TextView
                            android:id="@+id/item_camera_passthrough_subtitle"
                            style="@style/VirtroidText.Body.Compact"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Inject local camera to cloud"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                    <FrameLayout
                        android:id="@+id/cameraPassthroughSwitch"
                        android:contentDescription="@string/new_runtime_camera_passthrough"
                        android:layout_width="52dp"
                        android:layout_height="30dp"
                        android:background="@drawable/bg_switch_track_on"
                        android:clickable="false"
                        android:focusable="false">

                        <View
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="end|center_vertical"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/bg_switch_thumb_dark" />
                    </FrameLayout>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/consoleLogsRow"
                    android:contentDescription="@string/controls_logs_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_surface_24"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">
                    <ImageView
                        android:id="@+id/item_console_logs_icon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:padding="13dp"
                        android:src="@drawable/ic_terminal"
                        app:tint="@color/v_text_primary"
                        android:background="@drawable/bg_surface_light_circle" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">
                        <TextView
                            android:id="@+id/item_console_logs_title"
                            style="@style/VirtroidText.CardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Console Logs" />
                        <TextView
                            android:id="@+id/item_console_logs_subtitle"
                            style="@style/VirtroidText.Body.Compact"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Boot &amp; network events"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/item_console_logs_chevron"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&gt;"
                        android:textColor="@color/v_text_muted"
                        android:textSize="18sp"
                        android:fontFamily="sans"
                        android:includeFontPadding="false"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
                <TextView
                    android:id="@+id/controlsLogsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_storage_input"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:padding="16dp"
                    android:textColor="@color/v_text_muted"
                    android:textSize="12sp"
                    android:visibility="gone" />
                <LinearLayout
                    android:id="@+id/restartPersonaRow"
                    android:contentDescription="@string/controls_restart_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_accent_soft_24"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">
                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:padding="13dp"
                        android:src="@drawable/ic_refresh"
                        app:tint="@color/v_accent"
                        android:background="@drawable/bg_accent_soft_12" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">
                        <TextView
                            style="@style/VirtroidText.CardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/controls_restart_title"
                            android:textColor="@color/v_accent" />
                        <TextView
                            style="@style/VirtroidText.Body.Compact"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/controls_restart_body"
                            android:textColor="@color/v_text_muted"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&gt;"
                        android:textColor="@color/v_accent"
                        android:textSize="18sp"
                        android:fontFamily="sans"
                        android:includeFontPadding="false"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/wipeRow"
                    android:contentDescription="@string/controls_wipe_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_amber_soft_24"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">
                    <ImageView
                        android:id="@+id/item_wipe_destroy_icon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:padding="13dp"
                        android:src="@drawable/ic_warning"
                        app:tint="@color/v_amber"
                        android:background="@drawable/bg_amber_soft_12" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">
                        <TextView
                            android:id="@+id/item_wipe_destroy_title"
                            style="@style/VirtroidText.CardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/controls_wipe_title"
                            android:textColor="@color/v_amber" />
                        <TextView
                            android:id="@+id/item_wipe_destroy_subtitle"
                            style="@style/VirtroidText.Body.Compact"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/controls_wipe_body"
                            android:textColor="@color/v_amber_muted"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/item_wipe_destroy_chevron"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&gt;"
                        android:textColor="@color/v_amber_muted"
                        android:textSize="18sp"
                        android:fontFamily="sans"
                        android:includeFontPadding="false"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/destroyRow"
                    android:contentDescription="@string/controls_destroy_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_red_card_24"
                    android:padding="16dp"
                    android:layout_marginBottom="0dp">
                    <ImageView
                        android:id="@+id/item_destroy_icon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:padding="13dp"
                        android:src="@drawable/ic_delete"
                        app:tint="@color/v_danger"
                        android:background="@drawable/bg_red_soft_12" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">
                        <TextView
                            android:id="@+id/item_destroy_title"
                            style="@style/VirtroidText.CardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/controls_destroy_title"
                            android:textColor="@color/v_danger" />
                        <TextView
                            android:id="@+id/item_destroy_subtitle"
                            style="@style/VirtroidText.Body.Compact"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/controls_destroy_body"
                            android:textColor="@color/v_danger_muted"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/item_destroy_chevron"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&gt;"
                        android:textColor="@color/v_danger_dim"
                        android:textSize="18sp"
                        android:fontFamily="sans"
                        android:includeFontPadding="false"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
