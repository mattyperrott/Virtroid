<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/controlsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/v_bg">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/status_bar"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="bottom|center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="8dp">
            <TextView
                android:id="@+id/text_status_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="09:41"
                android:textColor="@color/v_text_primary"
                android:textSize="14sp"
                android:fontFamily="sans"
                android:includeFontPadding="false" />
            <LinearLayout
                android:id="@+id/text_status_icons"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="7dp"
                    android:src="@drawable/ic_status_wifi" />
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="7dp"
                    android:src="@drawable/ic_status_signal" />
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_status_battery" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/top_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="12dp">
            <ImageButton
                android:id="@+id/controlsBackButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_surface_circle"
                android:contentDescription="@string/controls_back"
                android:padding="13dp"
                android:src="@drawable/ic_arrow_back"
                android:tint="@color/v_text_primary" />
            <TextView
                android:id="@+id/text_nav_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Controls"
                android:textColor="@color/v_text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="sans"
                android:includeFontPadding="false" />
            <ImageButton
                android:id="@+id/controlsConnectButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_surface_circle"
                android:contentDescription="@string/controls_connect"
                android:padding="13dp"
                android:src="@drawable/ic_hexagon"
                android:tint="@color/v_text_primary" />
        </LinearLayout>
        <ScrollView
            android:id="@+id/controls_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="false"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/controls_scroll_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="48dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="32dp">
                    <ImageView
                        android:id="@+id/icon_runtime_identity"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:padding="18dp"
                        android:src="@drawable/ic_fingerprint"
                        android:tint="@color/v_accent"
                        android:background="@drawable/bg_accent_soft_circle" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">
                        <TextView
                            android:id="@+id/controlsRuntimeNameText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Primary Nexus"
                            android:textColor="@color/v_text_secondary"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:fontFamily="sans"
                            android:includeFontPadding="false" />
                        <TextView
                            android:id="@+id/controlsRuntimeSubtitleText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ID: 84423ced4-af49-4dc2v-9d97f"
                            android:textColor="@color/v_text_muted"
                            android:textSize="13sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>
                    <ImageButton
                        android:id="@+id/button_edit_runtime"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_surface_light_circle"
                        android:contentDescription="@string/runtime_controls"
                        android:padding="11dp"
                        android:src="@drawable/ic_tune"
                        android:tint="@color/v_text_muted" />
                </LinearLayout>
                <HorizontalScrollView
                    android:id="@+id/stats_scroller"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never"
                    android:scrollbars="none"
                    android:layout_marginBottom="36dp">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:id="@+id/stat_state"
                            android:layout_width="110dp"
                            android:layout_height="130dp"
                            android:orientation="vertical"
                            android:background="@drawable/bg_surface2_24"
                            android:padding="16dp"
                            android:layout_marginEnd="12dp">
                            <ImageView
                                android:id="@+id/stat_state_icon"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:padding="10dp"
                                android:src="@drawable/ic_terminal"
                                android:tint="@color/v_accent"
                                android:layout_marginBottom="18dp"
                                android:background="@drawable/bg_surface_light_circle" />
                            <TextView
                                android:id="@+id/stat_state_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="STATE"
                                android:textColor="@color/v_text_muted"
                                android:textSize="11sp"
                                android:fontFamily="sans"
                                android:includeFontPadding="false"
                                android:letterSpacing="0.08"
                                android:layout_marginBottom="6dp" />
                            <TextView
                                android:id="@+id/controlsStateValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Running"
                                android:textColor="@color/v_text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:fontFamily="sans"
                                android:includeFontPadding="false" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/stat_tunnel"
                            android:layout_width="110dp"
                            android:layout_height="130dp"
                            android:orientation="vertical"
                            android:background="@drawable/bg_surface2_24"
                            android:padding="16dp"
                            android:layout_marginEnd="12dp">
                            <ImageView
                                android:id="@+id/stat_tunnel_icon"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:padding="10dp"
                                android:src="@drawable/ic_shield"
                                android:tint="@color/v_blue"
                                android:layout_marginBottom="18dp"
                                android:background="@drawable/bg_surface_light_circle" />
                            <TextView
                                android:id="@+id/stat_tunnel_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="TUNNEL"
                                android:textColor="@color/v_text_muted"
                                android:textSize="11sp"
                                android:fontFamily="sans"
                                android:includeFontPadding="false"
                                android:letterSpacing="0.08"
                                android:layout_marginBottom="6dp" />
                            <TextView
                                android:id="@+id/controlsTunnelValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Relay"
                                android:textColor="@color/v_text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:fontFamily="sans"
                                android:includeFontPadding="false" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/stat_storage"
                            android:layout_width="110dp"
                            android:layout_height="130dp"
                            android:orientation="vertical"
                            android:background="@drawable/bg_surface2_24"
                            android:padding="16dp"
                            android:layout_marginEnd="12dp">
                            <ImageView
                                android:id="@+id/stat_storage_icon"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:padding="10dp"
                                android:src="@drawable/ic_storage"
                                android:tint="@color/v_amber"
                                android:layout_marginBottom="18dp"
                                android:background="@drawable/bg_surface_light_circle" />
                            <TextView
                                android:id="@+id/stat_storage_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="STORAGE"
                                android:textColor="@color/v_text_muted"
                                android:textSize="11sp"
                                android:fontFamily="sans"
                                android:includeFontPadding="false"
                                android:letterSpacing="0.08"
                                android:layout_marginBottom="6dp" />
                            <TextView
                                android:id="@+id/controlsStorageValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Volatile"
                                android:textColor="@color/v_text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:fontFamily="sans"
                                android:includeFontPadding="false" />
                        </LinearLayout>
                    </LinearLayout>
                </HorizontalScrollView>
                <TextView
                    android:id="@+id/label_session_parameters"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SESSION PARAMETERS"
                    android:textColor="@color/v_text_muted"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="sans"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.08"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="0dp"
                    android:layout_marginBottom="12dp" />
                <LinearLayout
                    android:id="@+id/buildInfoRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_surface_24"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone">
                    <ImageView
                        android:id="@+id/item_build_info_icon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:padding="13dp"
                        android:src="@drawable/ic_phone"
                        android:tint="@color/v_text_primary"
                        android:background="@drawable/bg_surface_light_circle" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">
                        <TextView
                            android:id="@+id/item_build_info_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Build &amp; Runtime"
                            android:textColor="@color/v_text_primary"
                            android:textSize="15sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false" />
                        <TextView
                            android:id="@+id/controlsBuildBodyText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Runtime details"
                            android:textColor="@color/v_text_muted"
                            android:textSize="12sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/displayOutputRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_surface_24"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">
                    <ImageView
                        android:id="@+id/item_display_output_icon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:padding="13dp"
                        android:src="@drawable/ic_session_menu"
                        android:tint="@color/v_text_primary"
                        android:background="@drawable/bg_surface_light_circle" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">
                        <TextView
                            android:id="@+id/item_display_output_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Display &amp; Output"
                            android:textColor="@color/v_text_primary"
                            android:textSize="15sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false" />
                        <TextView
                            android:id="@+id/controlsDisplayBodyText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Native resolution, 60fps"
                            android:textColor="@color/v_text_muted"
                            android:textSize="12sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/item_display_output_chevron"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&gt;"
                        android:textColor="@color/v_text_muted"
                        android:textSize="18sp"
                        android:fontFamily="sans"
                        android:includeFontPadding="false"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/cameraPassthroughRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_surface_24"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">
                    <ImageView
                        android:id="@+id/item_camera_passthrough_icon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:padding="13dp"
                        android:src="@drawable/ic_camera"
                        android:tint="@color/v_text_primary"
                        android:background="@drawable/bg_surface_light_circle" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">
                        <TextView
                            android:id="@+id/item_camera_passthrough_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Camera Passthrough"
                            android:textColor="@color/v_text_primary"
                            android:textSize="15sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false" />
                        <TextView
                            android:id="@+id/item_camera_passthrough_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Inject local camera to cloud"
                            android:textColor="@color/v_text_muted"
                            android:textSize="12sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                    <Switch
                        android:id="@+id/cameraPassthroughSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:clickable="false"
                        android:focusable="false"
                        android:thumbTint="@color/v_bg"
                        android:trackTint="@color/v_accent" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/consoleLogsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_surface_24"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">
                    <ImageView
                        android:id="@+id/item_console_logs_icon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:padding="13dp"
                        android:src="@drawable/ic_terminal"
                        android:tint="@color/v_text_primary"
                        android:background="@drawable/bg_surface_light_circle" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">
                        <TextView
                            android:id="@+id/item_console_logs_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Console Logs"
                            android:textColor="@color/v_text_primary"
                            android:textSize="15sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false" />
                        <TextView
                            android:id="@+id/item_console_logs_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Boot &amp; network events"
                            android:textColor="@color/v_text_muted"
                            android:textSize="12sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/item_console_logs_chevron"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&gt;"
                        android:textColor="@color/v_text_muted"
                        android:textSize="18sp"
                        android:fontFamily="sans"
                        android:includeFontPadding="false"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
                <TextView
                    android:id="@+id/controlsLogsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_storage_input"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:padding="16dp"
                    android:textColor="@color/v_text_muted"
                    android:textSize="12sp"
                    android:visibility="gone" />
                <LinearLayout
                    android:id="@+id/wipeRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_red_card_24"
                    android:padding="16dp"
                    android:layout_marginBottom="0dp">
                    <ImageView
                        android:id="@+id/item_wipe_destroy_icon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:padding="13dp"
                        android:src="@drawable/ic_warning"
                        android:tint="@color/v_danger"
                        android:background="@drawable/bg_red_soft_12" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">
                        <TextView
                            android:id="@+id/item_wipe_destroy_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Wipe &amp; Destroy"
                            android:textColor="@color/v_danger"
                            android:textSize="15sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false" />
                        <TextView
                            android:id="@+id/item_wipe_destroy_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Irreversibly delete instance"
                            android:textColor="#99EF4444"
                            android:textSize="12sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/item_wipe_destroy_chevron"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&gt;"
                        android:textColor="#80EF4444"
                        android:textSize="18sp"
                        android:fontFamily="sans"
                        android:includeFontPadding="false"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/destroyRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_red_card_24"
                    android:padding="16dp"
                    android:layout_marginBottom="0dp"
                    android:visibility="gone">
                    <ImageView
                        android:id="@+id/item_destroy_icon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:padding="13dp"
                        android:src="@drawable/ic_delete"
                        android:tint="@color/v_danger"
                        android:background="@drawable/bg_red_soft_12" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">
                        <TextView
                            android:id="@+id/item_destroy_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Destroy Runtime"
                            android:textColor="@color/v_danger"
                            android:textSize="15sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false" />
                        <TextView
                            android:id="@+id/item_destroy_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Irreversibly delete this instance"
                            android:textColor="#99EF4444"
                            android:textSize="12sp"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/item_destroy_chevron"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&gt;"
                        android:textColor="#80EF4444"
                        android:textSize="18sp"
                        android:fontFamily="sans"
                        android:includeFontPadding="false"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
