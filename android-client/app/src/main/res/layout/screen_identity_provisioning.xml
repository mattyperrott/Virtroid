<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/onboardingRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/v_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="42dp" />

        <ScrollView
            android:id="@+id/identity_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="false"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/identity_scroll_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="90dp"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="186dp">

                <ImageView
                    android:id="@+id/icon_identity_shield"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/bg_accent_soft_12"
                    android:padding="12dp"
                    android:src="@drawable/ic_shield"
                    android:tint="@color/v_accent" />

                <TextView
                    android:id="@+id/text_title"
                    style="@style/VirtroidText.ScreenTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/onboarding_title" />

                <TextView
                    android:id="@+id/text_description"
                    style="@style/VirtroidText.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="30dp"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/onboarding_subtitle" />

                <LinearLayout
                    android:id="@+id/account_id_card"
                    android:layout_width="match_parent"
                    android:layout_height="86dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_surface_stroke_24"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/account_id_label"
                            style="@style/VirtroidText.Label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/onboarding_account_id" />

                        <FrameLayout
                            android:id="@+id/accountStatusIndicator"
                            style="@style/VirtroidStatusCheck">

                            <ImageView
                                android:id="@+id/accountStatusCheck"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/ic_check"
                                android:tint="@color/v_text_dim" />
                        </FrameLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/onboardingAccountIdText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:ellipsize="end"
                        android:fontFamily="monospace"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/onboarding_not_provisioned"
                        android:textColor="@color/v_text_primary"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/device_fingerprint_card"
                    android:layout_width="match_parent"
                    android:layout_height="86dp"
                    android:layout_marginBottom="28dp"
                    android:background="@drawable/bg_surface_stroke_24"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/device_fingerprint_label"
                            style="@style/VirtroidText.Label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/onboarding_device_fingerprint" />

                        <FrameLayout
                            android:id="@+id/deviceFingerprintStatusIndicator"
                            style="@style/VirtroidStatusCheck">

                            <ImageView
                                android:id="@+id/deviceFingerprintStatusCheck"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/ic_check"
                                android:tint="@color/v_text_dim" />
                        </FrameLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/onboardingDeviceIdText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:ellipsize="end"
                        android:fontFamily="monospace"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/onboarding_not_provisioned"
                        android:textColor="@color/v_text_primary"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/text_local_encryption_title"
                    style="@style/VirtroidText.ContentHeading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/onboarding_local_encryption" />

                <TextView
                    android:id="@+id/text_local_encryption_subtitle"
                    style="@style/VirtroidText.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="22dp"
                    android:text="@string/onboarding_local_encryption_body" />

                <LinearLayout
                    android:id="@+id/passphraseOptionCard"
                    android:layout_width="match_parent"
                    android:layout_height="116dp"
                    android:background="@drawable/bg_surface_stroke_24"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <ImageView
                        android:id="@+id/icon_passphrase_option"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:background="@drawable/bg_accent_soft_circle"
                        android:padding="14dp"
                        android:src="@drawable/ic_storage"
                        android:tint="@color/v_accent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/text_passphrase_title"
                            style="@style/VirtroidText.CardTitle.Large"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/onboarding_passphrase_title" />

                        <TextView
                            android:id="@+id/text_passphrase_subtitle"
                            style="@style/VirtroidText.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:lineSpacingExtra="3dp"
                            android:text="@string/onboarding_passphrase_body" />
                    </LinearLayout>

                    <View
                        android:id="@+id/passphraseOptionIndicator"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="@drawable/bg_dot_accent_outline" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottom_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:animateLayoutChanges="true"
        android:background="@color/v_bg"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:id="@+id/provisioningLogContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="34dp"
                android:layout_height="match_parent">

                <View
                    android:id="@+id/provisioningTimelineLine"
                    android:layout_width="2dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/bg_timeline_line" />

                <FrameLayout
                    android:id="@+id/previousMilestoneDot"
                    android:layout_width="@dimen/timeline_dot_size"
                    android:layout_height="@dimen/timeline_dot_size"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/bg_status_pill_success"
                    android:padding="3dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_check"
                        android:tint="@color/v_bg" />
                </FrameLayout>

                <View
                    android:id="@+id/activeMilestoneDot"
                    android:layout_width="@dimen/timeline_dot_size"
                    android:layout_height="@dimen/timeline_dot_size"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="38dp"
                    android:background="@drawable/bg_dot_accent_outline" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/previousMilestoneGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.62"
                    android:orientation="vertical"
                    android:paddingTop="1dp"
                    android:paddingBottom="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/previousMilestoneTitleText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:text="@string/provisioning_previous_waiting"
                            android:textColor="@color/v_text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/previousMilestoneStatusText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_chip_dark"
                            android:fontFamily="monospace"
                            android:includeFontPadding="false"
                            android:paddingStart="8dp"
                            android:paddingTop="3dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="3dp"
                            android:text="@string/provisioning_done"
                            android:textColor="@color/v_text_muted"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/previousMilestoneSubtitleText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:fontFamily="monospace"
                        android:includeFontPadding="false"
                        android:text="@string/provisioning_previous_descriptor"
                        android:textColor="@color/v_text_muted"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/activeMilestoneCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_provisioning_log_active"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="16dp">

                    <TextView
                        android:id="@+id/activeMilestoneTitleText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans"
                        android:includeFontPadding="false"
                        android:text="@string/provisioning_active_waiting"
                        android:textColor="@color/v_accent"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/activeMilestoneLogBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_provisioning_log_code"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="10dp">

                        <TextView
                            android:id="@+id/activeMilestoneCommandText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:includeFontPadding="false"
                            android:text="@string/provisioning_active_command"
                            android:textColor="@color/v_accent"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/activeMilestoneDetailText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:ellipsize="end"
                            android:fontFamily="monospace"
                            android:includeFontPadding="false"
                            android:maxLines="2"
                            android:text="@string/provisioning_active_detail"
                            android:textColor="@color/v_text_primary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/continueSetupButton"
            style="@style/VirtroidButton.Primary"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="@string/onboarding_create_identity" />
    </LinearLayout>
</FrameLayout>
