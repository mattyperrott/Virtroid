<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/unlockRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/v_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="34dp">

        <LinearLayout
            android:id="@+id/pin_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="98dp"
            android:paddingBottom="0dp">

            <ImageView
                android:id="@+id/icon_lock"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_surface_stroke_32"
                android:padding="18dp"
                android:src="@drawable/ic_lock"
                android:tint="@color/v_accent" />

            <TextView
                android:id="@+id/text_title"
                style="@style/VirtdroidText.ScreenTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Unlock Identity" />

            <TextView
                android:id="@+id/text_subtitle"
                style="@style/VirtdroidText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="Decrypting local state"
                android:textColor="@color/v_accent" />

            <LinearLayout
                android:id="@+id/pinDotsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="50dp"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:id="@+id/pinDot1"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_pin_dot_inactive" />

                <View
                    android:id="@+id/pinDot2"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_pin_dot_inactive" />

                <View
                    android:id="@+id/pinDot3"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_pin_dot_inactive" />

                <View
                    android:id="@+id/pinDot4"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_pin_dot_inactive" />

                <View
                    android:id="@+id/pinDot5"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_pin_dot_inactive" />

                <View
                    android:id="@+id/pinDot6"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:background="@drawable/bg_pin_dot_inactive" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/passphraseSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="42dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/passphraseInput"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:background="@drawable/bg_storage_input"
                android:hint="@string/unlock_enter_passphrase"
                android:inputType="textPassword"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textColor="@color/v_text_primary"
                android:textColorHint="@color/v_text_dim"
                android:textSize="16sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/unlockButton"
                style="@style/VirtdroidButton.Primary"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="14dp"
                android:text="@string/unlock_continue" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pinPad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="88dp"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:gravity="center"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/pinButton1"
                    style="@style/VirtdroidPinKey">
                    <TextView style="@style/VirtdroidPinDigit" android:text="1" />
                </FrameLayout>

                <Space android:layout_width="34dp" android:layout_height="1dp" />

                <FrameLayout
                    android:id="@+id/pinButton2"
                    style="@style/VirtdroidPinKey">
                    <TextView style="@style/VirtdroidPinDigit" android:text="2" />
                    <TextView style="@style/VirtdroidPinLetters" android:text="ABC" />
                </FrameLayout>

                <Space android:layout_width="34dp" android:layout_height="1dp" />

                <FrameLayout
                    android:id="@+id/pinButton3"
                    style="@style/VirtdroidPinKey">
                    <TextView style="@style/VirtdroidPinDigit" android:text="3" />
                    <TextView style="@style/VirtdroidPinLetters" android:text="DEF" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/pinButton4"
                    style="@style/VirtdroidPinKey">
                    <TextView style="@style/VirtdroidPinDigit" android:text="4" />
                    <TextView style="@style/VirtdroidPinLetters" android:text="GHI" />
                </FrameLayout>

                <Space android:layout_width="34dp" android:layout_height="1dp" />

                <FrameLayout
                    android:id="@+id/pinButton5"
                    style="@style/VirtdroidPinKey">
                    <TextView style="@style/VirtdroidPinDigit" android:text="5" />
                    <TextView style="@style/VirtdroidPinLetters" android:text="JKL" />
                </FrameLayout>

                <Space android:layout_width="34dp" android:layout_height="1dp" />

                <FrameLayout
                    android:id="@+id/pinButton6"
                    style="@style/VirtdroidPinKey">
                    <TextView style="@style/VirtdroidPinDigit" android:text="6" />
                    <TextView style="@style/VirtdroidPinLetters" android:text="MNO" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/pinButton7"
                    style="@style/VirtdroidPinKey">
                    <TextView style="@style/VirtdroidPinDigit" android:text="7" />
                    <TextView style="@style/VirtdroidPinLetters" android:text="PQRS" />
                </FrameLayout>

                <Space android:layout_width="34dp" android:layout_height="1dp" />

                <FrameLayout
                    android:id="@+id/pinButton8"
                    style="@style/VirtdroidPinKey">
                    <TextView style="@style/VirtdroidPinDigit" android:text="8" />
                    <TextView style="@style/VirtdroidPinLetters" android:text="TUV" />
                </FrameLayout>

                <Space android:layout_width="34dp" android:layout_height="1dp" />

                <FrameLayout
                    android:id="@+id/pinButton9"
                    style="@style/VirtdroidPinKey">
                    <TextView style="@style/VirtdroidPinDigit" android:text="9" />
                    <TextView style="@style/VirtdroidPinLetters" android:text="WXYZ" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/button_fingerprint"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/bg_transparent"
                    android:contentDescription="@string/onboarding_device_fingerprint"
                    android:padding="26dp"
                    android:src="@drawable/ic_fingerprint"
                    android:tint="@color/v_accent" />

                <Space android:layout_width="34dp" android:layout_height="1dp" />

                <FrameLayout
                    android:id="@+id/pinButton0"
                    style="@style/VirtdroidPinKey">
                    <TextView style="@style/VirtdroidPinDigit" android:text="0" />
                </FrameLayout>

                <Space android:layout_width="34dp" android:layout_height="1dp" />

                <ImageButton
                    android:id="@+id/pinDeleteButton"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/bg_transparent"
                    android:contentDescription="@string/runtime_delete"
                    android:padding="28dp"
                    android:src="@drawable/ic_backspace"
                    android:tint="@color/v_text_muted" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/switchUnlockModeText"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_transparent"
            android:fontFamily="sans"
            android:gravity="center"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/unlock_use_passphrase"
            android:textAllCaps="false"
            android:textColor="@color/v_text_dim"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
