<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sessionRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/v_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/sessionTopBar"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:background="@drawable/bg_viewer_top_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <ImageButton
                android:id="@+id/sessionDisconnectButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_red_soft_24"
                android:contentDescription="@string/session_disconnect"
                android:padding="11dp"
                android:src="@drawable/ic_power"
                android:tint="@color/v_danger" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/sessionTitleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="Primary Nexus"
                    android:textColor="@color/v_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/connection_dot"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_dot_accent" />

                    <TextView
                        android:id="@+id/sessionSubtitleText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="Secure • 24ms"
                        android:textColor="@color/v_accent"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <ImageButton
                android:id="@+id/sessionCameraButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_surface_24"
                android:contentDescription="@string/session_camera"
                android:padding="11dp"
                android:src="@drawable/ic_camera"
                android:tint="@color/v_text_primary" />

            <ImageButton
                android:id="@+id/sessionUploadButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_surface_24"
                android:contentDescription="@string/session_upload"
                android:padding="11dp"
                android:src="@drawable/ic_upload"
                android:tint="@color/v_text_primary" />

            <View
                android:id="@+id/sessionOptionalActionsDivider"
                android:layout_width="1dp"
                android:layout_height="28dp"
                android:layout_marginEnd="8dp"
                android:background="@color/v_border" />

            <ImageButton
                android:id="@+id/sessionControlsButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_accent_soft_circle"
                android:contentDescription="@string/session_controls"
                android:padding="11dp"
                android:src="@drawable/ic_tune"
                android:tint="@color/v_accent" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/sessionSurfaceContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/v_black">

            <TextureView
                android:id="@+id/sessionSurfaceView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center" />

            <LinearLayout
                android:id="@+id/sessionStreamStatusOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="32dp"
                android:paddingEnd="32dp">

                <ProgressBar
                    android:id="@+id/sessionStreamProgress"
                    style="?android:attr/progressBarStyle"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/v_accent" />

                <TextView
                    android:id="@+id/sessionStreamStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/session_stream_connecting"
                    android:textColor="@color/v_text_muted"
                    android:textSize="13sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <View
        android:id="@+id/host_home_indicator"
        android:layout_width="140dp"
        android:layout_height="6dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_home_indicator" />
</FrameLayout>
