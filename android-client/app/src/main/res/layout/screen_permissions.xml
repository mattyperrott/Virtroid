<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/permissionsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/v_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageButton
                android:id="@+id/permissionsBackButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_surface_circle"
                android:contentDescription="@string/controls_back"
                android:padding="12dp"
                android:src="@drawable/ic_arrow_back"
                android:visibility="gone"
                app:tint="@color/v_text_primary" />

            <TextView
                style="@style/VirtroidText.NavTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/permissions_title" />

            <Space
                android:id="@+id/permissionsBackSpacer"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:visibility="gone" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/v_border" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="190dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/bg_accent_soft_12"
                    android:padding="12dp"
                    android:src="@drawable/ic_shield"
                    app:tint="@color/v_accent" />

                <TextView
                    style="@style/VirtroidText.ScreenTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/permissions_heading" />

                <TextView
                    style="@style/VirtroidText.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="24dp"
                    android:text="@string/permissions_subtitle" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_settings_section"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="96dp"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_accent_soft_circle"
                            android:padding="10dp"
                            android:src="@drawable/ic_bell"
                            app:tint="@color/v_accent" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/VirtroidSettingsTitle"
                                android:text="@string/permissions_notifications_title" />

                            <TextView
                                style="@style/VirtroidSettingsSubtitle"
                                android:layout_marginTop="6dp"
                                android:text="@string/permissions_notifications_body" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/notificationPermissionButton"
                            style="@style/VirtroidButton.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:layout_marginStart="10dp"
                            android:minWidth="88dp"
                            android:text="@string/permissions_allow" />
                    </LinearLayout>

                    <View style="@style/VirtroidSettingsDivider" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="96dp"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_accent_soft_circle"
                            android:padding="10dp"
                            android:src="@drawable/ic_microphone"
                            app:tint="@color/v_accent" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/VirtroidSettingsTitle"
                                android:text="@string/permissions_microphone_title" />

                            <TextView
                                style="@style/VirtroidSettingsSubtitle"
                                android:layout_marginTop="6dp"
                                android:text="@string/permissions_microphone_body" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/microphonePermissionButton"
                            style="@style/VirtroidButton.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:layout_marginStart="10dp"
                            android:minWidth="88dp"
                            android:text="@string/permissions_allow" />
                    </LinearLayout>

                    <View style="@style/VirtroidSettingsDivider" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="96dp"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_accent_soft_circle"
                            android:padding="10dp"
                            android:src="@drawable/ic_camera"
                            app:tint="@color/v_accent" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/VirtroidSettingsTitle"
                                android:text="@string/permissions_camera_title" />

                            <TextView
                                style="@style/VirtroidSettingsSubtitle"
                                android:layout_marginTop="6dp"
                                android:text="@string/permissions_camera_body" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/cameraPermissionButton"
                            style="@style/VirtroidButton.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:layout_marginStart="10dp"
                            android:minWidth="88dp"
                            android:text="@string/permissions_allow" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    style="@style/VirtroidText.Body.Compact"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/permissions_privacy_note" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/openAndroidSettingsButton"
                    style="@style/VirtroidButton.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:text="@string/permissions_open_settings" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/v_bg"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/grantPermissionsButton"
            style="@style/VirtroidButton.Primary"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="@string/permissions_allow_remaining" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/continueWithoutPermissionsButton"
            style="@style/VirtroidButton.Secondary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:text="@string/permissions_not_now" />
    </LinearLayout>
</FrameLayout>
