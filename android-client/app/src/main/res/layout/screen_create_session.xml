<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/newRuntimeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/v_bg">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/top_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="12dp">
            <ImageButton
                android:id="@+id/newRuntimeCloseButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_surface_circle"
                android:contentDescription="@string/new_runtime_close"
                android:padding="13dp"
                android:src="@drawable/ic_close"
                app:tint="@color/v_text_primary" />
            <TextView
                android:id="@+id/text_nav_title"
                style="@style/VirtroidText.NavTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="New Runtime" />
            <View
                android:layout_width="44dp"
                android:layout_height="44dp" />
        </LinearLayout>
        <ScrollView
            android:id="@+id/create_session_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="false"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/create_session_scroll_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="160dp">
                <TextView
                    android:id="@+id/label_identity"
                    style="@style/VirtroidText.SectionHeading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IDENTITY"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp" />
                <LinearLayout
                    android:id="@+id/session_name_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_surface2_24"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:layout_marginBottom="32dp">
                    <EditText
                        android:id="@+id/sessionNameInput"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@android:color/transparent"
                        android:hint="Session Name (e.g. Work Alt)"
                        android:inputType="textCapWords"
                        android:textColor="@color/v_text_primary"
                        android:textColorHint="@color/v_text_dim"
                        android:textSize="17sp"
                        android:singleLine="true" />
                </LinearLayout>
                <TextView
                    android:id="@+id/label_threat_model"
                    style="@style/VirtroidText.SectionHeading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="THREAT MODEL"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="0dp"
                    android:layout_marginBottom="12dp" />
                <LinearLayout
                    android:id="@+id/option_standard_persistent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_surface_stroke_24"
                    android:padding="18dp"
                    android:layout_marginBottom="12dp">
                    <RadioButton
                        android:id="@+id/radio_standard"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/v_text_muted" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp">
                        <TextView
                            android:id="@+id/text_standard_title"
                            style="@style/VirtroidText.CardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Standard Persistent" />
                        <TextView
                            android:id="@+id/text_standard_subtitle"
                            style="@style/VirtroidText.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Data is saved between sessions. Acts like a normal second phone."
                            android:lineSpacingExtra="3dp"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/option_ephemeral"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_selected_card_24"
                    android:padding="18dp"
                    android:layout_marginBottom="32dp">
                    <RadioButton
                        android:id="@+id/radio_ephemeral"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:buttonTint="@color/v_accent" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <TextView
                                android:id="@+id/text_ephemeral_title"
                                style="@style/VirtroidText.CardTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Amnesic / Ephemeral"
                                android:textColor="@color/v_accent" />
                            <TextView
                                android:id="@+id/chip_recommended"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Recommended"
                                android:textColor="@color/v_accent"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:fontFamily="sans"
                                android:includeFontPadding="false"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:paddingTop="3dp"
                                android:paddingBottom="3dp"
                                android:background="@drawable/bg_accent_soft_12" />
                        </LinearLayout>
                        <TextView
                            android:id="@+id/text_ephemeral_subtitle"
                            style="@style/VirtroidText.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="RAM-only partition. Local session state is cleared on disconnect."
                            android:lineSpacingExtra="3dp"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/settings_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_surface2_24"
                    android:padding="2dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">
                        <TextView
                            android:id="@+id/switch_audio_passthrough_label"
                            style="@style/VirtroidText.CardTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Audio Passthrough" />
                        <Switch
                            android:id="@+id/audioPassthroughSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="false"
                            android:text="" />
                    </LinearLayout>
                    <View
                        android:id="@+id/divider_passthrough_toggles"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/v_border_soft"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">
                        <TextView
                            android:id="@+id/switch_camera_passthrough_label"
                            style="@style/VirtroidText.CardTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Camera Passthrough" />
                        <Switch
                            android:id="@+id/cameraPassthroughSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="false"
                            android:text="" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/bottom_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@color/v_bg"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="32dp">
        <LinearLayout
            android:id="@+id/provisionRuntimeLogContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_provisioning_log_active"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="16dp"
            android:paddingEnd="18dp"
            android:paddingBottom="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/provisionRuntimeTitleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans"
                android:includeFontPadding="false"
                android:text="@string/new_runtime_provision_title_request"
                android:textColor="@color/v_accent"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/provisionRuntimeProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:indeterminate="true"
                app:indicatorColor="@color/v_accent"
                app:trackColor="@color/v_border_soft" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_provisioning_log_code"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/provisionRuntimeCommandText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:text="@string/new_runtime_provision_command_request"
                    android:textColor="@color/v_accent"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/provisionRuntimeDetailText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:text="@string/new_runtime_provision_detail_request"
                    android:textColor="@color/v_text_primary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/provisionRuntimeEventTrailText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:ellipsize="end"
                    android:lineSpacingExtra="3dp"
                    android:maxLines="1"
                    android:textColor="@color/v_text_muted"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/newRuntimeEntitlementText"
            style="@style/VirtroidText.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:text="@string/entitlement_unavailable" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/provisionRuntimeButton"
            style="@style/VirtroidButton.Primary"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Provision Runtime" />
    </LinearLayout>
</FrameLayout>
