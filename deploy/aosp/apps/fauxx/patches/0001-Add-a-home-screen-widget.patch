diff --git a/app/src/main/res/drawable/widget_switch_thumb.xml b/app/src/main/res/drawable/widget_switch_thumb.xml
new file mode 100644
index 0000000..a6f8184
--- /dev/null
+++ b/app/src/main/res/drawable/widget_switch_thumb.xml
@@ -0,0 +1,28 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- The switch's thumb on Android 12+: 24dp on, 16dp off, as Material 3's. The switch stretches
+     its thumb to the track's height, so each circle keeps its own size in a 24dp-wide layer. -->
+<selector xmlns:android="http://schemas.android.com/apk/res/android">
+    <item android:state_checked="true">
+        <layer-list>
+            <item android:width="24dp" android:height="24dp" android:gravity="center">
+                <shape android:shape="oval">
+                    <solid android:color="@color/widget_on_accent" />
+                </shape>
+            </item>
+        </layer-list>
+    </item>
+    <item>
+        <layer-list>
+            <item android:width="24dp" android:height="24dp" android:gravity="center">
+                <shape android:shape="oval">
+                    <solid android:color="@android:color/transparent" />
+                </shape>
+            </item>
+            <item android:width="16dp" android:height="16dp" android:gravity="center">
+                <shape android:shape="oval">
+                    <solid android:color="@color/widget_switch_knob_off" />
+                </shape>
+            </item>
+        </layer-list>
+    </item>
+</selector>
diff --git a/app/src/main/res/drawable/widget_switch_track.xml b/app/src/main/res/drawable/widget_switch_track.xml
new file mode 100644
index 0000000..1337900
--- /dev/null
+++ b/app/src/main/res/drawable/widget_switch_track.xml
@@ -0,0 +1,22 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- The switch's track on Android 12+ (layout-v31/widget_fauxx_switch), Material 3's shape in
+     the widget's colours; its padding keeps the thumb 4dp inside the ends. -->
+<selector xmlns:android="http://schemas.android.com/apk/res/android">
+    <item android:state_checked="true">
+        <shape android:shape="rectangle">
+            <solid android:color="@color/widget_accent" />
+            <corners android:radius="16dp" />
+            <size android:width="56dp" android:height="32dp" />
+            <padding android:left="4dp" android:right="4dp" />
+        </shape>
+    </item>
+    <item>
+        <shape android:shape="rectangle">
+            <solid android:color="@color/widget_switch_track_off" />
+            <stroke android:width="2dp" android:color="@color/widget_switch_outline" />
+            <corners android:radius="16dp" />
+            <size android:width="56dp" android:height="32dp" />
+            <padding android:left="4dp" android:right="4dp" />
+        </shape>
+    </item>
+</selector>
diff --git a/app/src/main/res/layout-v31/widget_fauxx_switch.xml b/app/src/main/res/layout-v31/widget_fauxx_switch.xml
new file mode 100644
index 0000000..60e233c
--- /dev/null
+++ b/app/src/main/res/layout-v31/widget_fauxx_switch.xml
@@ -0,0 +1,18 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Android 12+: the system's own switch (a widget can only use the framework's views, so not
+     AppCompat's or Material's), drawn in the widget's colours. White multiplies to nothing, so
+     a theme's tint can't recolour the drawables. -->
+<Switch xmlns:android="http://schemas.android.com/apk/res/android"
+    xmlns:tools="http://schemas.android.com/tools"
+    android:id="@+id/widget_switch"
+    android:layout_width="wrap_content"
+    android:layout_height="wrap_content"
+    android:layout_marginStart="12dp"
+    android:switchMinWidth="56dp"
+    android:thumb="@drawable/widget_switch_thumb"
+    android:thumbTint="@android:color/white"
+    android:thumbTintMode="multiply"
+    android:track="@drawable/widget_switch_track"
+    android:trackTint="@android:color/white"
+    android:trackTintMode="multiply"
+    tools:ignore="UseSwitchCompatOrMaterialXml" />
diff --git a/app/src/main/res/layout/widget_fauxx.xml b/app/src/main/res/layout/widget_fauxx.xml
new file mode 100644
index 0000000..0a100d1
--- /dev/null
+++ b/app/src/main/res/layout/widget_fauxx.xml
@@ -0,0 +1,151 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- The home-screen widget (com.fauxx.widget.FauxxWidget) at two rows or more, the full width
+     of the home screen: a header with "?", the status card with its switch, and two tiles,
+     every decoy action and the hourly rate. System fonts; Virtroid's palette (values/widget). -->
+<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
+    xmlns:tools="http://schemas.android.com/tools"
+    android:id="@android:id/background"
+    android:layout_width="match_parent"
+    android:layout_height="match_parent"
+    android:background="@drawable/widget_background"
+    android:orientation="vertical"
+    android:padding="16dp">
+
+    <!-- Not one TextView with a compound drawable: the "?" is a tap target of its own. -->
+    <LinearLayout
+        android:layout_width="match_parent"
+        android:layout_height="24dp"
+        android:gravity="center_vertical"
+        android:orientation="horizontal"
+        tools:ignore="UseCompoundDrawables">
+
+        <ImageView
+            android:layout_width="22dp"
+            android:layout_height="22dp"
+            android:importantForAccessibility="no"
+            android:src="@drawable/widget_ic_mark" />
+
+        <TextView
+            android:layout_width="0dp"
+            android:layout_height="wrap_content"
+            android:layout_marginStart="8dp"
+            android:layout_weight="1"
+            android:ellipsize="end"
+            android:fontFamily="sans-serif-medium"
+            android:maxLines="1"
+            android:text="@string/app_name"
+            android:textColor="@color/widget_text"
+            android:textSize="16sp" />
+
+        <!-- A 40dp target around a 22dp icon, taking no more of the header's height. -->
+        <ImageView
+            android:id="@+id/widget_help"
+            android:layout_width="40dp"
+            android:layout_height="40dp"
+            android:layout_marginTop="-8dp"
+            android:layout_marginEnd="-9dp"
+            android:layout_marginBottom="-8dp"
+            android:background="@drawable/widget_help_ripple"
+            android:contentDescription="@string/widget_help"
+            android:padding="9dp"
+            android:src="@drawable/widget_ic_help" />
+    </LinearLayout>
+
+    <LinearLayout
+        android:layout_width="match_parent"
+        android:layout_height="wrap_content"
+        android:layout_marginTop="12dp"
+        android:background="@drawable/widget_card"
+        android:baselineAligned="false"
+        android:gravity="center_vertical"
+        android:orientation="horizontal"
+        android:paddingStart="16dp"
+        android:paddingTop="12dp"
+        android:paddingEnd="12dp"
+        android:paddingBottom="12dp">
+
+        <LinearLayout
+            android:layout_width="0dp"
+            android:layout_height="wrap_content"
+            android:layout_weight="1"
+            android:orientation="vertical">
+
+            <TextView
+                android:id="@+id/widget_headline"
+                android:layout_width="wrap_content"
+                android:layout_height="wrap_content"
+                android:ellipsize="end"
+                android:fontFamily="sans-serif-medium"
+                android:maxLines="2"
+                android:text="@string/widget_headline_disabled"
+                android:textColor="@color/widget_text"
+                android:textSize="16sp" />
+
+            <TextView
+                android:id="@+id/widget_detail"
+                android:layout_width="wrap_content"
+                android:layout_height="wrap_content"
+                android:layout_marginTop="2dp"
+                android:ellipsize="end"
+                android:maxLines="2"
+                android:text="@string/widget_detail_off"
+                android:textColor="@color/widget_text_secondary"
+                android:textSize="13sp" />
+        </LinearLayout>
+
+        <include layout="@layout/widget_fauxx_switch" />
+    </LinearLayout>
+
+    <!-- The tiles share the width and take the height the widget has left. -->
+    <LinearLayout
+        android:layout_width="match_parent"
+        android:layout_height="0dp"
+        android:layout_marginTop="10dp"
+        android:layout_weight="1"
+        android:baselineAligned="false"
+        android:orientation="horizontal"
+        tools:ignore="NestedWeights">
+
+        <LinearLayout
+            android:layout_width="0dp"
+            android:layout_height="match_parent"
+            android:layout_weight="1"
+            android:background="@drawable/widget_card"
+            android:gravity="center_vertical"
+            android:orientation="vertical"
+            android:paddingHorizontal="16dp"
+            android:paddingVertical="4dp">
+
+            <!-- A big count shrinks to fit rather than cut off. -->
+            <TextView
+                android:id="@+id/widget_total"
+                style="@style/FauxxWidgetFigure"
+                android:text="@string/widget_zero_count" />
+
+            <TextView
+                style="@style/FauxxWidgetFigureLabel"
+                android:text="@string/widget_total_count" />
+        </LinearLayout>
+
+        <LinearLayout
+            android:layout_width="0dp"
+            android:layout_height="match_parent"
+            android:layout_marginStart="10dp"
+            android:layout_weight="1"
+            android:background="@drawable/widget_card"
+            android:gravity="center_vertical"
+            android:orientation="vertical"
+            android:paddingHorizontal="16dp"
+            android:paddingVertical="4dp">
+
+            <TextView
+                android:id="@+id/widget_rate"
+                style="@style/FauxxWidgetFigure"
+                android:text="@string/widget_zero_rate" />
+
+            <TextView
+                style="@style/FauxxWidgetFigureLabel"
+                android:text="@string/widget_hourly_rate" />
+        </LinearLayout>
+    </LinearLayout>
+</LinearLayout>
