diff --git a/app/src/main/res/xml/fauxx_widget_info.xml b/app/src/main/res/xml/fauxx_widget_info.xml
new file mode 100644
index 0000000..4bc7917
--- /dev/null
+++ b/app/src/main/res/xml/fauxx_widget_info.xml
@@ -0,0 +1,23 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- The full width of the home screen, three rows tall. Launcher3 takes the 5x3 target on a
+     five-column grid, and on a narrower one sizes the widget from minWidth, capped at the grid's
+     width, so 400dp fills any phone's row. minResizeWidth/Height keep it shrinkable (left unset
+     they would default to minWidth/Height, and the widget would never fit). The engine publishes
+     every state change (FauxxWidget.publish); the hourly update keeps the hourly rate, a count
+     over the last day, current while the engine is off. previewLayout and the target cells are
+     for Android 12+ launchers. -->
+<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
+    xmlns:tools="http://schemas.android.com/tools"
+    android:description="@string/widget_description"
+    android:initialLayout="@layout/widget_fauxx"
+    android:minWidth="400dp"
+    android:minHeight="180dp"
+    android:minResizeWidth="250dp"
+    android:minResizeHeight="150dp"
+    android:previewLayout="@layout/widget_fauxx"
+    android:resizeMode="horizontal|vertical"
+    android:targetCellWidth="5"
+    android:targetCellHeight="3"
+    android:updatePeriodMillis="3600000"
+    android:widgetCategory="home_screen"
+    tools:ignore="UnusedAttribute" />
diff --git a/app/src/test/java/com/fauxx/widget/WidgetStatusTest.kt b/app/src/test/java/com/fauxx/widget/WidgetStatusTest.kt
new file mode 100644
index 0000000..873d53a
--- /dev/null
+++ b/app/src/test/java/com/fauxx/widget/WidgetStatusTest.kt
@@ -0,0 +1,76 @@
+package com.fauxx.widget
+
+import com.fauxx.engine.EngineState
+import com.fauxx.widget.WidgetStatus.Action
+import com.fauxx.widget.WidgetStatus.Headline
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * What the home-screen widget's status card shows for each combination of the engine's flags,
+ * its service and the last state it published ([WidgetStatus.from]), and its hourly rate.
+ */
+class WidgetStatusTest {
+
+    private fun snapshot(state: EngineState, resigned: Boolean = false) = WidgetSnapshot(state, resigned)
+
+    @Test
+    fun `off before consent opens the app instead of starting`() {
+        val status = WidgetStatus.from(enabled = false, consented = false, running = false, snapshot = null)
+        assertEquals(WidgetStatus(Headline.SET_UP, null, Action.SET_UP), status)
+        assertFalse(status.switchOn)
+    }
+
+    @Test
+    fun `off after consent reads disabled, and the switch starts it`() {
+        val status = WidgetStatus.from(false, true, false, snapshot(EngineState.ACTIVE))
+        assertEquals(WidgetStatus(Headline.DISABLED, null, Action.START), status)
+        assertFalse(status.switchOn)
+    }
+
+    @Test
+    fun `running and active reads enabled, with the switch on`() {
+        val status = WidgetStatus.from(true, true, true, snapshot(EngineState.ACTIVE))
+        assertEquals(WidgetStatus(Headline.ENABLED, null, Action.STOP), status)
+        assertTrue(status.switchOn)
+    }
+
+    @Test
+    fun `a running pause reads paused with its reason, the switch still on`() {
+        val status = WidgetStatus.from(true, true, true, snapshot(EngineState.PAUSED_WIFI))
+        assertEquals(WidgetStatus(Headline.PAUSED, EngineState.PAUSED_WIFI, Action.STOP), status)
+        assertTrue(status.switchOn)
+    }
+
+    @Test
+    fun `a pause handed to a scheduled resume stays shown after the service stops`() {
+        val status = WidgetStatus.from(true, true, false, snapshot(EngineState.PAUSED_QUIET_HOURS, resigned = true))
+        assertEquals(WidgetStatus(Headline.PAUSED, EngineState.PAUSED_QUIET_HOURS, Action.STOP), status)
+    }
+
+    @Test
+    fun `a state the service stopped publishing reads as stopped, and the switch starts it`() {
+        // A reboot or a killed process: the last state was active, but nothing runs now.
+        val status = WidgetStatus.from(true, true, false, snapshot(EngineState.ACTIVE))
+        assertEquals(WidgetStatus(Headline.STOPPED, null, Action.START), status)
+        assertFalse(status.switchOn)
+    }
+
+    @Test
+    fun `on with nothing published yet reads as stopped`() {
+        assertEquals(WidgetStatus(Headline.STOPPED, null, Action.START), WidgetStatus.from(true, true, false, null))
+    }
+
+    @Test
+    fun `an engine turned on before consent existed can still be stopped`() {
+        assertEquals(Action.STOP, WidgetStatus.from(true, false, true, snapshot(EngineState.ACTIVE)).action)
+    }
+
+    @Test
+    fun `the hourly rate is the last day's actions over 24 hours, as the dashboard's`() {
+        assertEquals(40.2f, WidgetStatus.hourlyRate(965), 0.01f)
+        assertEquals(0f, WidgetStatus.hourlyRate(0), 0f)
+    }
+}
