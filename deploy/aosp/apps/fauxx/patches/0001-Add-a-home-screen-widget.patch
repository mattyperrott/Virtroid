+/**
+ * The home-screen widget: whether Fauxx is generating decoy activity or why it is paused, a
+ * switch that starts or stops the engine the way the dashboard's does, every decoy action Fauxx
+ * has made, and its hourly rate over the last day. It shows no persona, categories or log; the
+ * "?" opens the FAQ and a tap anywhere else opens the app.
+ *
+ * [PhantomForegroundService] publishes each state it puts in its notification ([publish]), and
+ * the engine counts each action it records ([countAction]); the widget keeps that state and the
+ * count in a small preferences file of its own (which, like the rest of Fauxx's, is never backed
+ * up). The rate comes from the action log when the widget draws, as the dashboard's does.
+ */
+class FauxxWidget : AppWidgetProvider() {
+
+    override fun onUpdate(context: Context, appWidgetManager: AppWidgetManager, appWidgetIds: IntArray) {
+        val pending = goAsync()
+        scope.launch {
+            try {
+                draw(context.applicationContext)
+            } catch (e: Exception) {
+                Timber.w(e, "FauxxWidget: update failed")
+            } finally {
+                pending.finish()
+            }
+        }
+    }
+
+    @EntryPoint
+    @InstallIn(SingletonComponent::class)
+    interface WidgetEntryPoint {
+        fun actionLogDao(): ActionLogDao
+        fun resumeScheduler(): ResumeScheduler
+    }
+
+    companion object {
+        private const val PREFS = "fauxx_widget"
+        private const val KEY_STATE = "state"
+        private const val KEY_RESIGNED = "resigned"
+        private const val KEY_TOTAL = "total_actions"
+        private const val DAY_MS = 24L * 60 * 60 * 1000
+
+        private val scope = CoroutineScope(SupervisorJob() + Dispatchers.Default)
+
+        /**
+         * One redraw at a time, each reading the state when it holds the lock: redraws are
+         * launched from several threads, and one that read an older state must not land after
+         * one that read a newer.
+         */
+        private val drawLock = Mutex()
+
+        /**
+         * Records what the engine is doing and redraws any widgets. [resigned] marks a pause the
+         * engine handed to a scheduled resume ([WidgetSnapshot]).
+         */
+        @Synchronized
+        fun publish(context: Context, state: EngineState, resigned: Boolean = false) {
+            val app = context.applicationContext
+            app.getSharedPreferences(PREFS, Context.MODE_PRIVATE).edit {
+                putString(KEY_STATE, state.name)
+                putBoolean(KEY_RESIGNED, resigned)
+            }
+            refresh(app)
+        }
+
+        /** Counts one decoy action; the engine calls it as it records each one. */
+        @Synchronized
+        fun countAction(context: Context) {
+            val prefs = context.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+            prefs.edit { putLong(KEY_TOTAL, prefs.getLong(KEY_TOTAL, 0L) + 1) }
+        }
+
+        /** Forgets the count, with the rest of the user's data (Settings, "Clear All Data"). */
+        @Synchronized
+        fun resetCount(context: Context) {
+            val app = context.applicationContext
+            app.getSharedPreferences(PREFS, Context.MODE_PRIVATE).edit { remove(KEY_TOTAL) }
+            refresh(app)
+        }
+
+        /** Redraws every Fauxx widget; does nothing when none is placed. */
+        fun refresh(context: Context) {
+            val app = context.applicationContext
+            if (widgetIds(app).isEmpty()) return
+            scope.launch {
+                runCatching { draw(app) }.onFailure { Timber.w(it, "FauxxWidget: redraw failed") }
+            }
+        }
+
+        fun entryPoint(context: Context): WidgetEntryPoint =
+            EntryPointAccessors.fromApplication(context.applicationContext, WidgetEntryPoint::class.java)
+
+        private fun widgetIds(context: Context): IntArray =
+            AppWidgetManager.getInstance(context)
+                .getAppWidgetIds(ComponentName(context, FauxxWidget::class.java))
+
+        private fun snapshot(context: Context): WidgetSnapshot? {
+            val prefs = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+            val state = prefs.getString(KEY_STATE, null)
+                ?.let { name -> EngineState.entries.firstOrNull { it.name == name } }
+                ?: return null
+            return WidgetSnapshot(state, prefs.getBoolean(KEY_RESIGNED, false))
+        }
+
+        private suspend fun draw(context: Context) = drawLock.withLock {
+            val ids = widgetIds(context)
+            if (ids.isEmpty()) return@withLock
+            val prefs = context.fauxxDataStore.data.first()
+            val status = WidgetStatus.from(
+                enabled = prefs[PreferenceKeys.ENABLED] ?: false,
+                consented = prefs[PreferenceKeys.CONSENT_ACCEPTED] ?: false,
+                running = PhantomForegroundService.isRunning,
+                snapshot = snapshot(context),
+            )
+            val total = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE).getLong(KEY_TOTAL, 0L)
+            val rate = runCatching {
+                val since = System.currentTimeMillis() - DAY_MS
+                WidgetStatus.hourlyRate(entryPoint(context).actionLogDao().countSince(since).first())
+            }.onFailure { Timber.w(it, "FauxxWidget: could not count the last day's actions") }.getOrNull()
+            AppWidgetManager.getInstance(context).updateAppWidget(ids, views(context, status, total, rate))
+        }
+
+        /**
+         * On Android 12+ one layout per size, and the launcher picks the one that fits: two rows
+         * or more get [R.layout.widget_fauxx], one row the compact layout. Before 12, the full one.
+         */
+        private fun views(context: Context, status: WidgetStatus, total: Long, rate: Float?): RemoteViews {
+            if (Build.VERSION.SDK_INT < Build.VERSION_CODES.S) return views(context, status, total, rate, compact = false)
+            return RemoteViews(
+                mapOf(
+                    SizeF(250f, 90f) to views(context, status, total, rate, compact = true),
+                    SizeF(250f, 180f) to views(context, status, total, rate, compact = false),
+                ),
+            )
+        }
+
+        private fun views(context: Context, status: WidgetStatus, total: Long, rate: Float?, compact: Boolean): RemoteViews {
+            val views = RemoteViews(
+                context.packageName,
+                if (compact) R.layout.widget_fauxx_compact else R.layout.widget_fauxx,
+            )
+
+            val (headline, colour) = when (status.headline) {
+                WidgetStatus.Headline.ENABLED -> R.string.widget_headline_enabled to R.color.widget_accent
+                WidgetStatus.Headline.PAUSED -> R.string.widget_headline_paused to R.color.widget_paused
+                WidgetStatus.Headline.STOPPED -> R.string.widget_headline_stopped to R.color.widget_text
+                WidgetStatus.Headline.DISABLED -> R.string.widget_headline_disabled to R.color.widget_text
+                WidgetStatus.Headline.SET_UP -> R.string.widget_headline_set_up to R.color.widget_text
+            }
+            views.setTextViewText(R.id.widget_headline, context.getString(headline))
+            views.setTextColor(R.id.widget_headline, ContextCompat.getColor(context, colour))
+
+            val locale = Locale.getDefault()
+            val totalText = NumberFormat.getIntegerInstance(locale).format(total)
+            val rateText = rate?.let { String.format(locale, "%.1f", it) } ?: "–"
+            // One row has no tiles: while it runs, the counts go under the headline instead.
+            views.setTextViewText(
+                R.id.widget_detail,
+                if (compact && status.headline == WidgetStatus.Headline.ENABLED) {
+                    context.getString(R.string.widget_compact_counts, totalText, rateText)
+                } else {
+                    context.getString(detailText(status))
+                },
+            )
+
+            val (switchLabel, switchAction) = when (status.action) {
+                WidgetStatus.Action.START -> R.string.widget_action_start to actionIntent(context, WidgetActionReceiver.ACTION_START)
+                WidgetStatus.Action.STOP -> R.string.notification_action_stop to actionIntent(context, WidgetActionReceiver.ACTION_STOP)
+                WidgetStatus.Action.SET_UP -> R.string.widget_action_set_up to openAppIntent(context, faq = false)
+            }
+            views.setContentDescription(R.id.widget_switch, context.getString(switchLabel))
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
+                // The system's own switch (layout-v31): flipping it sends what the state calls for.
+                views.setCompoundButtonChecked(R.id.widget_switch, status.switchOn)
+                views.setOnCheckedChangeResponse(R.id.widget_switch, RemoteViews.RemoteResponse.fromPendingIntent(switchAction))
+            } else {
+                views.setImageViewResource(
+                    R.id.widget_switch,
+                    if (status.switchOn) R.drawable.widget_switch_on else R.drawable.widget_switch_off,
+                )
+                views.setOnClickPendingIntent(R.id.widget_switch, switchAction)
+            }
+
+            if (!compact) {
+                views.setTextViewText(R.id.widget_total, totalText)
+                // The unit smaller and quieter than the figure, in the one view (so it shrinks with it).
+                val unit = context.getString(R.string.widget_per_hour)
+                views.setTextViewText(
+                    R.id.widget_rate,
+                    SpannableString(rateText + unit).apply {
+                        val from = rateText.length
+                        setSpan(RelativeSizeSpan(0.6f), from, length, Spanned.SPAN_EXCLUSIVE_EXCLUSIVE)
+                        setSpan(
+                            ForegroundColorSpan(ContextCompat.getColor(context, R.color.widget_text_secondary)),
+                            from, length, Spanned.SPAN_EXCLUSIVE_EXCLUSIVE,
+                        )
+                    },
+                )
+                views.setOnClickPendingIntent(R.id.widget_help, openAppIntent(context, faq = true))
+            }
+            // The root is @android:id/background, which Android 12+ launchers animate from when it opens the app.
+            views.setOnClickPendingIntent(android.R.id.background, openAppIntent(context, faq = false))
+            return views
+        }
+
+        private fun detailText(status: WidgetStatus): Int = when (status.headline) {
+            WidgetStatus.Headline.ENABLED -> R.string.widget_detail_active
+            WidgetStatus.Headline.STOPPED -> R.string.widget_detail_stopped
+            WidgetStatus.Headline.DISABLED -> R.string.widget_detail_off
+            WidgetStatus.Headline.SET_UP -> R.string.widget_detail_set_up
+            WidgetStatus.Headline.PAUSED -> when (status.pause) {
+                EngineState.PAUSED_WIFI -> R.string.widget_reason_network
+                EngineState.PAUSED_METERED_WIFI -> R.string.widget_reason_metered
+                EngineState.PAUSED_NETWORK_BLOCKED -> R.string.widget_reason_network_blocked
+                EngineState.PAUSED_BATTERY -> R.string.dashboard_engine_state_paused_battery
+                EngineState.PAUSED_BATTERY_SAVER -> R.string.dashboard_engine_state_paused_battery_saver
+                EngineState.PAUSED_RATE_LIMIT -> R.string.dashboard_engine_state_paused_rate_limit
+                EngineState.PAUSED_QUIET_HOURS -> R.string.dashboard_engine_state_paused_quiet_hours
+                EngineState.ACTIVE, EngineState.STOPPED, null -> R.string.widget_detail_active
+            }
+        }
+
+        private fun openAppIntent(context: Context, faq: Boolean): PendingIntent {
+            // Explicit component and package, as postResumeNotification's tap intent (CWE-927).
+            val intent = Intent(context, MainActivity::class.java).apply {
+                action = Intent.ACTION_MAIN
+                setPackage(context.packageName)
+                flags = Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_SINGLE_TOP
+                if (faq) putExtra(MainActivity.EXTRA_OPEN_FAQ, true)
+            }
+            return PendingIntent.getActivity(
+                context, if (faq) REQUEST_FAQ else REQUEST_OPEN, intent,
+                PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT,
+            )
+        }
+
+        private fun actionIntent(context: Context, action: String): PendingIntent {
+            val intent = Intent(context, WidgetActionReceiver::class.java).apply {
+                this.action = action
+                setPackage(context.packageName)
+            }
+            val request = if (action == WidgetActionReceiver.ACTION_START) REQUEST_START else REQUEST_STOP
+            return PendingIntent.getBroadcast(
+                context, request, intent,
+                PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT,
+            )
+        }
+
+        private const val REQUEST_OPEN = 0
+        private const val REQUEST_START = 1
+        private const val REQUEST_STOP = 2
+        private const val REQUEST_FAQ = 3
+    }
+}
diff --git a/app/src/main/java/com/fauxx/widget/WidgetActionReceiver.kt b/app/src/main/java/com/fauxx/widget/WidgetActionReceiver.kt
new file mode 100644
index 0000000..561e205
--- /dev/null
+++ b/app/src/main/java/com/fauxx/widget/WidgetActionReceiver.kt
@@ -0,0 +1,88 @@
+package com.fauxx.widget
+
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.Intent
+import androidx.core.content.ContextCompat
+import androidx.datastore.preferences.core.edit
+import com.fauxx.di.PreferenceKeys
+import com.fauxx.di.fauxxDataStore
+import com.fauxx.engine.EngineState
+import com.fauxx.service.PhantomForegroundService
+import com.fauxx.service.postResumeNotification
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.launch
+import timber.log.Timber
+
+/**
+ * The widget's switch, starting or stopping the engine. Not exported: only the widget's own PendingIntents
+ * reach it.
+ *
+ * Start mirrors [com.fauxx.service.StartEngineReceiver]: the foreground service starts
+ * synchronously inside the tap's broadcast, since a tap on the app's own widget is one of the
+ * contexts Android 12+ lets an app start a foreground service from, then ENABLED=true is
+ * persisted. The widget only offers Start once the user has accepted the consent dialog
+ * ([WidgetStatus.Button.SET_UP] opens the app instead), so this never skips it.
+ *
+ * Stop does what the dashboard's switch does: it stops the running service (whose stop also
+ * cancels a pending resume) and persists ENABLED=false. With no service running, a pause the
+ * engine handed to a scheduled resume is cancelled directly.
+ */
+class WidgetActionReceiver : BroadcastReceiver() {
+
+    override fun onReceive(context: Context, intent: Intent) {
+        val app = context.applicationContext
+        when (intent.action) {
+            ACTION_START -> start(app)
+            ACTION_STOP -> stop(app)
+        }
+    }
+
+    private fun start(app: Context) {
+        val started = try {
+            ContextCompat.startForegroundService(app, PhantomForegroundService.startIntent(app))
+            Timber.i("WidgetActionReceiver: started the foreground service from the widget")
+            true
+        } catch (e: Exception) {
+            Timber.w(e, "WidgetActionReceiver: FGS start denied; posting the resume notification")
+            runCatching { postResumeNotification(app) }
+                .onFailure { Timber.w(it, "WidgetActionReceiver: failed to post the resume notification") }
+            false
+        }
+        if (started) persistEnabled(app, true) else FauxxWidget.refresh(app)
+    }
+
+    private fun stop(app: Context) {
+        if (PhantomForegroundService.isRunning) {
+            // A process with a running foreground service may start its own services.
+            runCatching { app.startService(PhantomForegroundService.stopIntent(app)) }
+                .onFailure { Timber.w(it, "WidgetActionReceiver: failed to stop the service") }
+        } else {
+            runCatching {
+                FauxxWidget.entryPoint(app).resumeScheduler().cancel()
+            }.onFailure { Timber.w(it, "WidgetActionReceiver: failed to cancel the pending resume") }
+        }
+        persistEnabled(app, false)
+    }
+
+    private fun persistEnabled(app: Context, enabled: Boolean) {
+        val pending = goAsync()
+        CoroutineScope(SupervisorJob() + Dispatchers.Default).launch {
+            try {
+                runCatching { app.fauxxDataStore.edit { it[PreferenceKeys.ENABLED] = enabled } }
+                    .onFailure { Timber.w(it, "WidgetActionReceiver: failed to persist ENABLED=$enabled") }
+                // A stop has nothing left to say why it was paused.
+                if (enabled) FauxxWidget.refresh(app) else FauxxWidget.publish(app, EngineState.STOPPED)
+            } finally {
+                pending?.finish()
+            }
+        }
+    }
+
+    companion object {
+        const val ACTION_START = "com.fauxx.widget.START"
+        const val ACTION_STOP = "com.fauxx.widget.STOP"
+    }
+}
diff --git a/app/src/main/java/com/fauxx/widget/WidgetStatus.kt b/app/src/main/java/com/fauxx/widget/WidgetStatus.kt
new file mode 100644
index 0000000..fae8626
--- /dev/null
+++ b/app/src/main/java/com/fauxx/widget/WidgetStatus.kt
@@ -0,0 +1,84 @@
+package com.fauxx.widget
+
+import com.fauxx.engine.EngineState
+
+/**
+ * The last state the engine published to the widget ([FauxxWidget.publish]).
+ *
+ * @property resigned the engine handed this pause to a scheduled resume and stopped its service,
+ *   so the pause stays true while nothing runs. Any other state is only true while the service is.
+ */
+internal data class WidgetSnapshot(
+    val state: EngineState,
+    val resigned: Boolean,
+)
+
+/**
+ * What the widget's status card shows: its headline, the pause behind a [Headline.PAUSED]
+ * ([pause]), and what its switch does ([action]); the switch reads on while it would stop.
+ */
+internal data class WidgetStatus(
+    val headline: Headline,
+    val pause: EngineState?,
+    val action: Action,
+) {
+    val switchOn: Boolean get() = action == Action.STOP
+
+    enum class Headline {
+        /** Generating decoy activity. */
+        ENABLED,
+
+        /** On, but waiting out a pause ([pause] says which). */
+        PAUSED,
+
+        /** On, but not running (after a reboot, or stopped from the notification). */
+        STOPPED,
+
+        /** Turned off. */
+        DISABLED,
+
+        /** Never allowed to run: the consent dialog hasn't been accepted. */
+        SET_UP,
+    }
+
+    enum class Action {
+        /** Start the engine (the user has accepted the consent dialog). */
+        START,
+
+        /** Stop the engine, as the dashboard's switch does. */
+        STOP,
+
+        /** Open the app: the engine has never been allowed to run, and only the app asks. */
+        SET_UP,
+    }
+
+    companion object {
+        /**
+         * Decides what to show from the engine's on/off and consent flags, whether its service
+         * runs, and the last published [snapshot], so a state the service stopped publishing (a
+         * reboot, a killed process) never shows as current.
+         */
+        fun from(enabled: Boolean, consented: Boolean, running: Boolean, snapshot: WidgetSnapshot?): WidgetStatus {
+            if (!enabled) {
+                return if (consented) WidgetStatus(Headline.DISABLED, null, Action.START)
+                else WidgetStatus(Headline.SET_UP, null, Action.SET_UP)
+            }
+            val state = when {
+                snapshot == null -> EngineState.STOPPED
+                running || snapshot.resigned -> snapshot.state
+                else -> EngineState.STOPPED
+            }
+            return when (state) {
+                EngineState.ACTIVE -> WidgetStatus(Headline.ENABLED, null, Action.STOP)
+                EngineState.STOPPED -> WidgetStatus(Headline.STOPPED, null, Action.START)
+                else -> WidgetStatus(Headline.PAUSED, state, Action.STOP)
+            }
+        }
+
+        /**
+         * Decoy actions per hour over the last 24 hours, the dashboard's figure
+         * ([com.fauxx.ui.viewmodels.DashboardViewModel]): an honest measure of the cover traffic.
+         */
+        fun hourlyRate(actionsLastDay: Int): Float = actionsLastDay / 24f
+    }
+}
