// Apps built into the image as their publishers signed them, unchanged.
// build-lineage.sh puts each APK in prebuilt/ after checking it against
// prebuilt.sha256; the APKs are not in git.

// The F-Droid client. Its native code is stored uncompressed and it asks
// not to have it extracted, so a bundled copy runs as signed.
android_app_import {
    name: "F-Droid",
    apk: "prebuilt/F-Droid.apk",
    presigned: true,
    // Installed exactly as signed: the build must not realign or re-sign it.
    preprocessed: true,
    product_specific: true,
    dex_preopt: {
        enabled: false,
    },
}

// GrapheneOS's PDF Viewer (MIT): pdf.js in a sandboxed WebView, no
// permissions. Signed by GrapheneOS (the certificate their App Store lists);
// it isn't on F-Droid, so a new version comes with a new image.
android_app_import {
    name: "PdfViewer",
    apk: "prebuilt/PdfViewer.apk",
    presigned: true,
    preprocessed: true,
    product_specific: true,
    dex_preopt: {
        enabled: false,
    },
}

// Currencies (GPL-3.0-or-later), an exchange-rate converter, and Fossify
// Notes (GPL-3.0). F-Droid built and signed both, so the F-Droid client
// above updates them; their source goes out with each image
// (app-sources.sh).
android_app_import {
    name: "Currencies",
    apk: "prebuilt/Currencies.apk",
    presigned: true,
    preprocessed: true,
    product_specific: true,
    dex_preopt: {
        enabled: false,
    },
}

android_app_import {
    name: "FossifyNotes",
    apk: "prebuilt/FossifyNotes.apk",
    presigned: true,
    preprocessed: true,
    product_specific: true,
    dex_preopt: {
        enabled: false,
    },
}

// Fauxx (AGPL-3.0-only), decoy activity against ad-tech profiling, with a
// home-screen widget added for Virtroid (apps/fauxx): built from source with
// that change and signed with Virtroid's release key, so F-Droid doesn't
// update it. Its source goes out with each image (app-sources.sh).
android_app_import {
    name: "Fauxx",
    apk: "prebuilt/Fauxx.apk",
    presigned: true,
    preprocessed: true,
    product_specific: true,
    dex_preopt: {
        enabled: false,
    },
}

// Virtroid's runtime agent (notification forwarding), the APK the node pins
// and provisions. The node still installs it over adb and provisions it; a
// bundled copy is there from the first boot.
android_app_import {
    name: "VirtroidRuntimeAgent",
    apk: "prebuilt/virtroid-runtime-agent.apk",
    presigned: true,
    // Installed exactly as signed: the build must not realign or re-sign it.
    preprocessed: true,
    product_specific: true,
    dex_preopt: {
        enabled: false,
    },
}

// Shield (GPL-3.0-or-later, android-client/shield): a deposit address that moves
// the user's own ETH, USDC and USDT into Privacy Pools, and sends them out again.
// Signed with Virtroid's release key; its source goes out with each image
// (app-sources.sh).
android_app_import {
    name: "Shield",
    apk: "prebuilt/Shield.apk",
    presigned: true,
    preprocessed: true,
    product_specific: true,
    dex_preopt: {
        enabled: false,
    },
}
