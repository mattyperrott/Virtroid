<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Network time from the NTP pool's Android zone, not Google's
         time.android.com. -->
    <string-array translatable="false" name="config_ntpServers">
        <item>ntp://2.android.pool.ntp.org</item>
    </string-array>

    <!-- Virtroid's lime as the system colour a runtime starts with, the way
         a phone's colour matches its body. SystemUI applies it only until
         the device is set up, which in a container is almost at once, so
         SettingsProvider's default sets the same (patches/frameworks/base).
         With SystemUI's config_themeGreySurfaces the lime itself is the
         accent and surfaces stay grey; TONAL_SPOT puts the accent at the
         lime's own tone and keeps the secondary colours quiet. Apps can read
         the system colours, so all runtimes sharing it lets an app tell it
         runs on Virtroid: a decision, not an oversight. -->
    <string-array translatable="false" name="theming_defaults">
        <item>*|TONAL_SPOT|#AFD135</item>
    </string-array>

