<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- No captive portal probes to Google's connectivitycheck servers: a
         runtime's network is the VM's, never behind a portal
         (patches/frameworks/base). -->
    <integer name="def_captive_portal_mode">0</integer>
    <!-- The clock is the VM's. Android setting it from the network would
         change the whole VM's clock, which a privileged container can. -->
    <bool name="def_auto_time">false</bool>
    <!-- Virtroid's lime as the system colour a runtime starts with, a preset
         the owner can change in Settings (patches/frameworks/base). The same
         as theming_defaults, which SystemUI applies only if it gets there
         before Provision marks the runtime set up. -->
    <string name="def_theme_customization_overlay_packages" translatable="false">{\"android.theme.customization.color_source\":\"preset\",\"android.theme.customization.system_palette\":\"AFD135\",\"android.theme.customization.accent_color\":\"AFD135\",\"android.theme.customization.theme_style\":\"TONAL_SPOT\"}</string>
</resources>
