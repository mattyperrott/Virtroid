From c90ce1469b1c88063abbd0022c94aeed860b5dc0 Mon Sep 17 00:00:00 2001
From: Virtroid build <build@virtroid.invalid>
Date: Wed, 11 Nov 2026 05:08:20 +0000
Subject: [PATCH] rootdir: mount binderfs without global binder stats

stats=global gives a binderfs the kernel's binder state and transaction logs for every process on the host, which in a Virtroid VM is every runtime on it, and it needs CAP_SYS_ADMIN over the host's user namespace, so in a runtime in a user namespace the mount failed and there was no binder at all. Mount binderfs plainly. What reads binder_logs (BinderfsStatsReader, libbinderdebug) already copes without it.

Change-Id: Ic0c5dd1a9195a7f4800e095b0b1dcf765f73743a
---
 rootdir/init.rc | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/rootdir/init.rc b/rootdir/init.rc
index da9f67b..55ccde1 100644
--- a/rootdir/init.rc
+++ b/rootdir/init.rc
@@ -270,7 +270,7 @@ on init
 
     # Mount binderfs
     mkdir /dev/binderfs
-    mount binder binder /dev/binderfs stats=global
+    mount binder binder /dev/binderfs
     chmod 0755 /dev/binderfs
     exec -- /vendor/bin/binder_alloc /dev/binderfs/binder-control binder hwbinder vndbinder
 
-- 
2.43.0

