     }
 }
 
-void Gnss::reportNmea() const {
-    if (mIsNmeaActive) {
-        std::shared_ptr<IGnssCallback> callback;
-        {
-            std::unique_lock<std::mutex> lock(mMutex);
-            if (sGnssCallback == nullptr) {
-                ALOGE("%s: GnssCallback is null.", __func__);
-                return;
-            }
-            callback = sGnssCallback;
+void Gnss::reportNmea(const std::vector<std::string>& sentences, int64_t timestampMillis) const {
+    std::shared_ptr<IGnssCallback> callback;
+    {
+        std::unique_lock<std::mutex> lock(mMutex);
+        if (sGnssCallback == nullptr) {
+            ALOGE("%s: GnssCallback is null.", __func__);
+            return;
         }
-        nsecs_t now = systemTime(SYSTEM_TIME_MONOTONIC);
-        auto status = callback->gnssNmeaCb(now, "$TEST,0,1,2,3,4,5");
+        callback = sGnssCallback;
+    }
+    for (const auto& sentence : sentences) {
+        auto status = callback->gnssNmeaCb(timestampMillis, sentence);
         if (!status.isOk()) {
             ALOGE("%s: Unable to invoke callback", __func__);
         }
