diff --git a/gnss/aidl/default/Gnss.cpp b/gnss/aidl/default/Gnss.cpp
index b1a3cfd..dc50bd5 100644
--- a/gnss/aidl/default/Gnss.cpp
+++ b/gnss/aidl/default/Gnss.cpp
@@ -59,40 +59,78 @@ ScopedAStatus Gnss::setCallback(const std::shared_ptr<IGnssCallback>& callback)
         sGnssCallback = callback;
     }
 
-    int capabilities =
-            (int)(IGnssCallback::CAPABILITY_MEASUREMENTS | IGnssCallback::CAPABILITY_SCHEDULING |
-                  IGnssCallback::CAPABILITY_SATELLITE_BLOCKLIST |
-                  IGnssCallback::CAPABILITY_SATELLITE_PVT |
-                  IGnssCallback::CAPABILITY_CORRELATION_VECTOR |
-                  IGnssCallback::CAPABILITY_ANTENNA_INFO |
-                  IGnssCallback::CAPABILITY_ACCUMULATED_DELTA_RANGE);
+    // The location source says which receiver the runtime's device has: its
+    // name and year, whether it measures carrier phase, and the signals it
+    // tracks. Capabilities are what that receiver has and this HAL backs with
+    // real data: no antenna info, satellite PVT or correlation vectors.
+    namespace common = ::android::hardware::gnss::common;
+    std::string receiver;
+    if (common::ReplayUtils::hasFixedLocationDeviceFile()) {
+        receiver = common::DeviceFileReader::Instance().getReceiverData();
+    }
+    std::vector<std::string> receiverLines;
+    common::ParseUtils::splitStr(receiver, common::LINE_SEPARATOR, receiverLines);
+    int yearOfHw = 0;
+    std::string modelName;
+    bool carrierPhase = false;
+    std::vector<GnssSignalType> signalTypes;
+    for (const auto& line : receiverLines) {
+        if (line.rfind("Receiver,", 0) == 0) {
+            // Receiver,YearOfHardware,Flags,ModelName: the name last, as it
+            // may hold commas.
+            size_t year = line.find(',');
+            size_t flags = line.find(',', year + 1);
+            size_t name = flags == std::string::npos ? flags : line.find(',', flags + 1);
+            if (name == std::string::npos) {
+                continue;
+            }
+            yearOfHw = common::ParseUtils::tryParseInt(line.substr(year + 1, flags - year - 1), 0);
+            carrierPhase =
+                    common::ParseUtils::tryParseInt(line.substr(flags + 1, name - flags - 1), 0) & 1;
+            modelName = line.substr(name + 1);
+        } else if (line.rfind("Signal,", 0) == 0) {
+            std::vector<std::string> values;
+            common::ParseUtils::splitStr(line, common::COMMA_SEPARATOR, values);
+            if (values.size() != 4) {
+                continue;
+            }
+            signalTypes.push_back({
+                    .constellation = static_cast<GnssConstellationType>(
+                            common::ParseUtils::tryParseInt(values[1], 0)),
+                    .carrierFrequencyHz = common::ParseUtils::tryParseDouble(values[2], 0),
+                    .codeType = values[3],
+            });
+        }
+    }
+
+    int capabilities = (int)(IGnssCallback::CAPABILITY_MEASUREMENTS |
+                             IGnssCallback::CAPABILITY_SCHEDULING |
+                             IGnssCallback::CAPABILITY_SATELLITE_BLOCKLIST);
+    if (carrierPhase) {
+        capabilities |= (int)IGnssCallback::CAPABILITY_ACCUMULATED_DELTA_RANGE;
+    }
     auto status = callback->gnssSetCapabilitiesCb(capabilities);
     if (!status.isOk()) {
         ALOGE("%s: Unable to invoke callback.gnssSetCapabilitiesCb", __func__);
     }
 
-    IGnssCallback::GnssSystemInfo systemInfo = {
-            .yearOfHw = 2022,
-            .name = "Google, Cuttlefish, AIDL v3",
-    };
-    status = callback->gnssSetSystemInfoCb(systemInfo);
-    if (!status.isOk()) {
-        ALOGE("%s: Unable to invoke callback.gnssSetSystemInfoCb", __func__);
+    // Without a receiver from the source, no name at all rather than this
+    // HAL's own, which names an emulator.
+    if (!modelName.empty()) {
+        IGnssCallback::GnssSystemInfo systemInfo = {
+                .yearOfHw = yearOfHw,
+                .name = modelName,
+        };
