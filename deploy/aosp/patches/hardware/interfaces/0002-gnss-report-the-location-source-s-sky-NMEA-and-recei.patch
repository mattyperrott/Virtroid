+std::vector<IGnssCallback::GnssSvInfo> FixLocationParser::getSvInfoFromInputStr(
+        const std::string& inputStr) {
+    std::vector<IGnssCallback::GnssSvInfo> svInfoList;
+    std::vector<std::string> records;
+    ParseUtils::splitStr(inputStr, LINE_SEPARATOR, records);
+    for (const auto& record : records) {
+        std::vector<std::string> values;
+        ParseUtils::splitStr(record, COMMA_SEPARATOR, values);
+        if (values.size() != 9 || values[0] != "Sv") {
+            continue;
+        }
+        int constellation = ParseUtils::tryParseInt(values[1], 0);
+        if (constellation < (int)GnssConstellationType::GPS ||
+            constellation > (int)GnssConstellationType::IRNSS) {
+            continue;
+        }
+        svInfoList.push_back({
+                .svid = ParseUtils::tryParseInt(values[2], 0),
+                .constellation = static_cast<GnssConstellationType>(constellation),
+                .cN0Dbhz = ParseUtils::tryParsefloat(values[3], 0),
+                .basebandCN0DbHz = ParseUtils::tryParsefloat(values[4], 0),
+                .elevationDegrees = ParseUtils::tryParsefloat(values[5], 0),
+                .azimuthDegrees = ParseUtils::tryParsefloat(values[6], 0),
+                .carrierFrequencyHz = ParseUtils::tryParseLongLong(values[7], 0),
+                .svFlag = ParseUtils::tryParseInt(values[8], 0),
+        });
+    }
+    return svInfoList;
+}
+
+std::vector<std::string> FixLocationParser::getNmeaFromInputStr(const std::string& inputStr) {
+    std::vector<std::string> sentences;
+    std::vector<std::string> records;
+    ParseUtils::splitStr(inputStr, LINE_SEPARATOR, records);
+    for (const auto& record : records) {
+        if (record.rfind("Nmea,$", 0) == 0) {
+            sentences.push_back(record.substr(5));
+        }
+    }
+    return sentences;
+}
