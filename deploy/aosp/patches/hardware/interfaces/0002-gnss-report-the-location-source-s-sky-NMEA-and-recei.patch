+                    mFirstFixReceived = true;
                 }
-                if (!mGnssMeasurementEnabled || mMinIntervalMs <= mGnssMeasurementIntervalMs) {
-                    this->reportSvStatus();
+                // One record from the location source: the fix, the sky the
+                // receiver tracks and the fix's NMEA sentences, reported
+                // together.
+                namespace common = ::android::hardware::gnss::common;
+                std::string record;
+                if (common::ReplayUtils::hasFixedLocationDeviceFile()) {
+                    record = common::DeviceFileReader::Instance().getLocationData();
+                }
+                auto currentLocation = common::FixLocationParser::getLocationFromInputStr(record);
+                // The sky goes with every fix, as a receiver's does, so a fix
+                // carries the satellites used in it with no app listening.
+                auto svInfoList = common::FixLocationParser::getSvInfoFromInputStr(record);
+                if (!svInfoList.empty() || mIsSvStatusActive) {
+                    this->reportSvStatus(filterBlocklistedSatellites(svInfoList));
+                }
+                if (mIsNmeaActive) {
+                    this->reportNmea(common::FixLocationParser::getNmeaFromInputStr(record),
+                                     currentLocation != nullptr
+                                             ? currentLocation->timestampMillis
+                                             : std::chrono::duration_cast<std::chrono::milliseconds>(
+                                                       std::chrono::system_clock::now()
+                                                               .time_since_epoch())
+                                                       .count());
                 }
-                this->reportNmea();
-
-                auto currentLocation = getLocationFromHW();
                 mGnssPowerIndication->notePowerConsumption();
                 // Without a fix from the location source there is none to
                 // report: no made-up default position.
@@ -142,15 +193,6 @@ ScopedAStatus Gnss::setCallback(const std::shared_ptr<IGnssCallback>& callback)
     return ScopedAStatus::ok();
 }
 
