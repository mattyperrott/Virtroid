From ee5beb3886cc589345519fb2f23a84fd8ba25b4d Mon Sep 17 00:00:00 2001
From: Virtroid build <build@virtroid.invalid>
Date: Wed, 28 Oct 2026 11:24:53 +0000
Subject: [PATCH] Codec2BufferUtils: convert RGBA to YUV a row at a time

A screen recording reaches a software encoder as RGBA from a virtual
display, and ConvertRGBToPlanarYUV converts each frame with a loop that
steps three plane pointers by their increments and tests every pixel for
chroma. Clang can't vectorize it: in a device with no hardware encoder,
streaming its 752x1600 screen, this function was 27% of the AVC
encoder's CPU, and 35% once the encoder ran at its fastest preset.

For 8-bit RGBA or RGBX in that order, with whole rows, convert each row
on fixed strides in 16-bit arithmetic, which the sums fit for every
matrix and range. The output is the same byte for byte (checked against
the old loop for odd and even sizes, padded rows, both matrices and both
ranges), and a 752x1600 frame takes 0.53 ms instead of 2.6 ms on x86_64
with SSE4.2, where clang vectorizes both loops 16 pixels wide.
---
 .../sfplugin/utils/Codec2BufferUtils.cpp      | 52 +++++++++++++++++++
 1 file changed, 52 insertions(+)

diff --git a/media/codec2/sfplugin/utils/Codec2BufferUtils.cpp b/media/codec2/sfplugin/utils/Codec2BufferUtils.cpp
index c50d197..1a9f3b2 100644
--- a/media/codec2/sfplugin/utils/Codec2BufferUtils.cpp
+++ b/media/codec2/sfplugin/utils/Codec2BufferUtils.cpp
@@ -629,6 +629,45 @@ static const int16_t bt709Matrix[2][3][3] = {
     { { 47, 157, 16 }, { -26, -86, 112 }, { 112, -102, -10 } }, /* RANGE_LIMITED */
 };
 
+// ConvertRGBToPlanarYUV for 8-bit RGBA or RGBX pixels in that order, as a
+// virtual display hands a screen recording to an encoder: the same results,
+// computed a row at a time on fixed strides so that the compiler vectorizes
+// it. The sums fit in 16 bits for both matrices and ranges: a luma row's
+// weights add up to at most 256, so its sum is at most 65280, and a chroma
+// row's positive and negative weights each add up to at most 128, so its sum
+// and every partial sum stay within +-32640.
+static void ConvertRGBXToPlanarYUV(
+        uint8_t *dstY, uint8_t *dstU, uint8_t *dstV, size_t dstStride,
+        const uint8_t *src, int32_t srcStride, size_t width, size_t height,
+        const int16_t (*weights)[3], uint8_t zeroLvl, uint8_t maxLvlLuma, uint8_t maxLvlChroma) {
+    auto clip = [](unsigned v, uint8_t min, uint8_t max) -> uint8_t {
+        return v < min ? min : (max > v ? v : max);
+    };
+    const uint16_t yr = weights[0][0], yg = weights[0][1], yb = weights[0][2];
+    const int16_t ur = weights[1][0], ug = weights[1][1], ub = weights[1][2];
+    const int16_t vr = weights[2][0], vg = weights[2][1], vb = weights[2][2];
+    for (size_t y = 0; y < height; ++y, src += srcStride, dstY += dstStride) {
+        for (size_t x = 0; x < width; ++x) {
+            const uint16_t r = src[4 * x], g = src[4 * x + 1], b = src[4 * x + 2];
+            const uint16_t luma = (uint16_t)(r * yr) + (uint16_t)(g * yg) + (uint16_t)(b * yb);
+            dstY[x] = clip((luma >> 8) + zeroLvl, zeroLvl, maxLvlLuma);
+        }
+        if (y & 1) {
+            continue;
+        }
+        // Chroma from the top left pixel of each 2x2 block.
+        for (size_t x = 0; x < (width + 1) / 2; ++x) {
+            const int16_t r = src[8 * x], g = src[8 * x + 1], b = src[8 * x + 2];
+            const int16_t u = (int16_t)(r * ur) + (int16_t)(g * ug) + (int16_t)(b * ub);
+            const int16_t v = (int16_t)(r * vr) + (int16_t)(g * vg) + (int16_t)(b * vb);
+            dstU[x] = clip((int16_t)(u >> 8) + 128, zeroLvl, maxLvlChroma);
+            dstV[x] = clip((int16_t)(v >> 8) + 128, zeroLvl, maxLvlChroma);
+        }
+        dstU += dstStride >> 1;
+        dstV += dstStride >> 1;
+    }
+}
+
 status_t ConvertRGBToPlanarYUV(
         uint8_t *dstY, size_t dstStride, size_t dstVStride, size_t bufferSize,
         const C2GraphicView &src, C2Color::matrix_t colorMatrix, C2Color::range_t colorRange) {
@@ -658,6 +697,19 @@ status_t ConvertRGBToPlanarYUV(
     uint8_t maxLvlLuma =  colorRange == C2Color::RANGE_FULL ? 255 : 235;
     uint8_t maxLvlChroma =  colorRange == C2Color::RANGE_FULL ? 255 : 240;
 
+    const C2PlaneInfo &planeR = layout.planes[C2PlanarLayout::PLANE_R];
+    const C2PlaneInfo &planeG = layout.planes[C2PlanarLayout::PLANE_G];
+    const C2PlaneInfo &planeB = layout.planes[C2PlanarLayout::PLANE_B];
+    if (pGreen == pRed + 1 && pBlue == pRed + 2
+            && planeR.colInc == 4 && planeG.colInc == 4 && planeB.colInc == 4
+            && planeR.rowInc == planeG.rowInc && planeR.rowInc == planeB.rowInc
+            && src.crop().width == src.width()) {
+        ConvertRGBXToPlanarYUV(dstY, dstU, dstV, dstStride, pRed, planeR.rowInc,
+                               src.crop().width, src.crop().height, weights,
+                               zeroLvl, maxLvlLuma, maxLvlChroma);
+        return OK;
+    }
+
 #define CLIP3(min,v,max) (((v) < (min)) ? (min) : (((max) > (v)) ? (v) : (max)))
     for (size_t y = 0; y < src.crop().height; ++y) {
         for (size_t x = 0; x < src.crop().width; ++x) {
