From 0cc0b71b1c6a26083dd62848b40ced8f18bf87a4 Mon Sep 17 00:00:00 2001
From: Virtroid build <build@virtroid.invalid>
Date: Tue, 27 Oct 2026 04:15:24 +0000
Subject: [PATCH] monet: let a scheme keep surfaces grey and the seed colour as
 it is

A ColorScheme made with greySurfaces has neutral palettes without chroma, so surfaces and text stay grey whatever the seed, a primary palette at the seed's own chroma, so the accent is the seed colour itself, and a tertiary palette in the seed's hue, so no other hue comes in.

Change-Id: Iceaed1cd0e77bee3034e44c3ee1c69c8cc2c2adc
---
 .../android/systemui/monet/ColorScheme.java   | 31 ++++++++++++++++++-
 1 file changed, 30 insertions(+), 1 deletion(-)

diff --git a/monet/src/com/android/systemui/monet/ColorScheme.java b/monet/src/com/android/systemui/monet/ColorScheme.java
index 551018a..b8c486e 100644
--- a/monet/src/com/android/systemui/monet/ColorScheme.java
+++ b/monet/src/com/android/systemui/monet/ColorScheme.java
@@ -40,6 +40,7 @@ import java.util.ArrayList;
 import java.util.Collections;
 import java.util.List;
 import java.util.Map;
+import java.util.Optional;
 import java.util.stream.Collectors;
 
 /**
@@ -68,6 +69,18 @@ public class ColorScheme {
 
     public ColorScheme(@ColorInt int seed, boolean isDark, @ThemeStyle.Type int style,
             double contrastLevel) {
+        this(seed, isDark, style, contrastLevel, false);
+    }
+
+    /**
+     * @param greySurfaces whether surfaces and text are grey, whatever the seed, and the accent
+     *                     is the seed colour itself rather than the style's version of it: the
+     *                     neutral palettes have no chroma, the primary palette has the seed's
+     *                     own, and the tertiary keeps the seed's hue, so no other hue comes in.
+     *                     Monochromatic stays as it is.
+     */
+    public ColorScheme(@ColorInt int seed, boolean isDark, @ThemeStyle.Type int style,
+            double contrastLevel, boolean greySurfaces) {
 
         this.mSeed = seed;
         this.mIsDark = isDark;
@@ -82,7 +95,7 @@ public class ColorScheme {
                                 ? GOOGLE_BLUE
                                 : seed));
 
-        mMaterialScheme = switch (style) {
+        DynamicScheme scheme = switch (style) {
             case ThemeStyle.SPRITZ -> new SchemeNeutral(seedHct, isDark, contrastLevel);
             case ThemeStyle.TONAL_SPOT -> new SchemeTonalSpot(seedHct, isDark, contrastLevel);
             case ThemeStyle.VIBRANT -> new SchemeVibrant(seedHct, isDark, contrastLevel);
@@ -96,6 +109,9 @@ public class ColorScheme {
             case ThemeStyle.CLOCK_VIBRANT -> new SchemeClockVibrant(seedHct, isDark, contrastLevel);
             default -> throw new IllegalArgumentException("Unknown style: " + style);
         };
+        mMaterialScheme = greySurfaces && style != ThemeStyle.MONOCHROMATIC
+                ? withGreySurfaces(scheme, seedHct)
+                : scheme;
 
         mAccent1 = new TonalPalette(mMaterialScheme.primaryPalette);
         mAccent2 = new TonalPalette(mMaterialScheme.secondaryPalette);
@@ -105,6 +121,19 @@ public class ColorScheme {
         mError = new TonalPalette(mMaterialScheme.errorPalette);
     }
 
+    private static DynamicScheme withGreySurfaces(DynamicScheme scheme, Hct seedHct) {
+        com.google.ux.material.libmonet.palettes.TonalPalette grey =
+                com.google.ux.material.libmonet.palettes.TonalPalette.fromHueAndChroma(
+                        seedHct.getHue(), 0.0);
+        return new DynamicScheme(seedHct, scheme.variant, scheme.isDark, scheme.contrastLevel,
+                scheme.platform, scheme.specVersion,
+                com.google.ux.material.libmonet.palettes.TonalPalette.fromHct(seedHct),
+                scheme.secondaryPalette,
+                com.google.ux.material.libmonet.palettes.TonalPalette.fromHueAndChroma(
+                        seedHct.getHue(), scheme.tertiaryPalette.getChroma()),
+                grey, grey, Optional.of(scheme.errorPalette));
+    }
+
     public ColorScheme(@ColorInt int seed, boolean darkTheme) {
         this(seed, darkTheme, ThemeStyle.TONAL_SPOT);
     }
-- 
