From f13d162b3ee7c801ed9a20a7f0231380a23bb886 Mon Sep 17 00:00:00 2001
From: Virtroid build <build@virtroid.invalid>
Date: Tue, 27 Oct 2026 00:12:40 +0000
Subject: [PATCH 2/3] SettingsProvider: let a device set the default theme

Seeds Settings.Secure.THEME_CUSTOMIZATION_OVERLAY_PACKAGES at first boot from def_theme_customization_overlay_packages, empty (none, as before) unless a device overlays it. Virtroid's runtimes set their lime as a preset color. SystemUI's own default (theming_defaults) applies only while the device isn't set up yet, and in a container Provision marks it set up before SystemUI gets there.

Change-Id: I4efac0f0aab65f1658fd55ac9c8c83e3067cc077
---
 packages/SettingsProvider/res/values/defaults.xml          | 4 ++++
 .../src/com/android/providers/settings/DatabaseHelper.java | 7 +++++++
 2 files changed, 11 insertions(+)

diff --git a/packages/SettingsProvider/res/values/defaults.xml b/packages/SettingsProvider/res/values/defaults.xml
index 38b90b2b6..c0011b847 100644
--- a/packages/SettingsProvider/res/values/defaults.xml
+++ b/packages/SettingsProvider/res/values/defaults.xml
@@ -33,6 +33,10 @@
     <!-- Default for Settings.Global.CAPTIVE_PORTAL_MODE: 0 ignore (no probes),
          1 prompt, 2 avoid. -->
     <integer name="def_captive_portal_mode">1</integer>
+    <!-- Default for Settings.Secure.THEME_CUSTOMIZATION_OVERLAY_PACKAGES, the
+         theme picker's JSON (color source, seed color, style). Empty: none,
+         and SystemUI takes the colors from the wallpaper. -->
+    <string name="def_theme_customization_overlay_packages" translatable="false"></string>
     <bool name="def_accelerometer_rotation">false</bool>
     <!-- Default screen brightness, from 0 to 255.  102 is 40%. -->
     <integer name="def_screen_brightness">102</integer>
diff --git a/packages/SettingsProvider/src/com/android/providers/settings/DatabaseHelper.java b/packages/SettingsProvider/src/com/android/providers/settings/DatabaseHelper.java
index 26bdb570b..91631fd90 100644
--- a/packages/SettingsProvider/src/com/android/providers/settings/DatabaseHelper.java
+++ b/packages/SettingsProvider/src/com/android/providers/settings/DatabaseHelper.java
@@ -2237,6 +2237,13 @@ class DatabaseHelper extends SQLiteOpenHelper {
             loadStringSetting(stmt, Settings.Secure.IMMERSIVE_MODE_CONFIRMATIONS,
                         R.string.def_immersive_mode_confirmations);
 
+            final String themeCustomization = mContext.getResources().getString(
+                    R.string.def_theme_customization_overlay_packages);
+            if (!TextUtils.isEmpty(themeCustomization)) {
+                loadSetting(stmt, Settings.Secure.THEME_CUSTOMIZATION_OVERLAY_PACKAGES,
+                        themeCustomization);
+            }
+
             loadBooleanSetting(stmt, Settings.Secure.INSTALL_NON_MARKET_APPS,
                     R.bool.def_install_non_market_apps);
 
-- 
