From f1fe3fb5589f14f79a50778f3a6bf10f6fca83f7 Mon Sep 17 00:00:00 2001
From: Virtroid build <build@virtroid.invalid>
Date: Mon, 26 Oct 2026 19:20:13 +0000
Subject: [PATCH] SettingsProvider: let a device set the captive portal mode

Seeds Settings.Global.CAPTIVE_PORTAL_MODE at first boot from def_captive_portal_mode, 1 (prompt, Android's default) unless a device overlays it. Virtroid's runtimes set 0: NetworkMonitor then skips its validation probes to Google's connectivitycheck servers and treats the network as working.

Change-Id: I4d1465bff3ccd73facac371e2858fcb40e1c7beb
---
 packages/SettingsProvider/res/values/defaults.xml              | 3 +++
 .../src/com/android/providers/settings/DatabaseHelper.java     | 3 +++
 2 files changed, 6 insertions(+)

diff --git a/packages/SettingsProvider/res/values/defaults.xml b/packages/SettingsProvider/res/values/defaults.xml
index ce8de5e8d..38b90b2b6 100644
--- a/packages/SettingsProvider/res/values/defaults.xml
+++ b/packages/SettingsProvider/res/values/defaults.xml
@@ -30,6 +30,9 @@
     <string name="def_bluetooth_disabled_profiles" translatable="false">0</string>
     <bool name="def_auto_time">true</bool>
     <bool name="def_auto_time_zone">true</bool>
+    <!-- Default for Settings.Global.CAPTIVE_PORTAL_MODE: 0 ignore (no probes),
+         1 prompt, 2 avoid. -->
+    <integer name="def_captive_portal_mode">1</integer>
     <bool name="def_accelerometer_rotation">false</bool>
     <!-- Default screen brightness, from 0 to 255.  102 is 40%. -->
     <integer name="def_screen_brightness">102</integer>
diff --git a/packages/SettingsProvider/src/com/android/providers/settings/DatabaseHelper.java b/packages/SettingsProvider/src/com/android/providers/settings/DatabaseHelper.java
index a3eab5da1..26bdb570b 100644
--- a/packages/SettingsProvider/src/com/android/providers/settings/DatabaseHelper.java
+++ b/packages/SettingsProvider/src/com/android/providers/settings/DatabaseHelper.java
@@ -2307,6 +2307,9 @@ class DatabaseHelper extends SQLiteOpenHelper {
             loadBooleanSetting(stmt, Settings.Global.AUTO_TIME_ZONE,
                     R.bool.def_auto_time_zone); // Sync timezone to NITZ
 
+            loadIntegerSetting(stmt, Settings.Global.CAPTIVE_PORTAL_MODE,
+                    R.integer.def_captive_portal_mode);
+
             if (Flags.useNewStayOnWhilePluggedInDefault()) {
                 loadSetting(
                         stmt,
