# Locally reviewed bootstrap rules. Add a separately reviewed, pinned ruleset
# for broader threat coverage. Only explicit alert records are forwarded to
# client devices; generic parser anomalies remain local diagnostics.

alert tcp any any -> any any (msg:"Virtroid TCP SYN scan pattern"; flags:S; flow:stateless; threshold:type both, track by_src, count 250, seconds 10; classtype:attempted-recon; sid:9900001; rev:1;)
