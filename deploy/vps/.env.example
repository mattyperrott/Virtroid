COMPOSE_PROJECT_NAME=virtroid

# Resolve and independently verify each image, then replace the placeholder
# with its registry sha256 digest. deploy.sh rejects tags without a digest.
POSTGRES_IMAGE=postgres:18@sha256:REPLACE_WITH_64_HEX
GO_BUILD_IMAGE=golang:1.26.5-bookworm@sha256:REPLACE_WITH_64_HEX
BACKEND_RUNTIME_IMAGE=alpine:3.23@sha256:fd791d74b68913cbb027c6546007b3f0d3bc45125f797758156952bc2d6daf40
NODE_RUNTIME_IMAGE=redroid/redroid:14.0.0_64only-latest@sha256:REPLACE_WITH_64_HEX
HAPROXY_IMAGE=haproxy:lts@sha256:REPLACE_WITH_64_HEX
RENTERD_IMAGE=ghcr.io/siafoundation/renterd:2.9.3@sha256:REPLACE_WITH_64_HEX
RENTERD_MYSQL_IMAGE=mysql:8.4@sha256:c592c15aaf4a1961e15d82eb31ea5987dda862d1c4b1e93424438c0e91dc1f8d
FALCO_IMAGE=falcosecurity/falco:0.43.0@sha256:88c01fa17bcc03c990a2691d08e7d43d746e32b07dbe9c6eb77bfdb3646cec41
SURICATA_IMAGE=jasonish/suricata:8.0.6@sha256:51a59543dcb6e5f9d586c06053c6b71d462cea919b45719090443f4af1428780
PROMETHEUS_IMAGE=prom/prometheus:v3.13.0@sha256:c6b27ea434f8389bfe233fbc7be381cf50587c286e871bc842008f5a1b1908a7
ALERTMANAGER_IMAGE=prom/alertmanager:v0.32.1@sha256:51a825c2a40acc3e338fdd00d622e01ec090f72be2b3ea46be0839cd47a4d286

POSTGRES_DB=virtroid
POSTGRES_USER=virtroid
POSTGRES_PASSWORD=REPLACE_WITH_64_HEX
NODE_DEVELOPMENT_ENROLLMENT_ENABLED=false
NODE_PRIVATE_KEY_B64=base64-pkcs8-p256-private-key
CONTROL_PLANE_CALLBACK_PRIVATE_KEY_B64=base64-pkcs8-p256-private-key
CONTROL_PLANE_CALLBACK_PUBLIC_KEY_B64=base64-pkix-p256-public-key
# Keep the signed bootstrap endpoint reachable, but require an operator-created,
# one-time invitation for every new account/device registration.
BOOTSTRAP_ENABLED=true
BOOTSTRAP_REQUIRE_INVITE=true
BOOTSTRAP_AUTO_ISSUE_INVITE=true
BOOTSTRAP_RATE_LIMIT_PER_MINUTE=5
BOOTSTRAP_MAX_BODY_BYTES=32768
RUNTIME_LOG_RETENTION=720h
TRUST_PROXY_HEADERS=true
PUBLIC_BASE_URL=https://your-domain.example
PUBLIC_RELAY_URL=https://your-domain.example
# Metadata-only notification forwarding over Virtroid's authenticated HTTPS
# stream with per-device encrypted delivery.
RUNTIME_NOTIFICATION_RATE_LIMIT_PER_MINUTE=120
NODE_ADVERTISE_ADDR=virtnoded
# This single-node Compose deployment intentionally permits only the node
# service name above as a control-plane callback target.
NODE_ALLOWED_ADVERTISE_ADDRS=virtnoded
HOST_API_BIND=127.0.0.1
HOST_RELAY_BIND=127.0.0.1
NODE_ID=mp-vps-storage
NODE_NAME=mp-vps-storage
HAPROXY_CERT_PATH=/srv/virtroid/tls/virtroid.pem
# Supplementary group used by the non-root HAProxy container to read only the
# combined certificate/key bundle. prepare-redroid-host.sh creates this group.
HAPROXY_CERT_GID=99
DOCKER_GID=998
NODE_DOCKER_NETWORK=virtroid-guests
NODE_RUNTIME_NETWORK_MODE=per-runtime
NODE_AGENT_CONTAINER_NAME=virtnoded
# SHA-256 of /srv/virtroid/apks/virtroid-runtime-agent.apk. The node refuses to
# become ready or install the internal agent if this pin does not match.
NODE_NOTIFICATION_AGENT_APK_SHA256=REPLACE_WITH_64_HEX
NODE_RUNTIME_MEMORY_BYTES=4294967296
NODE_RUNTIME_NANO_CPUS=2000000000
NODE_RUNTIME_PIDS_LIMIT=4096
NODE_RUNTIME_SHM_BYTES=268435456
# The node rejects new provisioning/restoration and snapshot creation when
# available space falls below the stricter of these byte and percentage floors.
NODE_MIN_FREE_DISK_BYTES=10737418240
NODE_MIN_FREE_DISK_PERCENT=5
# Leave empty unless prepare-redroid-host.sh created a reviewed V4L2 loopback
# device and the pinned ReDroid image contains a compatible camera HAL.
NODE_CAMERA_DEVICE=
NODE_CAMERA_WIDTH=640
NODE_CAMERA_HEIGHT=480
NODE_CAMERA_FPS=10

# Host interface inspected by the optional nids profile. Replace this with the
# reviewed ingress interface when the VPS uses a different name.
SURICATA_INTERFACE=eth0

# Catalog sync is fail-closed. Only enable after obtaining the SHA-256 from
# independently verified F-Droid signed metadata; do not hash an untrusted
# index response and treat that as verification.
APP_CATALOG_SYNC_ENABLED=false
APP_CATALOG_SYNC_URL=https://f-droid.org/repo/index-v2.json
APP_CATALOG_SYNC_SHA256=
APP_CATALOG_SYNC_INTERVAL=12h
APP_CATALOG_SYNC_MAX_APPS=1500

# local-disk is the safe default. Switch to sia-renterd only after renterd is
# funded, synced, and has active contracts.
NODE_BLOB_STORE_KIND=local-disk
NODE_SIA_RENTERD_WORKER_URL=
NODE_SIA_RENTERD_BUCKET=virtroid
NODE_SIA_RENTERD_WALLET_ADDRESS=
# Mainnet renterd's upstream default is 10 data shards and 30 total shards.
NODE_SIA_RENTERD_MIN_SHARDS=10
NODE_SIA_RENTERD_TOTAL_SHARDS=30
NODE_SIA_RENTERD_CONTRACT_SET=

# Root-owned operational secrets. The seed must never be placed in this file.
RENTERD_CONFIG_FILE=/etc/virtroid/secrets/renterd.yml
RENTERD_API_PASSWORD_FILE=/etc/virtroid/secrets/renterd-api-password
RENTERD_MYSQL_PASSWORD_FILE=/etc/virtroid/secrets/renterd-mysql-password
RENTERD_MYSQL_ROOT_PASSWORD_FILE=/etc/virtroid/secrets/renterd-mysql-root-password
RENTERD_LOG_LEVEL=info
