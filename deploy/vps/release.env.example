# Non-secret release identity. The image is built, bundled, and loaded only on
# the isolated production VPS from its root-owned offline source checkout.
# Production stores the active file at /var/lib/virtroid-deploy/current.env.
VIRTROID_BACKEND_IMAGE=virtroid-backend:release-REPLACE_WITH_40_HEX_COMMIT_SHA
# Docker's classic and containerd-backed stores expose the config ID and
# manifest digest differently, so the bundle records and verifies both.
VIRTROID_BACKEND_IMAGE_ID=sha256:REPLACE_WITH_64_HEX
VIRTROID_BACKEND_MANIFEST_DIGEST=sha256:REPLACE_WITH_64_HEX
VIRTROID_SOURCE_SHA=REPLACE_WITH_40_HEX_COMMIT_SHA
VIRTROID_SCHEMA_VERSION=REPLACE_WITH_POSITIVE_SCHEMA_VERSION
VIRTROID_DEPLOYMENT_TREE_SHA256=REPLACE_WITH_64_HEX
