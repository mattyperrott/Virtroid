# This file uses literal KEY=VALUE lines. Shell quoting and interpolation are
# intentionally unsupported. Install it as /etc/virtroid/restic.env mode 0600.

# Supported remote repository schemes: rest:https, s3, b2, azure, gs, swift,
# and sftp. Plain HTTP, local, and indirection-based repositories are rejected.
RESTIC_REPOSITORY=s3:s3.example.com/virtroid-production
RESTIC_PASSWORD_FILE=/etc/virtroid/restic-password

# Backend credentials belong in this root-only file. This S3 example can be
# replaced by the corresponding B2, Azure, Google, OpenStack, REST, or SFTP
# variables documented in deploy/vps/README.md.
AWS_ACCESS_KEY_ID=replace-with-backup-only-access-key
AWS_SECRET_ACCESS_KEY=replace-with-backup-only-secret-key
AWS_REGION=replace-with-region

VIRTROID_RESTIC_BACKUP_HOST=virtroid-cp
VIRTROID_RESTIC_TAG=virtroid-offsite
VIRTROID_RESTIC_CHECK_PERCENT=5
VIRTROID_RESTIC_MAX_LOCAL_AGE_HOURS=12

# Keep deletion disabled for append-only/object-locked credentials. If the
# repository credential is intentionally allowed to delete data, enable this
# to run the scoped retention policy after each successful upload.
VIRTROID_RESTIC_PRUNE_ENABLED=false
VIRTROID_RESTIC_KEEP_DAILY=14
VIRTROID_RESTIC_KEEP_WEEKLY=8
VIRTROID_RESTIC_KEEP_MONTHLY=18
VIRTROID_RESTIC_KEEP_YEARLY=3
