# Fixed, non-secret settings of virtnoded inside a runtime VM, baked into the
# image as /etc/virtroid/node.env. Per-VM values (node id and key, region,
# control plane URL, addresses) come from the provisioner at unlock time and
# are set by /sbin/init. Copy to node.env and fill in the values marked below.

NODE_BIND_ADDR=:8090
NODE_ADB_PATH=/usr/bin/adb
NODE_VIEWER_CRYPT_PATH=/usr/local/bin/virtroid-viewercrypt
NODE_HEARTBEAT_INTERVAL=30s
NODE_RECONCILE_INTERVAL=10s

# The control plane's callback public key: the same value as
# CONTROL_PLANE_CALLBACK_PUBLIC_KEY_B64 on the VPS. Public, not a secret.
CONTROL_PLANE_CALLBACK_PUBLIC_KEY_B64=

# The ReDroid image, pinned by digest: the same value as NODE_RUNTIME_IMAGE on the VPS.
NODE_RUNTIME_IMAGE=
NODE_REQUIRE_DIGESTED_RUNTIME_IMAGE=true

# A 2 vCPU, 4 GiB VM runs one runtime.
NODE_RUNTIME_MEMORY_BYTES=3221225472
NODE_RUNTIME_NANO_CPUS=2000000000
NODE_RUNTIME_PIDS_LIMIT=4096
NODE_RUNTIME_SHM_BYTES=268435456
NODE_MIN_FREE_DISK_BYTES=2147483648
NODE_MIN_FREE_DISK_PERCENT=5

# Apps: the same pinned APK directory as /srv/virtroid/apks on the VPS, copied
# into the image read-only by build-rootfs.sh.
NODE_APP_APK_DIR=/usr/share/virtroid/apks
NODE_APP_MANIFEST_PATH=/usr/share/virtroid/apks/manifest.json
NODE_DEFAULT_APP_PACKAGES=org.fdroid.basic
NODE_NOTIFICATION_AGENT_ENABLED=true
NODE_NOTIFICATION_AGENT_APK_PATH=/usr/share/virtroid/apks/virtroid-runtime-agent.apk
# sha256sum of virtroid-runtime-agent.apk
NODE_NOTIFICATION_AGENT_APK_SHA256=

# Snapshots stay on the VM's encrypted data disk until Sia storage lands.
NODE_BLOB_STORE_KIND=local-disk
