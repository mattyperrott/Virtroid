# Virtroid's additions to Aleph's SEV-SNP guest kernel whitelist
# (aleph-vm nix/kernel-config.fragment). build-runtime.sh removes any line
# Aleph already has for these symbols, appends these, and Aleph's kernel
# build then fails if Kconfig drops any of them.
#
# Built in rather than modules: the encrypted rootfs carries no modules for
# this exact kernel.

# Android (ReDroid) talks over binder. Mounting binderfs creates these
# devices; they can only be added later through an ioctl, which the root's
# tools cannot make.
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"

# Android's low-memory killer (lmkd) watches memory pressure through PSI.
CONFIG_PSI=y

# The root is a zstd-compressed EROFS image under dm-verity (EROFS sits in
# the miscellaneous filesystems menu).
CONFIG_MISC_FILESYSTEMS=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EROFS_FS_ZIP_ZSTD=y

# virtnoded's attestation report comes through configfs-tsm.
CONFIG_CONFIGFS_FS=y
CONFIG_TSM_REPORTS=y

# Docker: overlay storage, namespaces, cgroups.
CONFIG_OVERLAY_FS=y
CONFIG_FUSE_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_POSIX_MQUEUE=y
CONFIG_KEYS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_CPUSETS=y
# cpu.max, for each runtime's CPU limit (Docker's NanoCpus).
CONFIG_CFS_BANDWIDTH=y

# Docker networking: veth pairs on a bridge, NAT for IPv4 and IPv6. Docker
# drives nftables through iptables-nft, so the legacy xtables filter and nat
# tables (behind IP_NF_IPTABLES_LEGACY on 6.18) are not needed.
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
# The inet table (vm-init.sh) and its redirect of Tor runtimes' traffic to
# Tor's TransPort and DNSPort.
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_COMPAT=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
# DNAT for published ports (each runtime's ADB port on 127.0.0.1).
CONFIG_NETFILTER_XT_NAT=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP6_NF_IPTABLES=y

# What Android's userspace needs from the kernel inside a ReDroid container,
# taken from AOSP's android-base.config (kernel/configs, android-6.6) minus
# phone hardware (USB, HID, sound, input), SELinux (containers run without
# it), IPsec, and options that exist only in Android's own kernel trees.

# netd builds its firewall and traffic accounting with legacy iptables.
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP6_NF_IPTABLES_LEGACY=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_RAW=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP_NF_MATCH_ECN=y
CONFIG_IP_NF_MATCH_TTL=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_RAW=y
CONFIG_IP6_NF_TARGET_REJECT=y
CONFIG_IP6_NF_MATCH_RPFILTER=y
CONFIG_NETFILTER_XT_MATCH_BPF=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_CONNLIMIT=y
CONFIG_NETFILTER_XT_MATCH_CONNMARK=y
CONFIG_NETFILTER_XT_MATCH_HASHLIMIT=y
CONFIG_NETFILTER_XT_MATCH_HELPER=y
CONFIG_NETFILTER_XT_MATCH_IPRANGE=y
CONFIG_NETFILTER_XT_MATCH_LENGTH=y
CONFIG_NETFILTER_XT_MATCH_LIMIT=y
CONFIG_NETFILTER_XT_MATCH_MAC=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_NETFILTER_XT_MATCH_OWNER=y
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=y
CONFIG_NETFILTER_XT_MATCH_QUOTA=y
CONFIG_NETFILTER_XT_MATCH_SOCKET=y
CONFIG_NETFILTER_XT_MATCH_STATE=y
CONFIG_NETFILTER_XT_MATCH_STATISTIC=y
CONFIG_NETFILTER_XT_MATCH_STRING=y
CONFIG_NETFILTER_XT_MATCH_TIME=y
CONFIG_NETFILTER_XT_MATCH_U32=y
CONFIG_NETFILTER_XT_TARGET_CLASSIFY=y
CONFIG_NETFILTER_XT_TARGET_CONNMARK=y
CONFIG_NETFILTER_XT_TARGET_CT=y
CONFIG_NETFILTER_XT_TARGET_IDLETIMER=y
CONFIG_NETFILTER_XT_TARGET_MARK=y
CONFIG_NETFILTER_XT_TARGET_NFLOG=y
CONFIG_NETFILTER_XT_TARGET_NFQUEUE=y
CONFIG_NETFILTER_XT_TARGET_TCPMSS=y
CONFIG_NETFILTER_XT_TARGET_TPROXY=y
CONFIG_NF_CONNTRACK_EVENTS=y
CONFIG_NF_CT_NETLINK=y
CONFIG_NF_SOCKET_IPV4=y
CONFIG_NF_SOCKET_IPV6=y

# Socket diagnostics: netd's TCP monitor and socket destruction, and ss.
CONFIG_INET_DIAG=y
CONFIG_INET_TCP_DIAG=y
CONFIG_INET_UDP_DIAG=y
CONFIG_INET_DIAG_DESTROY=y

# Per-network policy routing.
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IP_MULTICAST=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_IPV6_ROUTER_PREF=y
CONFIG_IPV6_ROUTE_INFO=y
CONFIG_IPV6_OPTIMISTIC_DAD=y

# BBR congestion control with fair queueing, the default for every socket:
# the viewer's stream crosses long, lossy paths (Bangkok to Europe is about
# 230 ms), where CUBIC backs off hard on each loss and queues fill.
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ=y

# Traffic control, for netd's BPF programs on each interface.
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_NET_SCH_HTB=y
CONFIG_NET_SCH_TBF=y
CONFIG_NET_CLS_ACT=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_CLS_U32=y
CONFIG_NET_CLS_MATCHALL=y
CONFIG_NET_ACT_BPF=y
CONFIG_NET_ACT_POLICE=y
CONFIG_NET_EMATCH=y
CONFIG_NET_EMATCH_U32=y

# VPN apps need TUN. No dummy or ifb drivers: built in, they create dummy0
# and ifb0 at boot, and the initrd brings up the first interface it finds.
CONFIG_TUN=y

# Process accounting (storaged, libprocessgroup) and process_vm_readv.
CONFIG_TASKSTATS=y
CONFIG_TASK_XACCT=y
CONFIG_TASK_IO_ACCOUNTING=y
CONFIG_CROSS_MEMORY_ATTACH=y

# Graphics fences between SurfaceFlinger and the composer.
CONFIG_SYNC_FILE=y

# Android's codecs and graphics allocate buffers from DMA-BUF heaps
# (/dev/dma_heap/system); without them the screen encoder fails as soon as a
# viewer starts streaming. udmabuf as on the VPS kernel the same image runs on.
CONFIG_DMA_SHARED_BUFFER=y
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_UDMABUF=y

# Alarm timers (AlarmManager's CLOCK_*_ALARM) need an RTC.
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_CMOS=y

# Android 15 and later mount their system components (APEXes) from loop
# devices. A runtime container sees only the device nodes that exist when it
# starts, so the kernel creates them at boot: Android 16 asks for 39.
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_LOOP_MIN_COUNT=64
# apexd keeps each loop device open for writing while it mounts it; since
# Linux 6.8 that mount fails (EBUSY) unless writes to mounted devices are
# allowed, as on stock and Android kernels.
CONFIG_BLK_DEV_WRITE_MOUNTED=y

# Android 16 falls back to /dev/ashmem: memfd would need Android's ashmem
# ioctls on memfd, which only Android kernels have. The driver comes from
# kernel-ashmem.patch (Android Common Kernel's C ashmem, ported to 6.18).
CONFIG_STAGING=y
CONFIG_ASHMEM=y
