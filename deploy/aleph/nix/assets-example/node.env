# Fixed, non-secret settings of virtnoded inside a runtime VM, measured into
# the root as /etc/virtroid/node.env. Per-VM values (node id and key, region,
# control plane URL, addresses) come from the provisioner at unlock time and
# are set by /sbin/init. Copy this directory, fill in the values marked below,
# and build with --override-input assets path:<your copy>.

NODE_BIND_ADDR=:8090
NODE_ADB_PATH=/bin/adb
NODE_VIEWER_CRYPT_PATH=/usr/local/bin/virtroid-viewercrypt
NODE_HEARTBEAT_INTERVAL=30s
NODE_RECONCILE_INTERVAL=10s

# The control plane's callback public key: the same value as
# CONTROL_PLANE_CALLBACK_PUBLIC_KEY_B64 on the VPS. Public, not a secret.
CONTROL_PLANE_CALLBACK_PUBLIC_KEY_B64=

# A 2 vCPU, 4 GiB VM runs one runtime.
NODE_RUNTIME_MEMORY_BYTES=3221225472
NODE_RUNTIME_NANO_CPUS=2000000000
NODE_RUNTIME_PIDS_LIMIT=4096
NODE_RUNTIME_SHM_BYTES=268435456
NODE_MIN_FREE_DISK_BYTES=2147483648
NODE_MIN_FREE_DISK_PERCENT=5

# Apps: the assets' apks/ (the VPS's /srv/virtroid/apks without its cache) is
# measured into the root and copied to the data disk at boot, where the node
# also caches catalog apps it verifies against pinned hashes.
NODE_APP_APK_DIR=/srv/virtroid/apks
NODE_APP_MANIFEST_PATH=/srv/virtroid/apks/manifest.json
NODE_DEFAULT_APP_PACKAGES=org.fdroid.basic
NODE_NOTIFICATION_AGENT_ENABLED=true
NODE_NOTIFICATION_AGENT_APK_PATH=/srv/virtroid/apks/virtroid-runtime-agent.apk
# sha256sum of virtroid-runtime-agent.apk
NODE_NOTIFICATION_AGENT_APK_SHA256=

# Where runtime snapshots go: the VM's encrypted data disk, or Sia
# (sia-indexd) once the VPS runs indexd (deploy/vps/indexd.md). With Sia a
# runtime outlives its VM.
NODE_BLOB_STORE_KIND=local-disk
